---
import { Image } from 'astro:assets';
import { experience, education } from '../data/content';
import BriefcaseIcon from '../assets/icons/briefcase.svg';
import GraduationIcon from '../assets/icons/graduation.svg';
import CertificateIcon from '../assets/icons/certificate.svg';
import SparkleIcon from '../assets/icons/sparkle.svg';
import ArrowGhost from '../assets/icons/arrow-up-ghost.svg';

const icons = { graduation: GraduationIcon, certificate: CertificateIcon };
---

<div class="resume" id="experience">
  <section class="column" aria-labelledby="experience-title">
    <h2 id="experience-title" class="column__title">Experience</h2>
    <div class="column__items column__items--roles">
      {experience.map((role) => (
        <article class="item">
          <BriefcaseIcon class="item__icon" aria-hidden="true" />
          <header class="item__header">
            <h3 class="item__title">{role.title}</h3>
            <p class="item__dates item__dates--role">{role.dates}</p>
          </header>
          <ul class="role__list">
            {role.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          {role.summary && <p class="role__summary">{role.summary}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="column" aria-labelledby="education-title">
    <h2 id="education-title" class="column__title">Education</h2>
    <div class="column__items column__items--education">
      {education.map((entry) => {
        const Icon = icons[entry.icon as keyof typeof icons];
        return (
          <article class="item">
            <Icon class="item__icon" aria-hidden="true" />
            <header class="item__header">
              <h3 class="item__title">{entry.name}</h3>
              <p class="item__dates">{entry.dates}</p>
            </header>
            <ul class="study__list">
              <li>{entry.bullet}</li>
            </ul>
            {entry.card && (
              // The card repeats what the entry above already says, so it is decoration for screen readers.
              <div class={`cert cert--${entry.card.theme}`} aria-hidden="true">
                {entry.card.theme === 'blue' ? <ArrowGhost class="cert__ghost" /> : <SparkleIcon class="cert__spark" />}
                <Image class="cert__logo" src={entry.card.logo} alt="" width={entry.card.logoWidth} widths={[entry.card.logoWidth, entry.card.logoWidth * 2, entry.card.logoWidth * 3]} sizes={`${entry.card.logoWidth}px`} />
                <p class="cert__kind">{entry.card.kind}</p>
                <p class="cert__title">{entry.card.title}</p>
                <p class="cert__year">{entry.card.year}</p>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>
</div>

<style>
  /*
   * The left column starts at x=146 in the 1440px design: a 1148px block centered on the page.
   * Education sits in a second 576px column and runs on past that block, as in the design.
   */
  .resume {
    --resume-gap: var(--experience-gap);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, var(--experience-col)));
    column-gap: var(--resume-gap);
    align-items: start;
    padding: var(--space-167) min(var(--gutter), 54px) var(--space-303) max(var(--gutter), calc((100% - 1148px) / 2));
    /* The section starts with a large top padding; anchor so the heading, not the padding, sits under the header. */
    scroll-margin-top: calc(var(--header-h) - var(--space-167));
  }

  .column__title {
    margin-bottom: var(--space-24);
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    color: var(--color-ink);
  }

  .column__items {
    display: flex;
    flex-direction: column;
  }

  .column__items--roles { gap: var(--space-64); }
  .column__items--education { gap: var(--space-32); }

  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    color: var(--color-black);
  }

  .item__icon {
    width: var(--icon-briefcase);
    height: var(--icon-briefcase);
  }

  .item__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .item__title {
    font-size: var(--fs-20);
    font-weight: var(--weight-medium);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
  }

  .item__dates {
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
  }

  /* Dates under a job are smaller and medium weight in the design */
  .item__dates--role {
    font-size: var(--fs-16);
    font-weight: var(--weight-medium);
    line-height: var(--lh-20);
  }

  /* ---------- Experience ---------- */

  .role__list {
    max-width: var(--experience-list);
    padding-left: var(--space-24);
    list-style: disc;
    font-size: var(--fs-16);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
  }

  .role__summary {
    max-width: var(--experience-summary);
    margin-top: var(--space-20); /* with the 16px item gap: the 36px between list and summary in the design */
    font-size: var(--fs-16);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
  }

  /* ---------- Education ---------- */

  .study__list li {
    display: flex;
    gap: var(--space-8);
    max-width: 501px;
    font-size: var(--fs-16);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
  }

  .study__list li::before {
    content: '•';
    flex: none;
    padding-top: var(--space-3);
    font-family: var(--font-meta);
    font-weight: var(--weight-extralight);
    font-size: var(--fs-14);
    line-height: var(--lh-14-14);
  }

  .cert {
    position: relative;
    width: min(var(--cert-w), 100%);
    height: var(--cert-h);
    margin-top: var(--space-8); /* with the 16px item gap: the 24px between the entry and its card */
    padding: var(--space-30) 0 0 min(var(--cert-pad-x), 18%);
    border-radius: var(--cert-radius);
    background: var(--cert-bg);
    font-family: var(--font-card);
    color: var(--color-black);
    overflow: hidden;
  }

  .cert--blue { --cert-bg: var(--cert-blue-bg); }
  .cert--cream { --cert-bg: var(--cert-cream-bg); }

  .cert__logo {
    display: block;
    height: auto;
  }

  .cert--cream .cert__logo { margin-top: var(--space-3); }

  .cert__kind,
  .cert__title,
  .cert__year {
    font-size: var(--fs-24);
    line-height: 36px;
  }

  /* Offsets measured from the design: the kind label starts 120px from the top of both cards. */
  .cert__kind {
    margin-top: var(--space-30);
    font-weight: var(--weight-semibold);
  }

  .cert--cream .cert__kind { margin-top: 42px; }

  .cert__title { margin-top: 27px; }
  .cert--cream .cert__title { margin-top: var(--space-24); }

  .cert__year {
    margin-top: var(--space-3);
    color: rgb(0 0 0 / 0.3);
  }

  .cert__ghost,
  .cert__spark {
    position: absolute;
    pointer-events: none;
  }

  .cert__ghost { top: 81px; right: 80px; }
  .cert__spark { top: 54px; right: 53px; width: 38px; height: 38px; }

  /* ---------- Narrower screens ---------- */

  @media (max-width: 1279px) {
    .resume { --resume-gap: var(--space-44); }
  }

  @media (max-width: 1023px) {
    .resume {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-80);
    }
  }

  @media (max-width: 640px) {
    .cert { --cert-h: 272px; }
    .cert__ghost { right: 40px; }
    .cert__spark { right: 28px; }
  }
</style>

---
import { marquee } from '../data/content';
import GridIcon from '../assets/icons/marquee/grid.svg';
import PenIcon from '../assets/icons/marquee/pen.svg';
import GlobeIcon from '../assets/icons/marquee/globe.svg';
import ArrowIcon from '../assets/icons/marquee/arrow.svg';
import SparkleIcon from '../assets/icons/marquee/sparkle.svg';
import SocialIcon from '../assets/icons/marquee/social.svg';
import SearchIcon from '../assets/icons/marquee/search.svg';

const icons = {
  grid: GridIcon,
  pen: PenIcon,
  globe: GlobeIcon,
  arrow: ArrowIcon,
  sparkle: SparkleIcon,
  social: SocialIcon,
  search: SearchIcon,
};

// The list is repeated so the loop never shows a gap, even on very wide screens.
const copies = [0, 1, 2];
---

<section class="marquee" aria-label="Skills and focus areas">
  <div class="marquee__track">
    {copies.map((copy) => {
      const hidden = copy > 0;
      return (
        <ul class="marquee__list" aria-hidden={hidden ? 'true' : undefined}>
          {marquee.map((item) => {
            const Icon = icons[item.icon];
            return (
              <li class="marquee__item">
                <span class="marquee__dot" aria-hidden="true" />
                <Icon class="marquee__icon" aria-hidden="true" />
                <span class="marquee__label">{item.label}</span>
              </li>
            );
          })}
        </ul>
      );
    })}
  </div>
</section>

<style>
  .marquee {
    margin-top: var(--space-56);
    height: var(--marquee-height);
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  /* Slow, steady, linear: one list width per loop, to the left. */
  .marquee__track {
    display: flex;
    flex: none;
    width: max-content;
    animation: marquee-scroll var(--marquee-speed) linear infinite;
  }

  .marquee__list {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--marquee-gap);
    padding-right: var(--marquee-gap);
  }

  .marquee__item {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    color: var(--color-marquee-text);
    font-size: var(--fs-18);
    line-height: var(--lh-auto);
    white-space: nowrap;
  }

  .marquee__dot {
    width: var(--marquee-dot);
    height: var(--marquee-dot);
    border-radius: 50%;
    background: var(--color-marquee-dot);
  }

  .marquee__icon {
    flex: none;
    width: var(--marquee-icon);
    height: var(--marquee-icon);
    margin-right: calc(var(--space-8) - var(--marquee-gap));
  }

  .marquee__label {
    display: block;
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(calc(-100% / 3));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>

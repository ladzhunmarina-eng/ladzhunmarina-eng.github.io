---
import { marquee } from '../data/content';
import GridIcon from '../assets/icons/marquee/grid.svg';
import PenIcon from '../assets/icons/marquee/pen.svg';
import GlobeIcon from '../assets/icons/marquee/globe.svg';
import ArrowIcon from '../assets/icons/marquee/arrow.svg';
import SparkleIcon from '../assets/icons/marquee/sparkle.svg';
import SearchIcon from '../assets/icons/marquee/search.svg';

const icons = {
  grid: GridIcon,
  pen: PenIcon,
  globe: GlobeIcon,
  arrow: ArrowIcon,
  sparkle: SparkleIcon,
  search: SearchIcon,
};

// The list is repeated so the loop never shows a gap, even on very wide screens.
const copies = [0, 1, 2];
---

<section class="marquee" aria-label="Skills and focus areas">
  <div class="marquee__track">
    {copies.map((copy) => {
      const hidden = copy > 0;
      return (
        <ul class="marquee__list" aria-hidden={hidden ? 'true' : undefined}>
          {marquee.map((item) => {
            const Icon = icons[item.icon];
            return (
              <li class="marquee__item">
                <Icon class="marquee__icon" aria-hidden="true" />
                <span class="marquee__label">{item.label}</span>
              </li>
            );
          })}
        </ul>
      );
    })}
  </div>
</section>

<style>
  .marquee {
    margin-top: var(--space-56);
    height: var(--marquee-height);
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  /* Slow, steady, linear: one list width per loop, to the left. */
  .marquee__track {
    display: flex;
    flex: none;
    width: max-content;
    animation: marquee-scroll var(--marquee-speed) linear infinite;
  }

  /* Hovering the strip holds it still, so a word can be read (and unscrambled) without chasing it. */
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__list {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--marquee-gap);
    padding-right: var(--marquee-gap);
  }

  /* Each word is a pill with its icon. On hover the pill warms up and the word scrambles, then resolves. */
  .marquee__item {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--marquee-chip-pad-y) var(--marquee-chip-pad-x);
    border-radius: var(--radius-pill);
    background: var(--color-marquee-chip);
    color: var(--color-marquee-text);
    font-size: var(--fs-18);
    line-height: var(--lh-auto);
    white-space: nowrap;
    transition: background-color 0.2s ease-out, color 0.2s ease-out;
  }

  .marquee__item:hover {
    background: var(--color-nav-active);
    color: var(--color-black);
  }

  .marquee__icon {
    flex: none;
    width: var(--marquee-icon);
    height: var(--marquee-icon);
  }

  .marquee__label {
    display: block;
    overflow-x: clip; /* scrambled glyphs can be wider than the word: never let them move the pill */
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(calc(-100% / 3));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>

<script>
  // Scramble-and-resolve on hover: the letters shuffle, then settle left to right. The word keeps its width
  // (measured once) so the pill does not jitter while the glyphs change.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const glyphs = 'abcdefghijklmnopqrstuvwxyz';
  const duration = 520;

  document.querySelectorAll<HTMLElement>('.marquee__item').forEach((item) => {
    const label = item.querySelector<HTMLElement>('.marquee__label');
    if (!label) return;
    const text = label.textContent ?? '';
    let running = false;

    const lock = () => {
      if (!label.style.width) label.style.width = `${label.getBoundingClientRect().width}px`;
    };
    document.fonts.ready.then(lock);

    const scramble = () => {
      if (running || reduce.matches) return;
      running = true;
      lock();
      const start = performance.now();
      const frame = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const settled = Math.floor(progress * text.length);
        label.textContent = [...text]
          .map((char, index) => (index < settled || char === ' ' || char === '/' ? char : glyphs[Math.floor(Math.random() * glyphs.length)]))
          .join('');
        if (progress < 1) requestAnimationFrame(frame);
        else {
          label.textContent = text;
          running = false;
        }
      };
      requestAnimationFrame(frame);
    };

    item.addEventListener('pointerenter', scramble);
  });
</script>

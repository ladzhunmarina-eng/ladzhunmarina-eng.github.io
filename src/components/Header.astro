---
import Button from './Button.astro';
import MenuIcon from '../assets/icons/menu.svg';
import CloseIcon from '../assets/icons/close.svg';

interface Props {
  current?: 'work';
}

const { current } = Astro.props;

// Rooted at "/" so the links work from the case study pages too; on the home page they scroll in place.
const links = [
  { label: 'About', href: '/#' },
  { label: 'Cases', href: '/#work', id: 'work' },
  { label: 'Experience', href: '/#experience' },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="/#" aria-label="Portfolio, back to top">Portfolio</a>
    <nav class="nav" aria-label="Primary">
      <a class="nav__brand" href="/#" aria-label="Portfolio, back to top">Portfolio</a>
      <ul class="nav__list">
        {links.map((link) => (
          <li class="nav__item">
            <a class="nav__link" href={link.href} aria-current={link.id && link.id === current ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
      <button class="nav__toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <MenuIcon aria-hidden="true" />
      </button>
    </nav>
    <Button class="site-header__contact" href="#contact" variant="outline-strong">Contact me</Button>
  </div>
</header>

<div id="menu" class="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-state="closed">
  <button class="menu__close" type="button" aria-label="Close menu">
    <CloseIcon aria-hidden="true" />
  </button>
  <ul class="menu__list">
    <li><a class="menu__link" href="/#">Home</a></li>
    <li><a class="menu__link" href="/#">About</a></li>
    <li><a class="menu__link" href="/#work" aria-current={current === 'work' ? 'page' : undefined}>Cases</a></li>
    <li><a class="menu__link" href="/#experience">Experience</a></li>
    <li><a class="menu__link" href="#contact">Contact</a></li>
  </ul>
</div>

<style>
  /*
   * One fixed, translucent, blurred pill at the top with white link chips, like the reference. No plate
   * behind it, so content scrolls under the blur. The Portfolio wordmark sits on the left and Contact me
   * on the right; on phones the wordmark moves into the pill and the links collapse into a menu button.
   */
  .site-header {
    position: fixed;
    top: var(--nav-top);
    inset-inline: 0;
    z-index: var(--z-nav);
    pointer-events: none;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--nav-pad-y) var(--nav-pad-x);
    border-radius: var(--radius-pill);
    background: var(--color-nav-bg);
    -webkit-backdrop-filter: blur(var(--nav-blur));
    backdrop-filter: blur(var(--nav-blur));
    pointer-events: auto;
  }

  .nav__list {
    display: flex;
    gap: var(--space-10);
    align-items: center;
  }

  .site-header__logo,
  .nav__brand {
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-regular);
    color: var(--color-wordmark);
    transition: color 0.15s ease;
    pointer-events: auto;
  }

  .site-header__logo {
    justify-self: start;
    transition:
      opacity var(--header-fade) ease,
      color 0.15s ease;
  }

  .site-header__logo:hover,
  .nav__brand:hover {
    color: var(--color-ink);
  }

  .nav__brand {
    display: none;
  }

  .nav__link {
    display: block;
    padding: var(--nav-link-pad-y) var(--nav-link-pad-x);
    border-radius: var(--radius-pill);
    background: var(--color-nav-chip);
    color: var(--color-black);
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-regular);
    transition: background-color 0.15s ease;
  }

  .nav__link:hover {
    background: color-mix(in srgb, var(--color-nav-chip), var(--color-ink) 7%);
  }

  /* The section in view: its chip turns yellow, and stays yellow on hover. */
  .nav__link[aria-current],
  .nav__link[aria-current]:hover {
    background: var(--color-nav-active);
  }

  .nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--nav-toggle);
    height: var(--nav-toggle);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-page);
    color: var(--color-black);
    cursor: pointer;
  }

  .nav__toggle :global(svg) {
    width: var(--space-20);
    height: var(--space-20);
  }

  .site-header :global(.site-header__contact:hover) {
    background: var(--color-black); /* beats the backing colour below */
  }

  .site-header :global(.site-header__contact) {
    grid-column: 3;
    justify-self: end;
    display: none;
    background: var(--header-backing, var(--color-page)); /* no plate behind the header, so the button carries its own backing */
    pointer-events: auto;
    transition:
      opacity var(--header-fade) ease,
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  /*
   * Once the page is scrolled, only the pill stays. The wordmark and Contact me fade out and stop taking
   * clicks, but they stay in the tab order and fade back in when keyboard focus reaches them.
   */
  .site-header[data-scrolled] .site-header__logo,
  .site-header[data-scrolled] :global(.site-header__contact) {
    opacity: 0;
    pointer-events: none;
  }

  .site-header[data-scrolled] .site-header__logo:focus-visible,
  .site-header[data-scrolled] :global(.site-header__contact:focus-visible) {
    opacity: 1;
    pointer-events: auto;
  }

  /* Wide enough to sit beside the pill. Below this, Contact me lives in the hero instead. */
  @media (min-width: 940px) {
    .site-header :global(.site-header__contact) {
      display: inline-flex;
    }
  }

  /* Phones: the pill spans the width; links collapse into the menu button. */
  @media (max-width: 640px) {
    .site-header__inner {
      display: block;
    }

    .nav {
      width: 100%;
    }

    .nav__item {
      display: none;
    }

    .site-header__logo {
      display: none;
    }

    .nav__brand {
      display: block;
      padding-left: var(--space-4);
    }

    .nav__toggle {
      display: inline-flex;
    }
  }

  /* Full-screen menu overlay (phones). */
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--color-menu-bg);
    -webkit-backdrop-filter: blur(var(--menu-blur));
    backdrop-filter: blur(var(--menu-blur));
    opacity: 0;
    transition: opacity var(--menu-fade) ease;
  }

  .menu[hidden] {
    display: none;
  }

  .menu[data-state='open'] {
    opacity: 1;
  }

  .menu__close {
    position: absolute;
    top: var(--menu-close-inset);
    right: var(--menu-close-inset);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--menu-close);
    height: var(--menu-close);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-black);
    cursor: pointer;
  }

  .menu__close :global(svg) {
    width: var(--space-20);
    height: var(--space-20);
  }

  .menu__list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--menu-gap);
  }

  .menu__link {
    display: block;
    font-family: var(--font-display);
    font-size: var(--menu-fs);
    line-height: var(--menu-lh);
    font-weight: var(--weight-regular);
    color: var(--color-white);
  }

  .menu__link[aria-current] {
    color: var(--color-nav-active);
  }

  .menu__link:focus-visible,
  .menu__close:focus-visible {
    outline-color: var(--color-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .site-header__logo,
    .site-header :global(.site-header__contact) {
      transition: none;
    }
  }

  /* The overlay is for phones only; if the window grows while it is open, it must not stay. */
  @media (min-width: 641px) {
    .menu {
      display: none;
    }
  }
</style>

<script>
  const menu = document.getElementById('menu') as HTMLElement | null;
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const closeButton = menu?.querySelector<HTMLButtonElement>('.menu__close');

  if (menu && toggle && closeButton) {
    const fadeMs = 200;
    let timer: number | undefined;
    const isOpen = () => menu.dataset.state === 'open';

    const open = () => {
      window.clearTimeout(timer);
      menu.hidden = false;
      void menu.offsetWidth; // paint the closed state first so the fade runs
      menu.dataset.state = 'open';
      toggle.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      closeButton.focus({ preventScroll: true });
    };

    const close = (returnFocus = true) => {
      if (!isOpen()) return;
      menu.dataset.state = 'closed';
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      timer = window.setTimeout(() => {
        menu.hidden = true;
      }, fadeMs);
      if (returnFocus) toggle.focus({ preventScroll: true });
    };

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    closeButton.addEventListener('click', () => close());
    menu.addEventListener('click', (event) => {
      // Any link closes the menu; the page then scrolls to it, or opens the contact card.
      if ((event.target as Element).closest('a')) close(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close();
    });
    window.matchMedia('(min-width: 641px)').addEventListener('change', (event) => {
      if (event.matches) close(false);
    });
  }

  // Mark the nav link of the section in view. A band from just under the header to ~45% of the
  // viewport is the "reading line"; the observed section crossing it is the current one.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav__link, .menu__link')).filter(
    (link) => link.hash.length > 1 && document.getElementById(link.hash.slice(1)),
  );
  const sections = new Map<string, HTMLElement>();
  links.forEach((link) => {
    const id = link.hash.slice(1);
    sections.set(id, document.getElementById(id) as HTMLElement);
  });

  const setCurrent = (id: string | null) => {
    document.querySelectorAll<HTMLAnchorElement>('.nav__link, .menu__link').forEach((link) => {
      if (id && link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  if (sections.size && 'IntersectionObserver' in window) {
    const top = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--stack-top')) || 120;
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = (entry.target as HTMLElement).id;
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        });
        // Sections cannot overlap, but if two touch the band, take the one that comes first on the page.
        const current = [...sections.keys()].find((id) => visible.has(id)) ?? null;
        setCurrent(current);
      },
      { rootMargin: `-${top}px 0px -55% 0px` },
    );
    sections.forEach((section) => observer.observe(section));
  }

  // Fade the wordmark and Contact me out once the page is scrolled. A sentinel at the very top of the
  // page tells us when it has left the viewport, so no scroll listener is needed.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header && 'IntersectionObserver' in window) {
    const distance = getComputedStyle(document.documentElement).getPropertyValue('--header-hide-after').trim() || '40px';
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = `position:absolute;top:0;left:0;width:1px;height:${distance};pointer-events:none;visibility:hidden`;
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>

---
import Button from './Button.astro';

const links = [
  { label: 'About', href: '#' },
  { label: 'Cases', href: '#work' },
  { label: 'Experience', href: '#experience' },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="#" aria-label="Marina, back to top">ML</a>
    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {links.map((link) => (
          <li>
            <a class="nav__link" href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <Button class="site-header__contact" href="#contact" variant="outline-strong">Contact me</Button>
  </div>
</header>

<style>
  /*
   * Full-width fixed bar with a solid page-colored plate, so scrolling content never shows through.
   * Three columns: monogram left, nav pill centered, Contact me right.
   */
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: var(--z-nav);
    padding-block: var(--nav-top) var(--space-12);
    background: var(--color-page);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .site-header__logo {
    justify-self: start;
    font-family: var(--font-logo);
    font-size: var(--fs-19);
    line-height: var(--lh-auto);
    color: var(--color-logo);
    transition: color 0.15s ease;
  }

  .site-header__logo:hover {
    color: var(--color-ink);
  }

  .nav {
    grid-column: 2;
    background: var(--color-nav-bg);
    border-radius: var(--radius-pill);
    padding: var(--nav-pad-y) var(--nav-pad-x);
    -webkit-backdrop-filter: blur(var(--nav-blur));
    backdrop-filter: blur(var(--nav-blur));
  }

  .nav__list {
    display: flex;
    gap: var(--space-10);
    align-items: center;
  }

  .nav__link {
    display: block;
    padding: var(--nav-link-pad-y) var(--nav-link-pad-x);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-black);
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-regular);
    transition: background-color 0.15s ease;
  }

  .nav__link:hover {
    background: var(--color-nav-hover);
  }

  .site-header :global(.site-header__contact) {
    grid-column: 3;
    justify-self: end;
    display: none;
  }

  /* Wide enough to sit beside the pill. Below this, Contact me lives in the hero instead. */
  @media (min-width: 860px) {
    .site-header :global(.site-header__contact) {
      display: inline-flex;
    }
  }

  /* No room for the monogram next to the pill on small phones. */
  @media (max-width: 480px) {
    .site-header__logo {
      display: none;
    }
  }
</style>

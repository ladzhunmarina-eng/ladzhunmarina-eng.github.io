---
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';

const links = [
  { label: 'About', href: '#' },
  { label: 'Work', href: '#work' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {links.map((link) => (
          <li>
            <a class="nav__link" href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-header__group">
      <SocialLinks />
      <Button class="site-header__contact" href="#contact" variant="outline" size="sm">Contact me</Button>
    </div>
  </div>
</header>

<style>
  /*
   * Full-width fixed bar with a solid page-colored plate, so scrolling content never shows through
   * behind the pill and the icons. The nav pill stays centered, the group sits on the right.
   */
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: var(--z-nav);
    padding-block: var(--nav-top) var(--space-12);
    background: var(--color-page);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav {
    grid-column: 2;
    background: var(--color-nav-bg);
    border-radius: var(--radius-pill);
    padding: var(--nav-pad-y) var(--nav-pad-x);
    -webkit-backdrop-filter: blur(var(--nav-blur));
    backdrop-filter: blur(var(--nav-blur));
  }

  .nav__list {
    display: flex;
    gap: var(--space-10);
    align-items: center;
  }

  .nav__link {
    display: block;
    padding: var(--nav-link-pad-y) var(--nav-link-pad-x);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-black);
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-regular);
    transition: background-color 0.15s ease;
  }

  .nav__link:hover {
    background: var(--color-nav-hover);
  }

  .site-header__group {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: calc(var(--header-group-gap) + var(--header-button-margin));
  }

  /* Narrower screens: the group would collide with the centered pill. Keep the icons only. */
  @media (max-width: 1199px) {
    .site-header__group :global(.site-header__contact) {
      display: none;
    }
  }

  /* Phones: no room beside the pill. The icons move into the hero (see Hero.astro). */
  @media (max-width: 640px) {
    .site-header__group {
      display: none;
    }
  }
</style>

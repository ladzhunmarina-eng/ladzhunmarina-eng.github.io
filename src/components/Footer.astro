---
import MailIcon from '../assets/icons/mail.svg';
import TelegramIcon from '../assets/icons/telegram.svg';
import WhatsappIcon from '../assets/icons/whatsapp.svg';
import GithubIcon from '../assets/icons/github.svg';
import LinkedinIcon from '../assets/icons/linkedin.svg';
import DribbbleIcon from '../assets/icons/dribbble.svg';
import ArrowUpIcon from '../assets/icons/arrow-up.svg';
import { contact } from '../data/contact';

const reach = [
  { label: 'Email', href: `mailto:${contact.email}`, Icon: MailIcon, external: false },
  { label: 'Telegram', href: contact.telegram, Icon: TelegramIcon, external: true },
  { label: 'WhatsApp', href: contact.whatsapp, Icon: WhatsappIcon, external: true },
];

const social = [
  { label: 'GitHub', href: '#', Icon: GithubIcon },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/marina-ladzhun-876068101/', Icon: LinkedinIcon },
  { label: 'Dribbble', href: 'https://dribbble.com/Maryyyy', Icon: DribbbleIcon },
];
---

<footer class="site-footer">
  <a class="footer__top-link" href="#" aria-label="Back to top">
    <ArrowUpIcon aria-hidden="true" />
  </a>

  <div class="footer__top">
    <h2 class="footer__title" aria-label="Say Hi!">
      <span class="footer__say" aria-hidden="true">Say</span>{' '}<span class="footer__accent" aria-hidden="true">
        {['H', 'i', '!'].map((letter, i) => <span class="footer__letter" style={`--i: ${i}`}>{letter}</span>)}
      </span>
    </h2>

    <ul class="footer__reach">
      {reach.map(({ label, href, Icon, external }) => (
        <li>
          <a
            class="footer__pill"
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            <Icon aria-hidden="true" />
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="footer__bar">
    <p class="footer__copy">Copyright @maryna.ladzhun. All Rights Reserved</p>

    <ul class="footer__social" aria-label="Social profiles">
      {social.map(({ label, href, Icon }) => (
        <li>
          <a
            class="footer__circle"
            href={href}
            aria-label={label}
            rel="me noopener noreferrer"
            target={href.startsWith('http') ? '_blank' : undefined}
          >
            <Icon aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden; /* the letters fall in from above the black, not from over the page */
    display: flex;
    flex-direction: column;
    gap: var(--footer-gap);
    padding: var(--footer-pad-top) var(--gutter) var(--footer-pad-bottom);
    background: var(--color-footer);
    color: var(--color-footer-text);
  }

  /* Back to top: in the corner beside the heading, so it is right there when the page ends. */
  .footer__top-link {
    position: absolute;
    top: var(--footer-pad-top);
    right: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--footer-up-size);
    height: var(--footer-up-size);
    border-radius: 50%;
    background: var(--color-footer-accent);
    color: var(--color-black);
    transition: background-color 0.2s ease-out;
  }

  .footer__top-link :global(svg) {
    width: var(--space-24);
    height: var(--space-24);
    transition: transform 0.2s ease-out;
  }

  .footer__top-link:hover {
    background: var(--color-footer-text);
  }

  .footer__top-link:hover :global(svg) {
    transform: translateY(calc(-1 * var(--space-3)));
  }

  .footer__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--footer-gap);
  }

  .footer__title {
    font-family: var(--font-display);
    font-size: var(--footer-title-size);
    font-weight: var(--weight-light);
    line-height: 1.1;
    letter-spacing: var(--ls-display);
    color: var(--color-footer-text);
  }

  .footer__accent {
    font-weight: var(--weight-extrabold);
    color: var(--color-footer-accent);
  }

  /*
   * "Hi!" drops in letter by letter when the footer scrolls into view: each letter falls from above,
   * lands squashed, bounces twice and settles, and "Say" gets a little knock from the first landing.
   * Hovering or focusing the heading drops them again. The script sets data-drop; without it
   * (or with reduced motion) the words just sit there.
   */
  .footer__letter {
    display: inline-block;
    transform-origin: 50% 100%;
  }

  .footer__say {
    display: inline-block;
  }

  .footer__title[data-drop='ready'] .footer__letter {
    opacity: 0;
    transform: translateY(var(--drop-from));
  }

  .footer__title[data-drop='go'] .footer__letter {
    animation: letter-drop var(--drop-time) both;
    animation-delay: calc(var(--i) * var(--drop-stagger));
  }

  .footer__title[data-drop='go'] .footer__say {
    animation: say-knock 0.5s ease-out both;
    animation-delay: calc(var(--drop-time) * 0.4);
  }

  @keyframes letter-drop {
    0% {
      opacity: 1;
      transform: translateY(var(--drop-from)) rotate(calc((var(--i) - 1) * 14deg));
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5);
    }
    42% {
      opacity: 1;
      transform: translateY(0) rotate(0) scale(1.14, 0.8);
      animation-timing-function: cubic-bezier(0.1, 0.5, 0.4, 1);
    }
    58% {
      transform: translateY(-0.28em) rotate(calc((1 - var(--i)) * 4deg)) scale(0.96, 1.06);
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5);
    }
    72% {
      transform: translateY(0) rotate(0) scale(1.06, 0.92);
      animation-timing-function: cubic-bezier(0.1, 0.5, 0.4, 1);
    }
    84% {
      transform: translateY(-0.08em) scale(0.99, 1.02);
      animation-timing-function: ease-in;
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes say-knock {
    0%,
    100% {
      transform: none;
    }
    30% {
      transform: translateY(0.04em) rotate(-1.2deg);
    }
    65% {
      transform: translateY(-0.015em) rotate(0.5deg);
    }
  }

  .footer__reach {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: min(100%, var(--footer-pill-w));
  }

  .footer__pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-10);
    height: var(--footer-pill-h);
    border-radius: var(--radius-button);
    background: var(--color-footer-surface);
    color: var(--color-footer-pill-text);
    font-family: var(--font-card);
    font-size: var(--fs-18);
    font-weight: var(--weight-medium);
    transition:
      background-color 0.2s ease-out,
      color 0.2s ease-out;
  }

  .footer__pill :global(svg) {
    flex: none;
    width: var(--footer-pill-icon);
    height: var(--footer-pill-icon);
  }

  .footer__pill:hover {
    background: var(--color-footer-text);
    color: var(--color-footer-surface);
  }

  .footer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-24);
  }

  .footer__copy {
    font-size: var(--fs-16);
    line-height: var(--lh-ui);
    color: var(--color-footer-muted);
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-18);
  }

  .footer__social > li {
    display: flex;
  }

  .footer__circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-hit);
    height: var(--icon-hit);
    border-radius: 50%;
    background: var(--color-footer-circle);
    color: var(--color-icon-muted);
    transition: color 0.15s ease;
  }

  .footer__circle:hover {
    color: var(--color-footer-text);
  }

  @media (max-width: 640px) {
    /* No room beside the heading on phones: the button joins the column, centred, at the end. */
    .footer__top-link {
      position: static;
      order: 1;
      align-self: center;
    }

    .footer__bar {
      flex-direction: column-reverse;
      text-align: center;
    }
  }
</style>

<script>
  // "Hi!" drops in when the footer comes into view, and again whenever the heading is hovered or focused.
  const title = document.querySelector<HTMLElement>('.footer__title');
  if (title && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const letters = title.querySelectorAll('.footer__letter');
    const last = letters[letters.length - 1];
    let playing = false;

    const drop = () => {
      if (playing) return;
      playing = true;
      title.dataset.drop = 'ready';
      void title.offsetWidth; // restart the animation from the top
      title.dataset.drop = 'go';
    };

    last?.addEventListener('animationend', () => (playing = false));
    title.dataset.drop = 'ready';

    if ('IntersectionObserver' in window) {
      const seen = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            seen.disconnect();
            drop();
          }
        },
        { threshold: 0.6 },
      );
      seen.observe(title);
    } else {
      title.dataset.drop = 'go';
    }

    title.addEventListener('pointerenter', drop);
    title.addEventListener('click', drop);
  }

  // The link scrolls to the top (smooth, see global.css). Once it gets there, move keyboard focus up too,
  // so the next Tab starts from the top of the page and not from the footer.
  document.querySelector<HTMLAnchorElement>('.footer__top-link')?.addEventListener('click', () => {
    const started = performance.now();
    const settle = () => {
      if (window.scrollY <= 1 || performance.now() - started > 2000) {
        document.querySelector<HTMLElement>('.nav__brand')?.focus({ preventScroll: true });
      } else {
        requestAnimationFrame(settle);
      }
    };
    requestAnimationFrame(settle);
  });
</script>

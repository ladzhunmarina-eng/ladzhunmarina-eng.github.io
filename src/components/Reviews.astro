---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { reviews } from '../data/content';

const { featured, others, linkedin } = reviews;
---

<section class="reviews" id="reviews" aria-labelledby="reviews-title" data-reviews>
  <div class="reviews__inner">
    <h2 id="reviews-title" class="visually-hidden">Wall of Love</h2>

    <figure class="feature">
      <figcaption class="author">
        <Image class="author__photo" src={featured.photo} alt={featured.alt} width={96} height={96} widths={[48, 96, 144]} sizes="48px" />
        <span class="author__line"><span class="author__name">{featured.name}</span><span class="author__dot" aria-hidden="true"></span>{featured.role}</span>
      </figcaption>
      <blockquote class="feature__quote">
        <p>{featured.quote}</p>
      </blockquote>
    </figure>

    <ul class="others">
      {others.map((review) => (
        <li>
          <figure class="note">
            <figcaption class="author">
              <Image class="author__photo" src={review.photo} alt={review.alt} width={96} height={96} widths={[48, 96, 144]} sizes="48px" />
              <span class="author__line"><span class="author__name">{review.name}</span><span class="author__dot" aria-hidden="true"></span>{review.role}</span>
            </figcaption>
            <blockquote class="note__quote">
              {review.quote.map((paragraph) => <p>{paragraph}</p>)}
            </blockquote>
          </figure>
        </li>
      ))}
    </ul>

    <Button class="reviews__more" href={linkedin} variant="outline-strong" external>More on LinkedIn</Button>
  </div>
</section>

<style>
  /* A tinted band across the page, with the text held to the same left edge as Experience above it. */
  .reviews {
    padding: var(--space-134) var(--gutter) var(--space-167) max(var(--gutter), calc((100% - 1148px) / 2));
    background: var(--color-icon-bg);
  }

  .reviews__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-56);
    max-width: var(--reviews-w);
  }


  /* "Name · Role" above each quote */
  .author {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    margin-bottom: var(--space-20);
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  .author__photo {
    flex: none;
    width: var(--reviews-photo);
    height: var(--reviews-photo);
  }

  .author__name {
    color: var(--color-ink);
  }

  /* a small round dot between name and role */
  .author__dot {
    width: 4px;
    height: 4px;
    margin-inline: var(--space-12);
    border-radius: 50%;
    background: var(--color-muted);
    vertical-align: middle;
  }

  /* In the narrower columns the role goes under the name, so the two lines match each other. */
  .note .author__line {
    display: flex;
    flex-direction: column;
  }

  .note .author__dot {
    display: none;
  }

  .feature {
    margin: 0;
  }

  .feature__quote {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-statement);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    color: var(--color-ink);
    letter-spacing: var(--ls-display);
  }

  .others {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-42);
  }

  .note {
    margin: 0;
  }

  .note__quote {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    font-size: var(--fs-18);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }

  @media (max-width: 860px) {
    .others {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* A photo leans a little when pointed at. */
  .author__dot {
    display: inline-block;
  }

  .author__photo {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .author:hover .author__photo {
    transform: rotate(-4deg) scale(1.06);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Before the section is seen the pieces wait just below their places; then they come up one after another:
       the author, the headline word by word (with "priceless" highlighted), the two notes, the button. */
    [data-motion='ready'] :global(.w),
    [data-motion='ready'] .feature .author,
    [data-motion='ready'] .note,
    [data-motion='ready'] .reviews__more {
      opacity: 0;
      transform: translateY(0.45em);
    }

    [data-motion='ready'] .note,
    [data-motion='ready'] .reviews__more {
      transform: translateY(var(--space-20));
    }

    [data-motion='ready'] .author__photo {
      transform: scale(0.6) rotate(-8deg);
    }

    [data-motion='go'] :global(.w),
    [data-motion='go'] .feature .author,
    [data-motion='go'] .note,
    [data-motion='go'] .reviews__more {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.6s ease-out,
        transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    [data-motion='go'] .feature .author {
      transition-delay: 0.05s;
    }

    [data-motion='go'] :global(.w) {
      transition-delay: calc(0.3s + var(--i) * 45ms);
    }

    [data-motion='go'] .note {
      transition-delay: calc(1.1s + var(--n) * 0.18s);
    }

    [data-motion='go'] .reviews__more {
      transition-delay: 1.6s;
    }

    [data-motion='go'] .author__photo {
      transform: none;
      transition-delay: 0.1s;
    }

    /* A marker stroke sweeps under the word */
    :global(.w--mark) {
      background: linear-gradient(color-mix(in srgb, var(--color-nav-active) 30%, transparent), color-mix(in srgb, var(--color-nav-active) 30%, transparent)) 0 88% / 0% 0.32em no-repeat;
    }

    [data-motion='go'] :global(.w--mark) {
      background-size: 100% 0.32em;
      transition:
        opacity 0.6s ease-out,
        transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
        background-size 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1s;
    }
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((section) => {
    if (calm.matches || !('IntersectionObserver' in window)) return;

    // The headline's words become pieces that can come up one by one; the text itself stays as it was.
    const quote = section.querySelector<HTMLElement>('.feature__quote p');
    if (quote) {
      const text = quote.textContent ?? '';
      quote.setAttribute('aria-label', text);
      quote.textContent = '';
      text.split(' ').forEach((word, index, all) => {
        const piece = document.createElement('span');
        piece.className = /^priceless$/i.test(word) ? 'w w--mark' : 'w';
        piece.style.setProperty('--i', String(index));
        piece.style.display = 'inline-block';
        piece.setAttribute('aria-hidden', 'true');
        piece.textContent = word;
        quote.append(piece);
        if (index < all.length - 1) quote.append(' ');
      });
    }

    section.querySelectorAll<HTMLElement>('.note').forEach((note, index) => note.style.setProperty('--n', String(index)));

    section.dataset.motion = 'ready';
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        seen.disconnect();
        section.dataset.motion = 'go';
      },
      { threshold: 0.3 },
    );
    seen.observe(section);
  });
</script>

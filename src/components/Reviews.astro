---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { reviews } from '../data/content';

const { featured, others, linkedin } = reviews;
---

<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="reviews__inner">
    <h2 id="reviews-title" class="visually-hidden">Wall of Love</h2>

    <figure class="feature">
      <figcaption class="author">
        <Image class="author__photo" src={featured.photo} alt={featured.alt} width={96} height={96} widths={[48, 96, 144]} sizes="48px" />
        <span class="author__line"><span class="author__name">{featured.name}</span><span class="author__dot" aria-hidden="true">✳</span>{featured.role}</span>
      </figcaption>
      <blockquote class="feature__quote">
        <span class="mark mark--open" aria-hidden="true">“</span>
        <p>{featured.quote}<span class="mark mark--close" aria-hidden="true">”</span></p>
      </blockquote>
    </figure>

    <ul class="others">
      {others.map((review) => (
        <li>
          <figure class="note">
            <figcaption class="author">
              <Image class="author__photo" src={review.photo} alt={review.alt} width={96} height={96} widths={[48, 96, 144]} sizes="48px" />
              <span class="author__line"><span class="author__name">{review.name}</span><span class="author__dot" aria-hidden="true">✳</span>{review.role}</span>
            </figcaption>
            <blockquote class="note__quote">
              <span class="mark mark--small mark--open" aria-hidden="true">“</span>
              {review.quote.map((paragraph, index) => (
                <p>
                  {paragraph}
                  {index === review.quote.length - 1 && <span class="mark mark--small mark--close" aria-hidden="true">”</span>}
                </p>
              ))}
            </blockquote>
          </figure>
        </li>
      ))}
    </ul>

    <Button class="reviews__more" href={linkedin} variant="outline-strong" external>More on LinkedIn</Button>
  </div>
</section>

<style>
  /* A tinted band across the page, with the text held to the same left edge as Experience above it. */
  .reviews {
    padding: var(--space-134) var(--gutter) var(--space-167) max(var(--gutter), calc((100% - 1148px) / 2));
    background: var(--color-icon-bg);
  }

  .reviews__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-56);
    max-width: var(--reviews-w);
  }


  /* "Name ✳ Role" above each quote */
  .author {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    margin-bottom: var(--space-20);
    font-size: var(--fs-16);
    line-height: var(--lh-20);
    color: var(--color-muted);
  }

  .author__photo {
    flex: none;
    width: var(--reviews-photo);
    height: var(--reviews-photo);
  }

  .author__name {
    color: var(--color-ink);
  }

  .author__dot {
    margin-inline: var(--space-8);
    font-size: var(--fs-14);
    color: var(--color-nav-active);
  }

  /* In the narrower columns the role goes under the name, so the two lines match each other. */
  .note .author__line {
    display: flex;
    flex-direction: column;
  }

  .note .author__dot {
    display: none;
  }

  .feature {
    margin: 0;
  }

  .feature__quote {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-quote);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-title);
    color: var(--color-ink);
  }

  /* Quote marks are the typeface's own round “ ”, set heavy, in the yellow of the active nav chip */
  .mark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.8em;
    line-height: 0;
    color: var(--color-nav-active);
  }

  .mark--open {
    position: absolute;
    top: 0.45em;
    left: -0.5em;
  }

  .mark--close {
    display: inline-block;
    margin-left: 0.08em;
    vertical-align: -0.38em;
  }

  .others {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-42);
  }

  .note {
    margin: 0;
  }

  .note__quote {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    font-size: var(--fs-18);
    line-height: var(--lh-quote);
    color: var(--color-ink);
  }

  .mark--small {
    font-size: 2.3em;
  }

  .mark--small.mark--open {
    top: 0.3em;
    left: -0.5em;
  }

  .mark--small.mark--close {
    vertical-align: -0.3em;
  }

  @media (max-width: 860px) {
    .others {
      grid-template-columns: minmax(0, 1fr);
    }

    .mark--open {
      position: static;
      display: block;
      margin-bottom: 0.3em;
      height: 0.5em;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { testimonials } from '../data/content';
---

<section class="wall" aria-labelledby="wall-title">
  <h2 id="wall-title" class="wall__title">Wall of Love</h2>
  <ul class="wall__list">
    {testimonials.map((t) => (
      <li class={`quote quote--${t.theme}`}>
        <figure class="quote__figure">
          <blockquote class="quote__text">
            <p>{t.quote}</p>
          </blockquote>
          <figcaption class="quote__person">
            <Image class="quote__photo" src={t.photo} alt={t.alt} width={96} height={96} widths={[96, 192, 288]} sizes="96px" />
            <span class="quote__meta">
              <span class="quote__name">{t.name}</span>
              <span class="quote__role">{t.role}</span>
            </span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .wall {
    padding: var(--space-144) var(--wall-gutter) 0;
    max-width: var(--page-max);
    margin-inline: auto;
  }

  .wall__title {
    max-width: var(--text-section-max);
    margin: 0 auto var(--space-42);
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    color: var(--color-ink);
  }

  .wall__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-10);
    max-width: var(--wall-max);
    margin-inline: auto;
  }

  .quote {
    display: flex;
    min-height: var(--quote-card-height);
    padding: var(--space-30);
    border-radius: var(--radius-card);
    background: var(--quote-bg);
  }

  .quote--1 { --quote-bg: var(--quote-1-bg); }
  .quote--2 { --quote-bg: var(--quote-2-bg); }
  .quote--3 { --quote-bg: var(--quote-3-bg); }

  .quote__figure {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-52);
    width: 100%;
  }

  /* The design fixes the quote area at 12 lines; the full text stays in the DOM. */
  .quote__text {
    font-family: var(--font-display);
    font-size: var(--fs-22);
    font-weight: var(--weight-regular);
    line-height: var(--lh-22);
    color: var(--color-black);
  }

  .quote__text p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--quote-lines);
    line-clamp: var(--quote-lines);
    overflow: hidden;
  }

  .quote__person {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .quote__photo {
    flex: none;
    width: var(--photo-size);
    height: var(--photo-size);
  }

  .quote__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    min-width: 0;
    font-size: var(--fs-20);
    line-height: var(--lh-20);
  }

  .quote__name {
    font-weight: var(--weight-semibold);
    color: var(--color-black);
  }

  .quote__role {
    letter-spacing: var(--ls-20);
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .wall__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .quote:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .wall__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .quote {
      min-height: 0;
    }
  }
</style>

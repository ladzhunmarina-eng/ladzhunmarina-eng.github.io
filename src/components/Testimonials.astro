---
import { Image } from 'astro:assets';
import { testimonials } from '../data/content';
---

<section class="wall" aria-labelledby="wall-title">
  <h2 id="wall-title" class="wall__title">Wall of Love</h2>

  <!--
    Desktop: a row of cards, exactly one expanded. Every card holds its quote twice: one copy laid out at the
    collapsed width and one at the expanded width, each with a FIXED width, so the text never re-wraps while the
    card grows or shrinks (the card only clips them). Phones: no accordion, one full card per screen, swipe.
  -->
  <div class="wall__viewport">
    <ul class="wall__list" data-open="0">
      {testimonials.map((t, i) => (
        <li class:list={['quote', `quote--${t.theme}`, { 'is-open': i === 0 }]}>
          <p class="quote__copy quote__copy--collapsed" aria-hidden={i === 0 ? 'true' : 'false'}>
            {t.paragraphs.join(' ')}
          </p>
          <blockquote class="quote__copy quote__copy--expanded" aria-hidden={i === 0 ? 'false' : 'true'}>
            {t.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </blockquote>

          <div class="quote__person">
            <Image class="quote__photo" src={t.photo} alt={t.alt} width={96} height={96} widths={[96, 192, 288]} sizes="96px" />
            <span class="quote__meta">
              <span class="quote__name">{t.name}</span>
              <span class="quote__role">{t.role}</span>
            </span>
          </div>

          <button
            class="quote__toggle"
            type="button"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-disabled={i === 0 ? 'true' : undefined}
            aria-label={`Read the testimonial from ${t.name}`}
          ></button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wall {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-144) var(--wall-pad-right) 0 var(--wall-pad-left);
  }

  .wall__title {
    margin-bottom: var(--space-42);
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    color: var(--color-ink);
  }

  /* The viewport clips the row, so the next card peeks in from the edge, as in the design. */
  .wall__viewport {
    overflow: hidden;
    container-type: inline-size;
  }

  /* ---------- Desktop: horizontal accordion ---------- */

  .wall__list {
    display: flex;
    gap: var(--space-10);
    width: max-content;
    /* The script sets --t so the expanded card is never cut off; the row slides with the same motion. */
    transform: translateX(calc(var(--t, 0) * -1px));
    transition: transform var(--quote-time) var(--quote-ease);
  }

  .quote {
    position: relative;
    flex: none;
    width: var(--quote-closed-w);
    height: var(--quote-h); /* the same for every card, never animated */
    border-radius: var(--radius-card);
    background: var(--quote-bg);
    overflow: hidden; /* clips the two copies while the width changes */
    transition:
      width var(--quote-time) var(--quote-ease),
      background-color 0.2s ease;
  }

  .quote.is-open {
    width: var(--quote-open-w);
  }

  .quote--1 { --quote-bg: var(--quote-1-bg); }
  .quote--2 { --quote-bg: var(--quote-2-bg); }
  .quote--3 { --quote-bg: var(--quote-3-bg); }

  .quote:not(.is-open):hover {
    background: color-mix(in srgb, var(--quote-bg), var(--color-ink) 5%);
  }

  /*
   * Two copies of the quote. Each has a width that does not depend on the card, so its line breaks
   * are the same at every moment of the animation. Only opacity changes.
   */
  .quote__copy {
    position: absolute;
    top: var(--space-30);
    left: var(--space-30);
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
    color: var(--color-black);
    pointer-events: none;
  }

  /* Laid out at the collapsed width; clamped to the lines that fit and ended with an ellipsis. */
  .quote__copy--collapsed {
    width: calc(var(--quote-closed-w) - 2 * var(--space-30));
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--quote-collapsed-lines);
    line-clamp: var(--quote-collapsed-lines);
    overflow: hidden;
    opacity: 1;
    /* Becoming visible again (a card collapsing): wait for the second half of the motion. */
    transition: opacity var(--quote-fade) ease var(--quote-fade-delay);
  }

  /* Laid out at the expanded width; always the full quote. */
  .quote__copy--expanded {
    width: calc(var(--quote-open-w) - 2 * var(--space-30));
    opacity: 0;
    /* Fading out (a card collapsing): quickly, at the start. */
    transition: opacity var(--quote-fade) ease 0ms;
  }

  .quote.is-open .quote__copy--collapsed {
    opacity: 0;
    transition-delay: 0ms; /* fade out at once */
  }

  .quote.is-open .quote__copy--expanded {
    opacity: 1;
    transition-delay: var(--quote-fade-delay); /* fade in during the second half */
  }

  /* A blank line between paragraphs, as in the design. */
  .quote__copy--expanded p {
    white-space: pre-line;
  }

  .quote__copy--expanded p + p {
    margin-top: var(--lh-20);
  }

  /* The author block sits in the bottom left corner in both states. */
  .quote__person {
    position: absolute;
    left: var(--space-30);
    bottom: var(--space-30);
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .quote__photo {
    flex: none;
    width: var(--photo-size);
    height: var(--photo-size);
  }

  .quote__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    white-space: nowrap;
  }

  .quote__name {
    font-weight: var(--weight-semibold);
    color: var(--color-black);
  }

  .quote__role {
    letter-spacing: var(--ls-20);
    color: var(--color-muted);
  }

  /* A real button covers each card. Pointer cursor on collapsed cards only. */
  .quote__toggle {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }

  .quote.is-open .quote__toggle {
    cursor: default;
  }

  .quote__toggle:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: calc(-1 * var(--focus-width));
  }

  @media (prefers-reduced-motion: reduce) {
    .wall__list,
    .quote,
    .quote__copy {
      transition: none !important;
    }
  }

  /* ---------- Mobile: no accordion, one full card per screen, swipe with scroll snap ---------- */

  @media (max-width: 999px) {
    .wall__viewport {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .wall__viewport::-webkit-scrollbar {
      display: none;
    }

    .wall__list {
      transform: none;
      transition: none;
    }

    .quote,
    .quote.is-open {
      display: flex;
      flex-direction: column;
      gap: var(--space-16);
      width: 100cqw; /* one card per screen width */
      height: auto;
      padding: var(--space-30);
      scroll-snap-align: start;
      transition: none;
    }

    .quote:not(.is-open):hover {
      background: var(--quote-bg);
    }

    .quote__copy {
      position: static;
      width: auto;
    }

    .quote__copy--collapsed {
      display: none;
    }

    .quote__copy--expanded {
      opacity: 1;
      transition: none;
    }

    .quote__person {
      position: static;
    }

    .quote__meta {
      white-space: normal;
    }

    .quote__toggle {
      display: none;
    }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('.wall__list');
  const viewport = document.querySelector<HTMLElement>('.wall__viewport');

  if (list && viewport) {
    const cards = Array.from(list.querySelectorAll<HTMLElement>('.quote'));
    const buttons = cards.map((card) => card.querySelector<HTMLButtonElement>('.quote__toggle')!);
    const collapsedCopies = cards.map((card) => card.querySelector<HTMLElement>('.quote__copy--collapsed')!);
    const expandedCopies = cards.map((card) => card.querySelector<HTMLElement>('.quote__copy--expanded')!);
    const accordion = window.matchMedia('(min-width: 1000px)');

    let open = 0;

    const token = (name: string) => parseFloat(getComputedStyle(list).getPropertyValue(name));

    // Slide the row just enough that the expanded card is fully visible with the next card peeking in
    // (and never past the row's ends).
    const slide = () => {
      if (!accordion.matches) {
        list.style.removeProperty('--t');
        return;
      }
      const openW = token('--quote-open-w');
      const closedW = token('--quote-closed-w');
      const gap = token('--space-10');
      const peek = open < cards.length - 1 ? gap + token('--quote-peek') : 0; // the next card keeps peeking in
      const left = open * (closedW + gap);
      const rowW = openW + (cards.length - 1) * closedW + (cards.length - 1) * gap;
      const visibleW = viewport.clientWidth;
      const shift = Math.min(Math.max(left + openW + peek - visibleW, 0), Math.max(rowW - visibleW, 0), left);
      list.style.setProperty('--t', shift.toFixed(2));
    };

    // Only one copy of each quote is exposed to screen readers.
    const syncAria = () => {
      cards.forEach((_, i) => {
        const showExpanded = !accordion.matches || i === open;
        expandedCopies[i].setAttribute('aria-hidden', String(!showExpanded));
        collapsedCopies[i].setAttribute('aria-hidden', String(showExpanded));
      });
    };

    const select = (index: number, moveFocus = false) => {
      if (index < 0 || index >= cards.length) return;
      if (index !== open) {
        open = index;
        cards.forEach((card, i) => {
          card.classList.toggle('is-open', i === open);
          buttons[i].setAttribute('aria-expanded', String(i === open));
          if (i === open) buttons[i].setAttribute('aria-disabled', 'true');
          else buttons[i].removeAttribute('aria-disabled');
        });
        syncAria();
        slide();
      }
      if (moveFocus) buttons[index].focus();
    };

    buttons.forEach((button, i) => {
      button.addEventListener('click', () => select(i)); // the open card ignores its own click
      button.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          select(i + 1, true);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          select(i - 1, true);
        }
      });
    });

    accordion.addEventListener('change', () => {
      syncAria();
      slide();
    });
    window.addEventListener('resize', slide);

    syncAria();
    slide();
  }
</script>

---
import { Image } from 'astro:assets';
import { testimonials } from '../data/content';
---

<section class="wall" aria-labelledby="wall-title">
  <h2 id="wall-title" class="wall__title">Wall of Love</h2>

  <!--
    Desktop: a row of cards, exactly one expanded. Every card holds its quote twice: one copy laid out at the
    collapsed width and one at the expanded width, each with a FIXED width, so the text never re-wraps while the
    card grows or shrinks (the card only clips them). Phones: no accordion, one full card per screen, swipe.
  -->
  <div class="wall__viewport">
    <ul class="wall__list" data-open="0">
      {testimonials.map((t, i) => (
        <li class:list={['quote', `quote--${t.theme}`, { 'is-open': i === 0 }]}>
          <p class="quote__copy quote__copy--collapsed" aria-hidden={i === 0 ? 'true' : 'false'}>
            {t.paragraphs.join(' ')}
          </p>
          <blockquote class="quote__copy quote__copy--expanded" aria-hidden={i === 0 ? 'false' : 'true'}>
            {t.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </blockquote>

          <div class="quote__person">
            <Image class="quote__photo" src={t.photo} alt={t.alt} width={96} height={96} widths={[96, 192, 288]} sizes="96px" />
            <span class="quote__meta">
              <span class="quote__name">{t.name}</span>
              <span class="quote__role">{t.role}</span>
            </span>
          </div>

          <button
            class="quote__toggle"
            type="button"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-disabled={i === 0 ? 'true' : undefined}
            aria-label={`Read the testimonial from ${t.name}`}
          ></button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /*
   * The heading and the first card line up with the page content (max-width, centered), but the carousel
   * runs on to the right edge of the window, so the next card bleeds off the screen. No right padding here:
   * the window edge is what clips it. Percentages are of the page width, so no 100vw and no scrollbar.
   */
  .wall {
    padding: var(--space-144) 0 0 calc(max(0px, (100% - var(--page-max)) / 2) + var(--wall-pad-left));
  }

  .wall__title {
    margin-bottom: var(--space-42);
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    color: var(--color-ink);
  }

  /* The viewport clips the row at the window edge, so the next card bleeds off the screen. */
  .wall__viewport {
    overflow: hidden;
    container-type: inline-size;
  }

  /* ---------- Desktop: horizontal accordion ---------- */

  /* The open card is always first (leftmost); the next card peeks in from the right edge. */
  .wall__list {
    display: flex;
    gap: var(--space-10);
    width: max-content;
  }

  .quote {
    position: relative;
    flex: none;
    width: var(--quote-closed-w);
    height: var(--quote-h); /* the same for every card, never animated */
    border-radius: var(--radius-card);
    background: var(--quote-bg);
    overflow: hidden; /* clips the two copies while the width changes */
    transition:
      width var(--quote-time) var(--quote-ease),
      background-color 0.2s ease;
  }

  .quote.is-open {
    width: var(--quote-open-w);
  }

  .quote--1 { --quote-bg: var(--quote-1-bg); }
  .quote--2 { --quote-bg: var(--quote-2-bg); }
  .quote--3 { --quote-bg: var(--quote-3-bg); }

  .quote:not(.is-open):hover {
    background: color-mix(in srgb, var(--quote-bg), var(--color-ink) 5%);
  }

  /*
   * Two copies of the quote. Each has a width that does not depend on the card, so its line breaks
   * are the same at every moment of the animation. Only opacity changes.
   */
  .quote__copy {
    position: absolute;
    top: var(--space-30);
    left: var(--space-30);
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
    color: var(--color-black);
    pointer-events: none;
  }

  /* Laid out at the collapsed width; clamped to the lines that fit and ended with an ellipsis. */
  .quote__copy--collapsed {
    width: calc(var(--quote-closed-w) - 2 * var(--space-30));
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--quote-collapsed-lines);
    line-clamp: var(--quote-collapsed-lines);
    overflow: hidden;
    opacity: 1;
    /* Becoming visible again (a card collapsing): wait for the second half of the motion. */
    transition: opacity var(--quote-fade) ease var(--quote-fade-delay);
  }

  /* Laid out at the expanded width; always the full quote. */
  .quote__copy--expanded {
    width: calc(var(--quote-open-w) - 2 * var(--space-30));
    opacity: 0;
    /* Fading out (a card collapsing): quickly, at the start. */
    transition: opacity var(--quote-fade) ease 0ms;
  }

  .quote.is-open .quote__copy--collapsed {
    opacity: 0;
    transition-delay: 0ms; /* fade out at once */
  }

  .quote.is-open .quote__copy--expanded {
    opacity: 1;
    transition-delay: var(--quote-fade-delay); /* fade in during the second half */
  }

  /* A blank line between paragraphs, as in the design. */
  .quote__copy--expanded p {
    white-space: pre-line;
  }

  .quote__copy--expanded p + p {
    margin-top: var(--lh-20);
  }

  /* The author block sits in the bottom left corner in both states. */
  .quote__person {
    position: absolute;
    left: var(--space-30);
    bottom: var(--space-30);
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .quote__photo {
    flex: none;
    width: var(--photo-size);
    height: var(--photo-size);
  }

  .quote__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    white-space: nowrap;
  }

  .quote__name {
    font-weight: var(--weight-semibold);
    color: var(--color-black);
  }

  .quote__role {
    letter-spacing: var(--ls-20);
    color: var(--color-muted);
  }

  /* A real button covers each card. Pointer cursor on collapsed cards only. */
  .quote__toggle {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }

  .quote.is-open .quote__toggle {
    cursor: default;
  }

  .quote__toggle:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: calc(-1 * var(--focus-width));
  }

  @media (prefers-reduced-motion: reduce) {
    .quote,
    .quote__copy {
      transition: none !important;
    }
  }

  /* ---------- Mobile: no accordion, one full card per screen, swipe with scroll snap ---------- */

  @media (max-width: 999px) {
    .wall {
      padding-right: var(--wall-pad-right);
      padding-left: var(--wall-pad-left);
    }

    .wall__viewport {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .wall__viewport::-webkit-scrollbar {
      display: none;
    }

    .quote,
    .quote.is-open {
      display: flex;
      flex-direction: column;
      gap: var(--space-16);
      width: 100cqw; /* one card per screen width */
      height: auto;
      padding: var(--space-30);
      scroll-snap-align: start;
      transition: none;
    }

    .quote:not(.is-open):hover {
      background: var(--quote-bg);
    }

    .quote__copy {
      position: static;
      width: auto;
    }

    .quote__copy--collapsed {
      display: none;
    }

    .quote__copy--expanded {
      opacity: 1;
      transition: none;
    }

    .quote__person {
      position: static;
    }

    .quote__meta {
      white-space: normal;
    }

    .quote__toggle {
      display: none;
    }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('.wall__list');

  if (list) {
    const accordion = window.matchMedia('(min-width: 1000px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cardsNow = () => Array.from(list.querySelectorAll<HTMLElement>(':scope > .quote'));
    const buttonOf = (card: HTMLElement) => card.querySelector<HTMLButtonElement>('.quote__toggle')!;
    const durationMs = () => parseFloat(getComputedStyle(list).getPropertyValue('--quote-time')) || 500;
    const easing = () => getComputedStyle(list).getPropertyValue('--quote-ease').trim() || 'cubic-bezier(0.4, 0, 0.2, 1)';

    // Only one copy of each quote is exposed to screen readers: the expanded one on the open card
    // (always the first card), the collapsed one elsewhere. On phones every card shows its full text.
    const syncState = () => {
      cardsNow().forEach((card, i) => {
        const isOpen = i === 0;
        card.classList.toggle('is-open', isOpen);
        const showExpanded = !accordion.matches || isOpen;
        card.querySelector('.quote__copy--expanded')!.setAttribute('aria-hidden', String(!showExpanded));
        card.querySelector('.quote__copy--collapsed')!.setAttribute('aria-hidden', String(showExpanded));
        const button = buttonOf(card);
        button.setAttribute('aria-expanded', String(isOpen));
        if (isOpen) button.setAttribute('aria-disabled', 'true');
        else button.removeAttribute('aria-disabled');
      });
    };

    /*
     * Put the cards in a new order, animating every card from where it is to where it goes.
     * Widths change through the CSS transition (is-open toggles); the position change is a FLIP:
     * measure, reorder, then animate each card's offset back to zero with the same duration and easing.
     * Both are linear in the same eased progress, so each card's left edge moves in one straight motion.
     */
    const reorder = (ordered: HTMLElement[], focusCard?: HTMLElement) => {
      const before = cardsNow();
      if (ordered.every((card, i) => card === before[i])) return;

      const animate = accordion.matches && !reduceMotion.matches;
      const oldFirst = before[0];
      const starts = new Map(before.map((card) => [card, card.getBoundingClientRect().left]));
      before.forEach((card) => card.getAnimations().forEach((animation) => animation.cancel()));

      list.append(...ordered); // the DOM order is the reading and tab order, so it follows the visual order

      // Where each card sits right now, with its OLD width, in the new order. Measuring forces a style
      // recalculation, so the width transition that starts next begins from the old width (a moved element
      // would otherwise skip the transition).
      const offsets = new Map(ordered.map((card) => [card, (starts.get(card) ?? 0) - card.getBoundingClientRect().left]));

      syncState(); // is-open moves to the new first card, so the widths start to transition

      if (animate) {
        const duration = durationMs();
        const ease = easing();
        const opening = ordered[0];
        ordered.forEach((card) => {
          const dx = offsets.get(card) ?? 0;
          if (Math.abs(dx) < 0.5) return;
          // The card going to the end slides under the others; the opening card stays on top.
          card.style.zIndex = card === opening ? '3' : card === oldFirst ? '1' : '2';
          card
            .animate([{ transform: `translateX(${dx}px)` }, { transform: 'translateX(0)' }], { duration, easing: ease })
            .finished.then(() => card.style.removeProperty('z-index'))
            .catch(() => card.style.removeProperty('z-index'));
        });
      }

      focusCard?.querySelector<HTMLButtonElement>('.quote__toggle')?.focus({ preventScroll: true });
    };

    // Click: the card takes the open place; the card that was open goes to the end; the rest keep their order.
    const bringToFront = (card: HTMLElement, moveFocus = false) => {
      const cards = cardsNow();
      if (card === cards[0]) return; // the open card ignores its own click
      const first = cards[0];
      reorder([card, ...cards.filter((c) => c !== card && c !== first), first], moveFocus ? card : undefined);
    };

    // Arrow keys: next card (same as clicking the second one), previous card (the last one comes back to the front).
    const next = () => {
      const cards = cardsNow();
      bringToFront(cards[1], true);
    };
    const previous = () => {
      const cards = cardsNow();
      reorder([cards[cards.length - 1], ...cards.slice(0, -1)], cards[cards.length - 1]);
    };

    cardsNow().forEach((card) => {
      const button = buttonOf(card);
      button.addEventListener('click', () => bringToFront(card));
      button.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          next();
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          previous();
        }
      });
    });

    accordion.addEventListener('change', syncState);
    syncState();
  }
</script>

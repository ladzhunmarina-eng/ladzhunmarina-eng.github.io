---
import { Image } from 'astro:assets';
import { testimonials } from '../data/content';
---

<section class="wall" aria-labelledby="wall-title">
  <h2 id="wall-title" class="wall__title">Wall of Love</h2>

  <!--
    Three cards in one row. The open card is wider and shows the whole quote; the other two are narrower
    and show the start of theirs. Clicking a card opens it. No scrolling.
  -->
  <ul class="wall__grid" data-open="0">
    {testimonials.map((t, i) => (
      <li class:list={['quote', `quote--${t.theme}`, { 'is-open': i === 0 }]}>
        <figure class="quote__figure">
          <blockquote class="quote__text">
            {t.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </blockquote>
          <figcaption class="quote__person">
            <Image class="quote__photo" src={t.photo} alt={t.alt} width={96} height={96} widths={[96, 192, 288]} sizes="96px" />
            <span class="quote__meta">
              <span class="quote__name">{t.name}</span>
              <span class="quote__role">{t.role}</span>
            </span>
          </figcaption>
        </figure>
        <button
          class="quote__toggle"
          type="button"
          aria-expanded={i === 0 ? 'true' : 'false'}
          aria-label={`Read the full testimonial from ${t.name}`}
        ></button>
      </li>
    ))}
  </ul>
</section>

<style>
  .wall {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-144) var(--wall-pad-right) 0 var(--wall-pad-left);
  }

  .wall__title {
    margin-bottom: var(--space-42);
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    color: var(--color-ink);
  }

  /* ---------- Desktop: a row of three, the open card twice as wide ---------- */

  .wall__grid {
    display: grid;
    grid-template-columns: var(--quote-open-fr) var(--quote-compact-fr) var(--quote-compact-fr);
    gap: var(--space-10);
    height: var(--wall-h);
    transition: grid-template-columns var(--quote-time) var(--quote-ease);
  }

  .wall__grid[data-open='1'] {
    grid-template-columns: var(--quote-compact-fr) var(--quote-open-fr) var(--quote-compact-fr);
  }

  .wall__grid[data-open='2'] {
    grid-template-columns: var(--quote-compact-fr) var(--quote-compact-fr) var(--quote-open-fr);
  }

  /* The script measures the tallest state with this on, so the row never changes height on a click. */
  .wall__grid.is-measuring {
    height: auto;
    transition: none;
  }

  .wall__grid.is-measuring .quote__text {
    transition: none;
  }

  .quote {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 0;
    padding: var(--space-30);
    border-radius: var(--radius-card);
    background: var(--quote-bg);
    overflow: hidden;
    transition: background-color 0.2s ease;
  }

  .quote--1 { --quote-bg: var(--quote-1-bg); }
  .quote--2 { --quote-bg: var(--quote-2-bg); }
  .quote--3 { --quote-bg: var(--quote-3-bg); }

  .quote:not(.is-open):hover {
    background: color-mix(in srgb, var(--quote-bg), var(--color-ink) 5%);
  }

  .quote__figure {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-16);
    width: 100%;
    min-width: 0;
    min-height: 0;
  }

  .quote__text {
    flex: 1 1 auto;
    min-height: 0;
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
    color: var(--color-black);
    transition:
      font-size var(--quote-time) var(--quote-ease),
      line-height var(--quote-time) var(--quote-ease);
  }

  /* Closed cards: a smaller teaser that fills the card and fades out where the quote goes on. */
  .quote:not(.is-open) .quote__text {
    flex: 1 1 0; /* zero basis: a closed card never makes the row taller, it just fills the space */
    overflow: hidden;
    font-size: var(--quote-compact-fs);
    line-height: var(--quote-compact-lh);
  }

  .quote__text[data-overflow] {
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 2 * var(--quote-compact-lh)), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 2 * var(--quote-compact-lh)), transparent);
  }

  /* The open card always shows its whole quote, never a fade. */
  .quote.is-open .quote__text[data-overflow] {
    -webkit-mask-image: none;
    mask-image: none;
  }

  /* A blank line between paragraphs, as in the design; "\n" inside one is a plain line break. */
  .quote__text p {
    white-space: pre-line;
  }

  .quote__text p + p {
    margin-top: 1lh;
  }

  .quote__person {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .quote__photo {
    flex: none;
    width: var(--photo-size);
    height: var(--photo-size);
  }

  .quote__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    min-width: 0;
    font-size: var(--fs-20);
    line-height: var(--lh-20);
  }

  .quote__name {
    font-weight: var(--weight-semibold);
    color: var(--color-black);
  }

  .quote__role {
    letter-spacing: var(--ls-20);
    color: var(--color-muted);
  }

  /* One invisible button covers each card, so the whole card is the click target. */
  .quote__toggle {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }

  .quote.is-open .quote__toggle {
    cursor: default;
  }

  .quote__toggle:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: calc(-1 * var(--focus-width));
  }

  /* ---------- Narrower than a laptop: the cards stack and open in place ---------- */

  @media (max-width: 1279px) {
    .wall__grid,
    .wall__grid[data-open='0'],
    .wall__grid[data-open='1'],
    .wall__grid[data-open='2'] {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
      transition: none;
    }

    .quote:not(.is-open) .quote__text {
      flex: none;
      font-size: var(--fs-20);
      line-height: var(--lh-20);
      max-height: calc(var(--quote-compact-lines-narrow) * var(--lh-20));
    }

    .quote__text[data-overflow] {
      -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--lh-20)), transparent);
      mask-image: linear-gradient(to bottom, #000 calc(100% - var(--lh-20)), transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall__grid,
    .quote__text {
      transition: none;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('.wall__grid');

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.quote'));
    const texts = cards.map((card) => card.querySelector<HTMLElement>('.quote__text')!);

    const setOpen = (index: number) => {
      grid.dataset.open = String(index);
      cards.forEach((card, i) => {
        card.classList.toggle('is-open', i === index);
        card.querySelector('.quote__toggle')?.setAttribute('aria-expanded', String(i === index));
      });
    };

    // A closed card fades out only if its quote really continues.
    const markOverflow = () => {
      texts.forEach((text) => text.toggleAttribute('data-overflow', text.scrollHeight > text.clientHeight + 1));
    };

    // The row keeps one height in every state: the tallest one (the card that needs most room when open).
    const measure = () => {
      const current = Number(grid.dataset.open ?? 0);
      grid.style.removeProperty('--wall-h');
      grid.classList.add('is-measuring');
      let tallest = 0;
      cards.forEach((_, i) => {
        setOpen(i);
        tallest = Math.max(tallest, grid.getBoundingClientRect().height);
      });
      setOpen(current);
      grid.classList.remove('is-measuring');
      grid.style.setProperty('--wall-h', `${Math.ceil(tallest)}px`);
      markOverflow();
    };

    cards.forEach((card, index) => {
      card.querySelector('.quote__toggle')?.addEventListener('click', () => {
        if (grid.dataset.open === String(index)) return;
        setOpen(index);
        requestAnimationFrame(markOverflow); // stacked layout has no transition to wait for
      });
    });

    // Re-check the fades once the widths have settled.
    grid.addEventListener('transitionend', (event) => {
      if (event.target === grid) markOverflow();
    });

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(measure, 150);
    });

    measure();
    document.fonts?.ready.then(measure);
  }
</script>

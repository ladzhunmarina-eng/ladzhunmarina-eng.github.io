---
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  imageAlt?: string;
  label?: string;
  text: string;
  source: string;
}

const { image, imageAlt = '', label, text, source } = Astro.props;
---

<figure class="quote">
  {image && <Image class="quote__image" src={image} alt={imageAlt} widths={[720, 1440]} sizes="(min-width: 1024px) 720px, 100vw" />}
  {label && <p class="quote__label">{label}</p>}
  <blockquote class="quote__text">{text}</blockquote>
  <figcaption class="quote__source">{source}</figcaption>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    padding: var(--space-32);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  /* the photo sits inside the card, above the quote */
  .quote__image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-12);
    border-radius: var(--radius-person);
    object-fit: cover;
  }

  .quote__label {
    font-size: var(--fs-12);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .quote__text {
    max-width: var(--case-measure);
    font-family: var(--font-display);
    font-size: var(--fs-case-h3);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
    color: var(--color-ink);
  }

  .quote__source {
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }
</style>

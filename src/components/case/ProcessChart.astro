---
interface Bar {
  label: string;
  /** Where the bar starts and ends, as a percentage of the chart width */
  from: number;
  to: number;
  /** Short notes under the bar, each with an accent marker */
  notes?: readonly string[];
}

interface Props {
  phases: readonly string[];
  bars: readonly Bar[];
  label: string;
}

const { phases, bars, label } = Astro.props;

// The phases a bar touches, for the label above it on a phone and for screen readers
const span = (bar: Bar) => {
  const width = 100 / phases.length;
  const first = phases[Math.min(phases.length - 1, Math.floor(bar.from / width))];
  const last = phases[Math.max(0, Math.ceil(bar.to / width) - 1)];
  return first === last ? first : `${first} to ${last}`;
};
---

<div class="chart">
  <ol class="chart__rows" aria-label={label}>
    {bars.map((bar) => (
      <li class="row" style={`--from: ${bar.from}%; --to: ${bar.to}%`}>
        <p class="row__range">{span(bar)}</p>
        <p class="row__bar">{bar.label}</p>
        {bar.notes && (
          <ul class="row__notes">
            {bar.notes.map((note) => <li>{note}</li>)}
          </ul>
        )}
      </li>
    ))}
  </ol>
  <ul class="chart__axis" aria-hidden="true" style={`--n: ${phases.length}`}>
    {phases.map((phase) => <li>{phase}</li>)}
  </ul>
</div>

<style>
  .chart {
    padding: var(--case-card-pad);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  /* four equal columns, drawn as thin vertical lines behind the bars */
  .chart__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding-block: var(--space-8);
    border-right: 1px solid var(--case-line);
    background: linear-gradient(to right, var(--case-line) 1px, transparent 1px) 0 0 / 25% 100%;
  }

  .row {
    margin-left: var(--from);
    width: calc(var(--to) - var(--from));
  }

  /* said to screen readers on a wide chart; a visible label on a phone */
  .row__range {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .row__bar {
    display: flex;
    align-items: center;
    min-height: var(--space-42);
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--erma-pill);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-ink);
  }

  .row__notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: max-content;
    max-width: min(320px, 100%);
    margin-top: var(--space-12);
    padding-inline: var(--space-8);
  }

  .row__notes li {
    position: relative;
    padding-left: var(--space-16);
    font-size: var(--fs-12);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }

  .row__notes li::before {
    content: '';
    position: absolute;
    top: 0.4em;
    left: 0;
    width: var(--space-8);
    height: var(--space-8);
    border-radius: 50%;
    background: var(--erma-orange);
  }

  .chart__axis {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin-top: var(--space-12);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    text-align: center;
    color: var(--color-muted);
  }

  /* a phone: a plain list, every step full width, the phases as a small label above it */
  @media (max-width: 639px) {
    .chart__rows {
      gap: var(--space-24);
      padding-block: 0;
      border-right: 0;
      background: none;
    }

    .row {
      margin-left: 0;
      width: 100%;
    }

    .row__range {
      position: static;
      width: auto;
      height: auto;
      margin-bottom: var(--space-8);
      clip-path: none;
      font-size: var(--fs-12);
      line-height: var(--lh-snug);
      color: var(--color-muted);
    }

    .chart__axis {
      display: none;
    }
  }
</style>

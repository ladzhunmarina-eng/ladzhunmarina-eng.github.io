---
interface Props {
  question: string;
  groups: readonly { name: string; n: number; rows: readonly (readonly [string, number])[]; note: string }[];
  insight: string;
}

const { question, groups, insight } = Astro.props;
---

<div class="survey" data-survey>
  <p class="survey__question">“{question}”</p>

  <div class="survey__groups">
    {groups.map((group) => (
      <section class="group" aria-label={`${group.name}, n = ${group.n}`}>
        <header class="group__head">
          <h4 class="group__name">{group.name}</h4>
          <p class="group__n">n = {group.n}</p>
        </header>
        <ul class="group__rows">
          {group.rows.map(([label, pct], index) => (
            <li class="bar" style={`--pct: ${pct}%; --i: ${index}`}>
              <span class="bar__label">{label}</span>
              <span class="bar__track" aria-hidden="true"><span class="bar__fill"></span></span>
              <span class="bar__value"><span data-count={pct}>{pct}</span>%</span>
            </li>
          ))}
        </ul>
        <p class="group__note">{group.note}</p>
      </section>
    ))}
  </div>

  <p class="survey__insight">{insight}</p>
</div>

<style>
  .survey {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .survey__question {
    max-width: var(--case-measure);
    font-size: var(--fs-16);
    font-style: italic;
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  .survey__groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--case-card-min-wide), 1fr));
    gap: var(--space-16);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--case-card-pad);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  /* The name sits 52px from the card's top edge, as designed: 27px of room above it, 25px below. */
  .group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-12);
    padding-block: 27px 25px;
  }

  .group__name {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    color: var(--color-ink);
    letter-spacing: var(--ls-heading);
  }

  .group__n {
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }

  .group__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'label value'
      'track track';
    gap: var(--space-4) var(--space-12);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-black);
  }

  .bar__label {
    grid-area: label;
  }

  .bar__value {
    grid-area: value;
    font-weight: var(--weight-medium);
  }

  .bar__track {
    grid-area: track;
    height: var(--case-bar-h);
    border-radius: var(--radius-pill);
    background: var(--case-track);
    overflow: hidden;
  }

  .bar__fill {
    display: block;
    width: var(--pct);
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--case-bar);
  }

  /* Once in view, the bars fill from the left in turn and the numbers count up. Without script or with reduced motion they are simply there. */
  [data-motion='ready'] .bar__fill {
    clip-path: inset(0 100% 0 0 round var(--radius-pill));
  }

  [data-motion='go'] .bar__fill {
    clip-path: inset(0 0 0 0 round var(--radius-pill));
    transition: clip-path 0.9s cubic-bezier(0.25, 1, 0.5, 1) calc(var(--i) * 0.1s);
  }

  .bar__value {
    font-variant-numeric: tabular-nums;
  }

  .group__note {
    padding-top: var(--space-12);
    border-top: 1px solid var(--case-line);
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    color: var(--case-accent);
  }

  .survey__insight {
    max-width: var(--case-measure);
    padding: var(--space-16) var(--space-20);
    border-left: 4px solid var(--case-bg);
    font-size: var(--fs-18);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  const countUp = (el: HTMLElement, delay: number) => {
    const target = Number(el.dataset.count);
    const start = performance.now() + delay;
    const step = (now: number) => {
      const t = Math.min(1, Math.max(0, (now - start) / 900));
      el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 4))));
      if (t < 1) requestAnimationFrame(step);
    };
    el.textContent = '0';
    requestAnimationFrame(step);
  };

  document.querySelectorAll<HTMLElement>('[data-survey]').forEach((survey) => {
    if (calm.matches || !('IntersectionObserver' in window)) return;
    survey.dataset.motion = 'ready';
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        seen.disconnect();
        survey.dataset.motion = 'go';
        survey.querySelectorAll<HTMLElement>('.bar').forEach((bar) => {
          const el = bar.querySelector<HTMLElement>('[data-count]');
          if (el) countUp(el, Number(getComputedStyle(bar).getPropertyValue('--i')) * 100);
        });
      },
      { threshold: 0.4 },
    );
    seen.observe(survey);
  });
</script>

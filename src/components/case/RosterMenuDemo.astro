---
import { Image } from 'astro:assets';
import LogoShield from './LogoShield.astro';
import base from '../../assets/images/erma-rosters-base.png';
import menu from '../../assets/images/erma-rosters-menu.png';
import detail from '../../assets/images/erma-roster-page.png';
import newRow from '../../assets/images/erma-roster-newrow.png';
import dragRow from '../../assets/images/erma-roster-dragrow.png';
import HandGrab from '../../assets/icons/hand-grab.svg';

interface Props {
  alt: string;
  menuAlt: string;
  detailAlt: string;
}

const { alt, menuAlt, detailAlt } = Astro.props;

// The twelve roster cards, as shares of the screen (cards are 264 x 138 at x 277, 568, 859, 1150 and y 353, 518, 683 of 1440 x 1025)
const names = ['London — James', 'Bristol — Emily', 'Manchester — Oliver', 'Leeds — Sophie', 'Cambridge — Amelia', 'Oxford — Daniel', 'Brighton — Charlotte', 'Liverpool — Thomas', 'Bath — Grace', 'York — William', 'Cardiff — Lucy', 'Edinburgh — Henry'];
const cards = names.map((name, i) => ({
  name,
  left: ((277 + (i % 4) * 291) / 1440) * 100,
  top: ((353 + Math.floor(i / 4) * 165) / 1025) * 100,
  width: (264 / 1440) * 100,
  height: (138 / 1025) * 100,
}));
const status = { left: 20.07, top: 44.39, width: 5, height: 2.34 }; // the status chip of the first card, 72 x 24 over the 45 x 24 "draft"
// Inside a roster (the same 1440 x 1025 screen): the person who gets dragged, the slot he leaves and the slot he lands in
const W = 1440;
const H = 1025;
const pct = (v: number, of: number) => (v / of) * 100;
const grab = { left: pct(276, W), top: pct(763, H), width: pct(550, W), height: pct(57, H) }; // his row in "Available Support"
const sprite = { left: pct(264, W), top: pct(753, H), width: pct(579, W) }; // the lifted row with its shadow, at rest
const dropLine = { left: pct(862, W), top: pct(646, H), width: pct(550, W) };
const rowIn = { left: pct(861, W), top: pct(647, H), width: pct(552, W), height: pct(57, H) }; // the new row in the roster
// What closes up or opens down once he has moved: the picture itself, shifted by one row (57px)
const shiftL = { left: pct(276, W), top: pct(763, H), width: pct(550, W), height: pct(108, H) };
const coverL = { left: pct(276, W), top: pct(871, H), width: pct(550, W), height: pct(57, H) };
const shiftR = { left: pct(861, W), top: pct(704, H), width: pct(552, W), height: pct(224, H) };
const inner = (b: { left: number; top: number; width: number; height: number }, x: number, y: number) =>
  `width:${(W / (b.width * W / 100)) * 100}%;left:${-(x / (b.width * W / 100)) * 100}%;top:${-(y / (b.height * H / 100)) * 100}%;`;
const back = { left: 19.5, top: 2.2, width: 6.5, height: 4.4 }; // "Back" in the roster page

// Everything is a share of the 1440 x 1025 screen (the picture's own size in the design)
const spot = { left: 34.65, top: 35.02, width: 2.5, height: 3.51 }; // the dots on the first roster card
const popup = { left: 20.97, top: 32.78, width: 17.43 }; // the menu with its shadow
const logo = { left: 3.75, top: 2.54, width: 10.07, height: 4.78 };
const company = { left: 0.5, top: 85, width: 13.5, height: 4 };
const box = (b: { left: number; top: number; width: number; height?: number }) =>
  `left:${b.left}%;top:${b.top}%;width:${b.width}%;${b.height ? `height:${b.height}%;` : ''}`;
---

<figure class="demo" data-roster-menu>
  <div class="demo__screen">
    <Image src={base} alt={alt} widths={[640, 960, 1280]} sizes="(max-width: 1023px) 100vw, 640px" quality={85} />
    <LogoShield {...logo} />
    <LogoShield {...company} />

    {cards.map((card) => (
      <button class="demo__card" type="button" style={box(card)} data-card aria-label={`Open the roster ${card.name}`}></button>
    ))}

    <span class="demo__status" style={box(status)} aria-hidden="true">activated</span>

    <div class="demo__page" aria-hidden="true" inert>
      <Image src={detail} alt={detailAlt} widths={[640, 960, 1280]} sizes="(max-width: 1023px) 100vw, 640px" quality={85} />
      <LogoShield {...logo} />
      <LogoShield {...company} />

      <!-- the roster's lists change as the person is moved: the gap he leaves, the line he is dropped on, the new row, and the rest shifting by one row -->
      <div class="demo__shift demo__shift--l" style={box(shiftL)}>
        <Image class="demo__shift-img" src={detail} alt="" widths={[640, 960, 1280]} sizes="(max-width: 1023px) 100vw, 640px" quality={85} style={inner(shiftL, 276, 763)} />
      </div>
      <div class="demo__cover" style={box(coverL)}></div>
      <div class="demo__shift demo__shift--r" style={box(shiftR)}>
        <Image class="demo__shift-img" src={detail} alt="" widths={[640, 960, 1280]} sizes="(max-width: 1023px) 100vw, 640px" quality={85} style={inner(shiftR, 861, 704)} />
      </div>
      <div class="demo__gap" style={box(grab)}></div>
      <div class="demo__row" style={box(rowIn)}>
        <Image src={newRow} alt="" widths={[552, 1104]} sizes="(max-width: 1023px) 38vw, 245px" quality={90} />
      </div>
      <span class="demo__line" style={box(dropLine)}></span>
      <Image class="demo__sprite" src={dragRow} alt="" widths={[579, 1158]} sizes="(max-width: 1023px) 40vw, 260px" quality={90} style={box(sprite)} />
      <button class="demo__grab" type="button" style={box(grab)} aria-label="Move Jason Dauda into the roster"></button>

      <button class="demo__back" type="button" style={box(back)} aria-label="Back to the rosters"></button>
    </div>

    <div class="demo__menu" id="roster-menu" style={box(popup)} role="group" aria-label="Roster menu">
      <Image src={menu} alt={menuAlt} widths={[251, 502]} sizes="(max-width: 1023px) 18vw, 112px" quality={90} />
      <button class="demo__option" type="button" aria-label="Change status to activated"></button>
    </div>

    <span class="demo__cursor" aria-hidden="true">
      <svg class="demo__arrow" viewBox="0 0 24 24" width="24" height="24"><path d="M5 3v16.5l4.4-4.1 3.1 6.9 2.9-1.3-3.1-6.8 6-.5L5 3z" fill="#fff" stroke="#0d0d0d" stroke-width="1.4" stroke-linejoin="round" /></svg>
      <HandGrab class="demo__hand" aria-hidden="true" />
    </span>

    <button class="demo__spot" type="button" style={box(spot)} aria-haspopup="true" aria-expanded="false" aria-controls="roster-menu" aria-label="Open the menu of the first roster">
      <span class="demo__ring" aria-hidden="true"></span>
    </button>
  </div>
  <figcaption class="demo__hint">Click the dots on a roster card for its menu (try “activated”), or the card itself to step inside and drag a person into the roster.</figcaption>
</figure>

<style>
  .demo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .demo__screen {
    -webkit-user-select: none;
    user-select: none;
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .demo__screen :global(img) {
    -webkit-user-drag: none;
    display: block;
    width: 100%;
    height: auto;
  }

  /* The new status of the first card: the "draft" chip is covered by an "activated" one, as in the design */
  .demo__status {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding-left: 0.833cqw; /* 12 of the 1440px design */
    border-radius: 0.28cqw;
    background: #c8dcfa;
    font-size: 0.694cqw;
    line-height: 1;
    color: #000;
    opacity: 0;
    transform: scale(0.9);
    transform-origin: left center;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  [data-activated] .demo__status {
    opacity: 1;
    transform: none;
  }

  /* "activated" in the menu's "Change status to" row */
  .demo__option {
    position: absolute;
    left: 10.36%;
    top: 84%;
    width: 28.7%;
    height: 7.2%;
    padding: 0;
    border: 0;
    border-radius: var(--space-4);
    background: transparent;
    cursor: pointer;
    transition: box-shadow 0.15s ease;
  }

  .demo__option:hover {
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.3);
  }

  .demo__option:focus-visible {
    outline: 2px solid var(--erma-ink);
    outline-offset: 2px;
  }

  /* Each roster card is a quiet button over the picture */
  .demo__card {
    position: absolute;
    z-index: 2;
    padding: 0;
    border: 0;
    border-radius: var(--space-4);
    background: transparent;
    cursor: pointer;
    transition: box-shadow 0.15s ease;
  }

  [data-ready] .demo__card:hover {
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.25);
  }

  .demo__card:focus-visible,
  .demo__back:focus-visible {
    outline: 2px solid var(--erma-ink);
    outline-offset: 2px;
  }

  /* The roster page lies over the list and fades in when a card is opened */
  .demo__page {
    position: absolute;
    inset: 0;
    z-index: 6;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    background: var(--color-white);
  }

  [data-page] .demo__page {
    opacity: 1;
    pointer-events: auto;
  }

  .demo__back {
    position: absolute;
    padding: 0;
    border: 0;
    border-radius: var(--space-4);
    background: transparent;
    cursor: pointer;
  }

  .demo__menu {
    position: absolute;
    z-index: 3;
    transform-origin: top right;
    transition:
      opacity 0.2s ease,
      transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Closed: the menu waits, scaled down at the dots it grows from. Without script it simply stays open. */
  [data-ready] .demo__menu {
    opacity: 0;
    transform: scale(0.94);
    pointer-events: none;
  }

  [data-open] .demo__menu {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* The dots of the first card: a quiet round button over them, with a ring that invites the click until it happens */
  .demo__spot {
    position: absolute;
    z-index: 4;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .demo__spot:hover {
    background: rgb(0 0 0 / 0.06);
  }

  .demo__spot:focus-visible {
    outline: 2px solid var(--erma-ink);
    outline-offset: 2px;
  }

  .demo__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
  }

  [data-ready]:not([data-touched]) .demo__ring {
    animation: spot-ring 2s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  }

  @keyframes spot-ring {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--erma-orange) 70%, transparent);
    }
    70%,
    to {
      box-shadow: 0 0 0 10px transparent;
    }
  }

  /* A mouse pointer that plays the click for the visitor: it glides to the dots, presses, the menu opens. */
  .demo__cursor {
    position: absolute;
    z-index: 8;
    left: 56%;
    top: 62%;
    opacity: 0;
    pointer-events: none;
    transition:
      left 1.1s cubic-bezier(0.45, 0, 0.2, 1),
      top 1.1s cubic-bezier(0.45, 0, 0.2, 1),
      opacity 0.4s ease,
      transform 0.15s ease;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.25));
  }

  .demo__cursor[data-jump] {
    transition: none;
  }

  .demo__cursor[data-show] {
    opacity: 1;
  }

  .demo__cursor[data-press] {
    transform: scale(0.82);
  }

  .demo__cursor[data-at-spot] {
    left: 35.9%;
    top: 36.8%;
  }

  /* on "activated" in the menu */
  .demo__cursor[data-at-chip] {
    left: 24.8%;
    top: 60.8%;
  }

  /* on the second card, then on "Back" in the roster page */
  .demo__cursor[data-at-card] {
    left: 47%;
    top: 40.5%;
  }

  .demo__cursor[data-at-back] {
    left: 22.2%;
    top: 4.6%;
  }

  /* the click: a ring spreads from the dots */
  .demo__ring[data-click] {
    animation: spot-click 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  @keyframes spot-click {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--erma-ink) 45%, transparent);
    }
    to {
      box-shadow: 0 0 0 14px transparent;
    }
  }


  /* Inside the roster: a person is dragged from "Available Support" into the roster. The page is the picture; what changes is laid over it. */
  .demo__page :global(.demo__shift-img) {
    position: absolute;
    max-width: none;
    height: auto;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .demo__shift {
    position: absolute;
    z-index: 1;
    overflow: hidden;
  }

  [data-dropped] .demo__shift--l :global(.demo__shift-img) {
    transform: translateY(-3.958cqw); /* 57 of the 1440px design */
  }

  [data-dropped] .demo__shift--r :global(.demo__shift-img) {
    transform: translateY(3.958cqw);
  }

  .demo__cover {
    position: absolute;
    z-index: 1;
    display: none;
    background: var(--color-white);
  }

  [data-dropped] .demo__cover {
    display: block;
  }

  /* the gap he leaves in the list while he is in the air */
  .demo__gap {
    position: absolute;
    z-index: 2;
    display: none;
    background: #f9f9f9;
  }

  [data-lifted]:not([data-dropped]) .demo__gap {
    display: block;
  }

  .demo__line {
    position: absolute;
    z-index: 3;
    height: 0.139cqw; /* 2 of 1440 */
    background: #ff5000;
    opacity: 0;
  }

  [data-line]:not([data-dropped]) .demo__line {
    opacity: 1;
  }

  /* the lifted row, with its shadow; --dx and --dy are how far it has travelled, in pixels of the 1440px design */
  .demo__page :global(.demo__sprite) {
    position: absolute;
    z-index: 4;
    max-width: none;
    height: auto;
    opacity: 0;
    pointer-events: none;
    transform: translate(calc(var(--dx, 0) / 14.4 * 1cqw), calc(var(--dy, 0) / 14.4 * 1cqw));
    transition:
      transform 1.1s cubic-bezier(0.45, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  [data-lifted]:not([data-dropped]) .demo__page :global(.demo__sprite) {
    opacity: 1;
  }

  [data-dragging] .demo__page :global(.demo__sprite) {
    transition: opacity 0.2s ease;
  }

  /* the new row in the roster, cut from the design like its neighbours: "Dauda Jason, On behalf, Lineman" */
  .demo__row {
    position: absolute;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease 0.15s;
  }

  .demo__row :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  [data-dropped] .demo__row {
    opacity: 1;
  }

  /* the grip over his row: drag it with the mouse, or press it */
  .demo__grab {
    position: absolute;
    z-index: 5;
    padding: 0;
    border: 0;
    border-radius: var(--space-4);
    background: transparent;
    cursor: grab;
    touch-action: none;
  }

  .demo__grab:hover {
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.2);
  }

  .demo__grab:focus-visible {
    outline: 2px solid var(--erma-ink);
    outline-offset: 2px;
  }

  [data-lifted] .demo__grab {
    cursor: grabbing;
  }

  [data-dropped] .demo__grab {
    display: none;
  }

  /* the pointer turns into a hand while it carries the row */
  .demo__cursor :global(.demo__hand) {
    display: none;
    width: 23px;
    height: 24px;
    margin: -4px 0 0 -8px;
  }

  .demo__cursor[data-grab] .demo__arrow {
    display: none;
  }

  .demo__cursor[data-grab] :global(.demo__hand) {
    display: block;
  }

  .demo__cursor[data-at-grab] {
    left: 46.4%;
    top: 76.3%;
  }

  .demo__cursor[data-at-drop] {
    left: 87.4%;
    top: 65%;
    transition-duration: 1.1s;
  }

  .demo__hint {
    font-size: var(--fs-12);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .demo__cursor {
      display: none;
    }

    .demo__page :global(.demo__sprite),
    .demo__shift :global(.demo__shift-img),
    .demo__row,
    .demo__menu,
    .demo__spot,
    .demo__status,
    .demo__option,
    .demo__page,
    .demo__card {
      transition: none;
    }

    [data-ready]:not([data-touched]) .demo__ring {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-roster-menu]').forEach((demo) => {
    const spot = demo.querySelector<HTMLButtonElement>('.demo__spot');
    const menu = demo.querySelector<HTMLElement>('.demo__menu');
    const page = demo.querySelector<HTMLElement>('.demo__page');
    const screen = demo.querySelector<HTMLElement>('.demo__screen');
    const cursor = demo.querySelector<HTMLElement>('.demo__cursor');
    const ring = demo.querySelector<HTMLElement>('.demo__ring');
    if (!spot || !menu || !page || !screen) return;

    const setMenu = (open: boolean) => {
      demo.toggleAttribute('data-open', open);
      spot.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('inert', !open);
    };
    // The person who gets dragged into the roster: --dx and --dy are his travel, in pixels of the 1440px design
    const DROP = { dx: 584, dy: -116 };
    const setTravel = (dx: number, dy: number) => {
      demo.style.setProperty('--dx', String(dx));
      demo.style.setProperty('--dy', String(dy));
    };
    const resetDrag = () => {
      ['data-lifted', 'data-line', 'data-dropped', 'data-dragging'].forEach((name) => demo.removeAttribute(name));
      setTravel(0, 0);
    };
    const setPage = (show: boolean) => {
      resetDrag();
      demo.toggleAttribute('data-page', show);
      page.toggleAttribute('inert', !show);
      page.setAttribute('aria-hidden', String(!show));
    };

    demo.setAttribute('data-ready', '');
    setMenu(false);
    setPage(false);

    spot.addEventListener('click', () => {
      demo.setAttribute('data-touched', '');
      setMenu(!demo.hasAttribute('data-open'));
    });
    const setStatus = (on: boolean) => demo.toggleAttribute('data-activated', on);
    demo.querySelector('.demo__option')?.addEventListener('click', () => {
      demo.setAttribute('data-touched', '');
      setStatus(true);
      setMenu(false);
    });
    demo.querySelectorAll<HTMLElement>('[data-card]').forEach((card) =>
      card.addEventListener('click', () => {
        demo.setAttribute('data-touched', '');
        setMenu(false);
        setPage(true);
      }),
    );
    const grab = demo.querySelector<HTMLElement>('.demo__grab');
    const drop = () => {
      demo.removeAttribute('data-line');
      demo.setAttribute('data-dropped', '');
    };
    // a click or a key press moves him for you; a mouse drag moves him where you take him
    const autoMove = () => {
      demo.setAttribute('data-lifted', '');
      window.setTimeout(() => setTravel(DROP.dx, DROP.dy), 250);
      window.setTimeout(() => demo.setAttribute('data-line', ''), 1100);
      window.setTimeout(drop, 1500);
    };
    if (grab) {
      let from: { x: number; y: number; scale: number; moved: boolean } | null = null;
      const overRoster = (event: PointerEvent) => {
        const rect = screen.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 1440;
        return x > 862 && x < 1413;
      };
      grab.addEventListener('pointerdown', (event) => {
        demo.setAttribute('data-touched', '');
        grab.setPointerCapture(event.pointerId);
        from = { x: event.clientX, y: event.clientY, scale: screen.getBoundingClientRect().width / 1440, moved: false };
      });
      grab.addEventListener('pointermove', (event) => {
        if (!from) return;
        const dx = (event.clientX - from.x) / from.scale;
        const dy = (event.clientY - from.y) / from.scale;
        if (!from.moved && Math.hypot(dx, dy) < 6) return;
        from.moved = true;
        demo.setAttribute('data-lifted', '');
        demo.setAttribute('data-dragging', '');
        setTravel(dx, dy);
        demo.toggleAttribute('data-line', overRoster(event));
      });
      grab.addEventListener('pointerup', (event) => {
        if (!from) return;
        const { moved } = from;
        from = null;
        demo.removeAttribute('data-dragging');
        if (!moved) return;
        if (overRoster(event)) {
          setTravel(DROP.dx, DROP.dy);
          window.setTimeout(drop, 250);
        } else {
          demo.removeAttribute('data-line');
          setTravel(0, 0);
          window.setTimeout(() => demo.removeAttribute('data-lifted'), 300);
        }
      });
      grab.addEventListener('click', (event) => {
        // a plain click or a key press, not the end of a drag
        if (event.detail === 0 || event.detail === 1) {
          if (!demo.hasAttribute('data-lifted') && !demo.hasAttribute('data-dropped')) autoMove();
        }
      });
    }

    demo.querySelector('.demo__back')?.addEventListener('click', () => {
      demo.setAttribute('data-touched', '');
      setPage(false);
    });
    // a click on the list, outside the menu and the dots, closes the menu
    screen.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (demo.hasAttribute('data-open') && !target.closest('.demo__menu, .demo__spot')) setMenu(false);
    });
    document.addEventListener('click', (event) => {
      if (demo.hasAttribute('data-open') && !screen.contains(event.target as Node)) setMenu(false);
    });
    demo.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (demo.hasAttribute('data-page')) setPage(false);
      else if (demo.hasAttribute('data-open')) {
        setMenu(false);
        spot.focus();
      }
    });

    // A pointer plays the visit while the picture is on screen: the dots and the menu, then a roster card and its page, then Back.
    // It stops as soon as the visitor tries it themselves.
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!cursor || !ring || calm.matches || !('IntersectionObserver' in window)) return;

    let timers: number[] = [];
    let running = false;
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const place = (where: 'spot' | 'chip' | 'card' | 'grab' | 'drop' | 'back' | null) => {
      ['spot', 'chip', 'card', 'grab', 'drop', 'back'].forEach((name) => cursor.toggleAttribute(`data-at-${name}`, name === where));
    };
    const click = (then: () => void) => {
      cursor.setAttribute('data-press', '');
      at(150, () => {
        cursor.removeAttribute('data-press');
        ring.removeAttribute('data-click');
        void ring.offsetWidth;
        ring.setAttribute('data-click', '');
        then();
      });
    };
    const stop = () => {
      running = false;
      timers.forEach(window.clearTimeout);
      timers = [];
      cursor.removeAttribute('data-show');
      cursor.removeAttribute('data-press');
      cursor.removeAttribute('data-grab');
      place(null);
    };
    const play = () => {
      if (!running || demo.hasAttribute('data-touched')) return stop();
      setMenu(false);
      setPage(false);
      setStatus(false);
      at(300, () => cursor.setAttribute('data-show', ''));
      at(700, () => place('spot'));
      at(2000, () => click(() => setMenu(true)));
      at(3300, () => place('chip'));
      at(4600, () =>
        click(() => {
          setStatus(true);
          setMenu(false);
        }),
      );
      at(5600, () => place('card'));
      at(6900, () => click(() => setPage(true)));
      // inside the roster: the pointer takes a person from the left list and carries him across
      at(7900, () => place('grab'));
      at(9100, () => {
        cursor.setAttribute('data-press', '');
        at(150, () => {
          cursor.removeAttribute('data-press');
          cursor.setAttribute('data-grab', '');
          demo.setAttribute('data-lifted', '');
        });
      });
      at(9500, () => {
        place('drop');
        setTravel(DROP.dx, DROP.dy);
      });
      at(10400, () => demo.setAttribute('data-line', ''));
      at(10700, () => {
        cursor.removeAttribute('data-grab');
        drop();
      });
      at(11900, () => place('back'));
      at(13500, () => click(() => setPage(false)));
      at(14200, () => cursor.removeAttribute('data-show'));
      // back to the start while it is invisible, without gliding there; the card goes back to "draft"
      at(14700, () => {
        cursor.setAttribute('data-jump', '');
        place(null);
        void cursor.offsetWidth;
        cursor.removeAttribute('data-jump');
        setStatus(false);
      });
      at(15700, play);
    };
    spot.addEventListener('click', stop);
    grab?.addEventListener('pointerdown', stop);
    demo.querySelectorAll('[data-card], .demo__back, .demo__option').forEach((el) => el.addEventListener('click', stop));

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !running && !demo.hasAttribute('data-touched')) {
          running = true;
          play();
        } else if (!entry.isIntersecting && running) {
          stop();
          setMenu(false);
          setPage(false);
          setStatus(false);
        }
      },
      { threshold: 0.5 },
    ).observe(demo);
  });
</script>

---
import { Image } from 'astro:assets';

interface Props {
  screens: readonly { src: ImageMetadata; label: string; alt: string }[];
}

const { screens } = Astro.props;
---

<ul class="gallery">
  {screens.map((screen) => (
    <li class="screen">
      <div class="screen__frame">
        <Image class="screen__image" src={screen.src} alt={screen.alt} widths={[360, 546]} sizes="(max-width: 1023px) 70vw, 320px" quality={85} />
      </div>
      <p class="screen__label">{screen.label}</p>
    </li>
  ))}
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-32) var(--space-16);
  }

  .screen {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* Every phone is cropped to the same 390:844 frame from the top, so a long screen shows its first screenful. */
  .screen__frame {
    aspect-ratio: 390 / 844;
    overflow: hidden;
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .screen__frame :global(.screen__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .screen__label {
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    color: var(--color-ink);
  }

  @media (max-width: 1023px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

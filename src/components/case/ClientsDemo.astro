---
import PhoneTour from './PhoneTour.astro';
import SleepingBaby from './SleepingBaby.astro';
import type { Step } from './PhoneTour.astro';
import empty from '../../assets/images/cli-1-empty.png';
import share from '../../assets/images/cli-2-share.png';
import list from '../../assets/images/cli-3-list.png';
import profile from '../../assets/images/cli-5-profile-totals.png';
import dayA from '../../assets/images/cli-4-day-a.png';
import dayB from '../../assets/images/cli-4-day-b.png';

/* Adding a client, played by itself: the empty list, the invite link, the client list once they have signed up, the client's profile and her day. */
interface Props {
  alt: string;
}

const { alt } = Astro.props;

const screens = [
  { src: empty, alt },
  { src: share, alt: 'Share invite link: a link that invites the client to download the app, with Instagram, Telegram and share buttons.' },
  { src: list, alt: 'Active clients with their diary status, package and dates.' },
  { src: profile, alt: 'A client’s profile: the baby’s photo, name and age, the parent, and the diary with its Day and Period views and the totals open.' },
  { src: [dayA, dayB] as const, tall: true, alt: 'The client’s day: totals, the first sleep and its details.' },
];

const tour = [
  [{ move: [190, 520] }, { wait: 400 }, { tap: [192, 600] }], // add a client
  [
    { move: [250, 700] },
    { wait: 400 },
    { tap: [336, 707] }, // copy the link
    { wait: 500 },
    { move: [194, 783] },
    { wait: 250 },
    { tap: [194, 783] }, // send it
    { wait: 800 },
  ],
  [{ move: [300, 201] }, { wait: 600 }, { move: [190, 300] }, { wait: 300 }, { tap: [190, 300] }], // the client has signed up: open her card
  [{ move: [200, 560] }, { wait: 900 }, { scroll: 234, show: 4 }], // no tap: the page scrolls, the photo folds away into the compact header (the next screen)
  [{ move: [200, 520] }, { wait: 500 }, { scroll: 560 }, { wait: 500 }, { scroll: 1171 }, { wait: 1200 }], // the day, down to the details
] satisfies Step[][];
---

<PhoneTour screens={screens} tour={tour} start={[300, 420]}>
  <SleepingBaby slot="screen-0" />
</PhoneTour>

---
import Verify from './Verify.astro';

interface MetaItem {
  label: string;
  value: string;
  verify?: boolean;
}
interface Props {
  hero: {
    tags: readonly string[];
    eyebrow: string;
    title: string;
    lead: string;
    meta: readonly MetaItem[];
    focus: readonly string[];
  };
}

const { hero } = Astro.props;
---

<header class="hero">
  <div class="hero__text">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title">{hero.title}</h1>
    <p class="hero__lead">{hero.lead}</p>
    <ul class="hero__pills" aria-label="Focus">
      {hero.focus.map((item) => <li class="hero__pill">{item}</li>)}
    </ul>
  </div>

  <div class="hero__card">
    <dl class="hero__meta">
      {hero.meta.map((item) => (
        <div class="hero__cell">
          <dt>{item.label}</dt>
          <dd>{item.value}{item.verify && <Verify />}</dd>
        </div>
      ))}
    </dl>

    <div class="hero__areas">
      <p class="hero__areas-title">Focus areas</p>
      <ul class="hero__chips" aria-label="Project tags">
        {hero.tags.map((tag) => <li class="hero__chip">{tag}</li>)}
      </ul>
    </div>
  </div>
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--case-meta-w);
    gap: var(--space-32) var(--case-hero-gap);
    align-items: start;
    padding-bottom: var(--case-hero-pad-bottom);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .hero__eyebrow {
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-14-20);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .hero__title {
    max-width: 764px;
    font-family: var(--font-display);
    font-size: var(--fs-case-title);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-title);
    color: var(--color-ink);
  }

  .hero__lead {
    max-width: 664px;
    font-size: var(--fs-20);
    line-height: var(--lh-lead);
    color: var(--color-ink);
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-4);
  }

  .hero__pill {
    padding: var(--space-4) var(--space-14);
    border-radius: var(--radius-pill);
    background: var(--case-pill-bg);
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
    color: var(--case-pill-fg);
  }

  /* The card: frosted glass, a lighter card inside it with the four facts, then the focus areas. */
  .hero__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    padding: var(--space-20);
    border-radius: var(--radius-glass);
    background: var(--case-glass);
    backdrop-filter: blur(var(--case-glass-blur));
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border-radius: var(--radius-glass-inner);
    background: var(--case-glass-inner);
  }

  .hero__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-16);
    background: var(--case-glass-cell);
  }

  .hero__meta dt {
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
    color: var(--color-black);
  }

  .hero__meta dd {
    margin: 0;
    font-size: var(--fs-16);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-20);
    color: var(--color-black);
  }

  .hero__areas {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .hero__areas-title {
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
    color: var(--case-accent);
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .hero__chip {
    padding: var(--space-4) var(--space-12);
    border-radius: var(--radius-pill);
    background: var(--case-glass-chip);
    font-size: var(--fs-12);
    line-height: var(--lh-12-18);
    color: var(--case-chip-text);
  }

  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: 0;
    }
  }

  @media (max-width: 480px) {
    .hero__meta {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import Verify from './Verify.astro';

interface MetaItem {
  label: string;
  value: string;
  verify?: boolean;
}
interface Props {
  hero: {
    tags: readonly string[];
    eyebrow: string;
    title: string;
    lead: string;
    meta: readonly MetaItem[];
    focus: readonly string[];
  };
}

const { hero } = Astro.props;
---

<header class="hero">
  <ul class="hero__tags" aria-label="Project tags">
    {hero.tags.map((tag) => <li class="hero__tag">{tag}</li>)}
  </ul>

  <div class="hero__grid">
    <div class="hero__text">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 class="hero__title">{hero.title}</h1>
      <p class="hero__lead">{hero.lead}</p>
      <ul class="hero__focus" aria-label="Focus areas">
        {hero.focus.map((item) => <li class="hero__chip">{item}</li>)}
      </ul>
    </div>

    <dl class="hero__meta">
      {hero.meta.map((item) => (
        <div class="hero__meta-row">
          <dt>{item.label}</dt>
          <dd>{item.value}{item.verify && <Verify />}</dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .hero__tag {
    padding: var(--space-4) var(--space-14);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-pill);
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
    color: var(--color-ink-button);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--case-meta-w);
    gap: var(--space-32) var(--space-59);
    align-items: start;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .hero__eyebrow {
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-14-20);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--fs-case-title);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-title);
    color: var(--color-ink);
  }

  .hero__lead {
    max-width: var(--case-measure);
    font-size: var(--fs-20);
    line-height: var(--lh-lead);
    color: var(--color-ink);
  }

  .hero__focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-4);
  }

  .hero__chip {
    padding: var(--space-4) var(--space-14);
    border-radius: var(--radius-pill);
    background: var(--case-bg);
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-14-20);
    color: var(--case-on-bg);
  }

  .hero__meta {
    display: flex;
    flex-direction: column;
    padding: var(--case-card-pad);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .hero__meta-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-12);
    border-bottom: 1px solid var(--case-line);
  }

  .hero__meta-row:first-child {
    padding-top: 0;
  }

  .hero__meta-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .hero__meta dt {
    font-size: var(--fs-12);
    font-weight: var(--weight-medium);
    line-height: var(--lh-12-18);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__meta dd {
    margin: 0;
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }

  @media (max-width: 1023px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

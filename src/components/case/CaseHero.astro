---
import Verify from './Verify.astro';

interface MetaItem {
  label: string;
  value: string;
  verify?: boolean;
}
interface Props {
  hero: {
    tags: readonly string[];
    eyebrow: string;
    title: string;
    lead: string;
    meta: readonly MetaItem[];
    focus: readonly string[];
  };
}

const { hero } = Astro.props;
---

<header class="hero">
  <div class="hero__text">
    <ul class="hero__pills" aria-label="Focus">
      {hero.focus.map((item) => <li class="hero__pill">{item}</li>)}
    </ul>
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title">{hero.title}</h1>
    <p class="hero__lead">{hero.lead}</p>
  </div>

  <div class="hero__aside">
    <p class="hero__tab">At a glance</p>
    <div class="hero__card">
    <dl class="hero__meta">
      {hero.meta.map((item) => (
        <div class="hero__cell">
          <dt>{item.label}</dt>
          <dd>{item.value}{item.verify && <Verify />}</dd>
        </div>
      ))}
    </dl>

    <div class="hero__areas">
      <p class="hero__areas-title">Focus areas</p>
      <ul class="hero__chips" aria-label="Project tags">
        {hero.tags.map((tag) => <li class="hero__chip">{tag}</li>)}
      </ul>
    </div>
    </div>
  </div>
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--case-meta-w);
    gap: var(--space-32) var(--case-hero-gap);
    align-items: start;
    min-height: var(--case-hero-h);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .hero__eyebrow {
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .hero__title {
    max-width: 764px;
    font-family: var(--font-display);
    font-size: var(--fs-case-title);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    color: var(--color-ink);
    letter-spacing: var(--ls-display);
  }

  .hero__lead {
    max-width: 664px;
    font-size: var(--fs-20);
    line-height: var(--lh-lead);
    color: var(--color-ink);
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  /* The same soft chip as the tools in the process section. */
  .hero__pill {
    padding: var(--space-4) var(--space-14);
    border-radius: var(--radius-pill);
    background: var(--case-pill-bg);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--case-pill-text);
  }

  /* A frosted-glass folder: the "At a glance" tab sits on the top-left of the card, flush with it. */
  .hero__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__tab {
    box-sizing: border-box;
    width: var(--case-tab-w);
    height: var(--case-tab-h);
    padding: var(--space-20);
    border-radius: var(--radius-glass) var(--radius-glass) 0 0;
    background: var(--case-glass);
    backdrop-filter: blur(var(--case-glass-blur));
    font-size: var(--fs-16);
    line-height: var(--lh-snug);
    color: var(--case-accent);
  }

  .hero__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    align-self: stretch;
    padding: var(--space-20);
    border-radius: 0 var(--radius-glass) var(--radius-glass) var(--radius-glass);
    background: var(--case-glass);
    backdrop-filter: blur(var(--case-glass-blur));
  }

  /* The four facts: a lighter card, cells with 1px lines between them (right and bottom edges, as designed). */
  .hero__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border-radius: var(--radius-glass-inner);
    background: var(--case-glass-inner);
    backdrop-filter: blur(var(--case-glass-blur-inner));
  }

  .hero__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-16);
    background: var(--case-glass-cell);
  }

  /* The lines sit inside the 80px cells, as in the design, so the cell loses a pixel of padding to its line. */
  .hero__cell:nth-child(1) {
    padding-bottom: calc(var(--space-16) - 1px);
    border-right: 1px solid var(--case-divider);
    border-bottom: 1px solid var(--case-divider);
  }

  .hero__cell:nth-child(2) {
    padding-bottom: calc(var(--space-16) - 1px);
    border-bottom: 1px solid var(--case-divider);
  }

  .hero__cell:nth-child(3) {
    border-right: 1px solid var(--case-divider);
    border-bottom: 1px solid transparent; /* the design's card is a pixel taller than its two rows */
  }

  .hero__cell:nth-child(4) {
    border-bottom: 1px solid transparent;
  }

  .hero__meta dt {
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-black);
  }

  .hero__meta dd {
    margin: 0;
    font-size: var(--fs-16);
    font-weight: var(--weight-bold);
    line-height: var(--lh-ui);
    color: var(--color-black);
  }

  .hero__areas {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .hero__areas-title {
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--case-accent);
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .hero__chip {
    padding: var(--space-4) var(--space-12);
    border-radius: var(--radius-pill);
    background: var(--case-glass-chip);
    font-size: var(--fs-12);
    line-height: var(--lh-snug);
    color: var(--case-chip-text);
  }

  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
  }

  @media (max-width: 480px) {
    .hero__meta {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__cell:nth-child(n) {
      border-right: 0;
      border-bottom: 1px solid var(--case-divider);
    }

    .hero__cell:last-child {
      border-bottom: 0;
    }

    .hero__cell:nth-child(3) {
      border-bottom: 1px solid var(--case-divider);
    }
  }
</style>

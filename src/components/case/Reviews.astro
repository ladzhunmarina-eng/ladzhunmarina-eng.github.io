---
interface Review {
  title?: string;
  text: string;
  author: string;
  date: string;
  /** The review was written in another language and is shown translated */
  translated?: boolean;
}
interface Props {
  rating: { score: string; label: string };
  reviews: readonly Review[];
}

const { rating, reviews } = Astro.props;
---

<div class="board">
  <p class="rating">
    <span class="rating__score">{rating.score}</span>
    <span class="rating__side">
      <span class="rating__stars" role="img" aria-label="5 out of 5 stars">★★★★★</span>
      <span class="rating__label">{rating.label}</span>
    </span>
  </p>

  <ul class="reviews">
    {reviews.map((review) => (
      <li class="review">
        <span class="review__mark" aria-hidden="true">“</span>
        {review.title && <h3 class="review__title">{review.title}</h3>}
        <blockquote class="review__text">{review.text}</blockquote>
        <p class="review__source">{review.author} · App Store · {review.date}{review.translated && ' · translated from Ukrainian'}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .board {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .rating {
    display: flex;
    align-items: center;
    gap: var(--space-20);
    padding: var(--space-24) var(--space-32);
    border-radius: var(--radius-card);
    background: var(--case-bg);
    color: var(--color-white);
  }

  .rating__score {
    font-family: var(--font-display);
    font-size: var(--fs-56);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
  }

  .rating__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .rating__stars {
    font-size: var(--fs-20);
    letter-spacing: 0.15em;
    line-height: 1;
  }

  .rating__label {
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
  }

  .reviews {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--case-card-pad);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .review__mark {
    font-family: var(--font-display);
    font-size: var(--fs-56);
    font-weight: var(--weight-bold);
    line-height: 0.6;
    height: var(--space-24);
    color: var(--case-bg);
  }

  .review__title {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
    color: var(--color-ink);
  }

  .review__text {
    margin: 0;
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }

  .review__source {
    margin-top: auto;
    padding-top: var(--space-8);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }

  @media (max-width: 1023px) {
    .reviews {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

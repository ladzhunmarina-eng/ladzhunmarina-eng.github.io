---
import Phone from './Phone.astro';

interface Props {
  screens: readonly { src: ImageMetadata; label: string; alt: string }[];
}

const { screens } = Astro.props;
---

<div class="strip" tabindex="0" role="region" aria-label="Screens, scroll sideways">
  <ul class="strip__list">
    {screens.map((screen) => (
      <li class="strip__item">
        <Phone src={screen.src} alt={screen.alt} sizes="240px" />
        <p class="strip__label">{screen.label}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .strip {
    overflow-x: auto;
    padding: var(--space-8) 0 var(--space-16);
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--case-line) transparent;
  }

  .strip__list {
    display: flex;
    gap: var(--space-24);
    width: max-content;
  }

  .strip__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 240px;
    scroll-snap-align: start;
  }

  .strip__label {
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    color: var(--color-ink);
  }
</style>

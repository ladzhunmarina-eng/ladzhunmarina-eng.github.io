---
interface Step {
  label: string;
  /** A step where the old process hurt: drawn with the accent outline */
  hot?: boolean;
  /** What went wrong there, under the step */
  note?: string;
  /** Who owns the step, as a small tag under it */
  role?: string;
}

interface Props {
  steps: readonly Step[];
  label: string;
}

const { steps, label } = Astro.props;
---

<!-- A row of steps joined by dotted lines. Notes hang under the steps that hurt; roles sit under the steps they belong to. -->
<ol class="flow" style={`--n: ${steps.length}`} aria-label={label}>
  {steps.map((step) => (
    <li class="step">
      <p class:list={['step__box', { 'step__box--hot': step.hot }]}>{step.label}</p>
      {step.note && <p class="step__note">{step.note}</p>}
      {step.role && <p class="step__role">{step.role}</p>}
    </li>
  ))}
</ol>

<style>
  .flow {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    column-gap: var(--space-20);
    align-items: start;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .step__box,
  .step__note,
  .step__role {
    text-align: center;
  }

  .step__box {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 76px;
    padding: var(--space-12);
    border: 2px dotted var(--erma-dash);
    border-radius: var(--space-8);
    background: var(--color-white);
    font-size: var(--fs-16);
    line-height: var(--lh-snug);
    color: var(--color-ink);
  }

  .step__box--hot {
    border-color: var(--erma-orange);
  }

  /* the dotted line to the next step */
  .step:not(:last-child) .step__box::after {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(100% + 2px);
    width: var(--space-20);
    border-top: 2px dotted var(--erma-dash);
  }

  .step__note {
    position: relative;
    padding: var(--space-12);
    border: 2px dotted var(--erma-orange);
    border-radius: var(--space-8);
    background: var(--color-white);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-ink);
  }

  /* the dashed line from the step down to its note */
  .step__note::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(100% + 2px);
    height: var(--space-24);
    border-left: 2px dashed var(--erma-orange);
  }

  .step__role {
    align-self: center;
    margin-top: calc(-1 * var(--space-8));
    padding: var(--space-4) var(--space-12);
    border: 2px dotted var(--erma-dash);
    border-radius: var(--radius-pill);
    font-size: var(--fs-12);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }

  @media (max-width: 1023px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-24);
    }

    .step {
      gap: var(--space-16);
    }

    /* the line to the next step runs down instead of across */
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 100%;
      left: 50%;
      height: var(--space-24);
      border-left: 2px dotted var(--erma-dash);
    }

    .step:not(:last-child) .step__box::after {
      display: none;
    }

    .step__note::before {
      height: var(--space-16);
    }
  }
</style>

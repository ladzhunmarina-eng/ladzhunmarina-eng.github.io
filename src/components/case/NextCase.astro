---
import { Image } from 'astro:assets';
import ArrowIcon from '../../assets/icons/arrow-up-right.svg';
import { work } from '../../data/content';

interface Props {
  /** The page we are on, e.g. "/work/olx" */
  current: string;
}

const { current } = Astro.props;

// The next case that exists as a page: the following card, skipping the ones still without a page, then round to the first.
const here = work.findIndex((item) => item.href === current);
const ready = [...work.slice(here + 1), ...work.slice(0, here)].filter((item) => item.href.startsWith('/work/'));
const next = ready[0];
const themeVars = next && { yellow: '1', cream: '2', lilac: '3', mint: '4' }[next.theme];
---

{next && (
  <section class="next" aria-label="Next case" style={`--bg: var(--work-${themeVars}-bg); --panel: var(--work-${themeVars}-panel)`}>
    <div class="next__text">
      <p class="next__eyebrow">Next case</p>
      <h2 class="next__title"><a class="next__link" href={next.href}>{next.title}</a></h2>
      <p class="next__category">{next.category}</p>
      <p class="next__go" aria-hidden="true">
        View case
        <ArrowIcon />
      </p>
    </div>
    <div class="next__panel">
      <Image class="next__image" src={next.image} alt="" widths={[360, 720]} sizes="(max-width: 1023px) 80vw, 420px" quality={85} />
    </div>
  </section>
)}

<style>
  /* A dark neutral block, so it stands apart from any case palette; the panel keeps the next case's own colour. The whole block is one link (see .next__link); the pill says so and turns yellow on hover. */
  .next {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
    padding: var(--space-16);
    border-radius: var(--radius-card);
    background: var(--color-next-bg);
  }

  .next__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-16);
  }

  .next__eyebrow {
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-white);
    opacity: 0.7;
  }

  .next__title {
    font-family: var(--font-display);
    font-size: var(--fs-case-h3);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
    color: var(--color-white);
  }

  .next__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  .next__link:focus-visible {
    outline: none;
  }

  .next__link:focus-visible::after {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .next__category {
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--color-white);
    opacity: 0.8;
  }

  .next__go {
    display: flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-12);
    height: var(--button-height-sm);
    margin-top: var(--space-8);
    padding-inline: var(--space-20);
    border-radius: var(--radius-button);
    background: var(--color-white);
    color: var(--color-black);
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
    transition:
      background-color 0.25s ease-out,
      color 0.25s ease-out;
  }

  .next__go :global(svg) {
    width: var(--space-16);
    height: var(--space-16);
    stroke-width: 1.5;
    transition: transform 0.3s var(--ease-out);
  }

  .next:hover .next__go,
  .next:has(.next__link:focus-visible) .next__go {
    background: var(--color-nav-active);
    color: var(--color-black);
  }

  .next:hover .next__go :global(svg),
  .next:has(.next__link:focus-visible) .next__go :global(svg) {
    transform: translate(2px, -2px);
  }

  .next__panel {
    overflow: hidden;
    aspect-ratio: var(--work-panel-aspect);
    border-radius: var(--radius-person);
    background: var(--panel);
  }

  .next__panel :global(.next__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    transform: scale(0.907);
    transform-origin: 50% 100%;
    transition: transform 0.45s var(--ease-out);
  }

  .next:hover .next__panel :global(.next__image),
  .next:has(.next__link:focus-visible) .next__panel :global(.next__image) {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .next__go,
    .next__go :global(svg),
    .next__panel :global(.next__image) {
      transition: none;
    }

    .next:hover .next__go :global(svg),
    .next:has(.next__link:focus-visible) .next__go :global(svg) {
      transform: none;
    }
  }

  @media (max-width: 1023px) {
    .next {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
interface Props {
  /** The anchor the Challenge section links to */
  id?: string;
  /** "01", "02": the number of the decision */
  index?: string;
  /** Two small pills: the first in the accent tint, the second neutral */
  tags?: readonly string[];
  title: string;
  description?: string;
}

const { id, index, tags = [], title, description } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<article id={id} class:list={['decision', { 'decision--wide': !hasMedia }]}>
  <div class="decision__body">
    <header class="decision__head">
      {index && <p class="decision__index">{index}</p>}
      {tags.length > 0 && (
        <ul class="decision__tags" aria-label="Tags">
          {tags.map((tag, i) => <li class:list={['decision__tag', { 'decision__tag--accent': i === 0 }]}>{tag}</li>)}
        </ul>
      )}
      <h3 class="decision__title">{title}</h3>
      {description && <p class="decision__description">{description}</p>}
    </header>
    {hasMedia && (
      <div class="decision__media">
        <slot name="media" />
      </div>
    )}
  </div>

  <slot />
</article>

<style>
  .decision {
    scroll-margin-top: calc(var(--header-h) + var(--space-24));
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .decision__body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-32);
    /* the text sits level with the middle of the mockup */
    align-items: center;
  }

  .decision__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: var(--case-measure);
  }

  .decision__index {
    font-size: var(--fs-14);
    font-weight: var(--weight-bold);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    color: var(--case-accent);
  }

  /* two soft pills in a row: the first in the beige of the platform pills, the second in the peach */
  .decision__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .decision__tag {
    padding: var(--space-4) var(--space-12);
    border-radius: var(--radius-pill);
    background: var(--erma-peach);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-ink);
  }

  .decision__tag--accent {
    background: var(--erma-pill);
  }

  .decision__title {
    font-family: var(--font-display);
    font-size: var(--fs-case-h3);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
    color: var(--color-ink);
  }

  .decision__description {
    font-size: var(--fs-18);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  .decision__media {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    min-width: 0;
  }

  /* no pictures beside it: the text takes the row */
  .decision--wide .decision__body {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 1023px) {
    .decision__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

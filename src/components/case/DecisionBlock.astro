---
interface Props {
  /** "01", "02": the number of the decision */
  index?: string;
  title: string;
  lead?: string;
  pain?: string;
  decision?: string;
  why?: string;
  tradeoff?: string;
}

const { index, title, lead, pain, decision, why, tradeoff } = Astro.props;
const steps = [
  { label: 'Pain', text: pain },
  { label: 'Decision', text: decision },
  { label: 'Why', text: why },
  { label: 'Trade-off', text: tradeoff },
].filter((step) => step.text);
const hasMedia = Astro.slots.has('media');
---

<article class:list={['decision', { 'decision--wide': !hasMedia }]}>
  <header class="decision__head">
    {index && <p class="decision__index">{index}</p>}
    <h3 class="decision__title">{title}</h3>
    {lead && <p class="decision__lead">{lead}</p>}
  </header>

  <div class="decision__body">
    <dl class="decision__steps">
      {steps.map((step) => (
        <div>
          <dt>{step.label}</dt>
          <dd>{step.text}</dd>
        </div>
      ))}
    </dl>
    {hasMedia && (
      <div class="decision__media">
        <slot name="media" />
      </div>
    )}
  </div>

  <slot />
</article>

<style>
  .decision {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .decision__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--case-measure);
  }

  .decision__index {
    font-size: var(--fs-14);
    font-weight: var(--weight-bold);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    color: var(--case-accent);
  }

  .decision__title {
    font-family: var(--font-display);
    font-size: var(--fs-case-h3);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
    color: var(--color-ink);
  }

  .decision__lead {
    font-size: var(--fs-18);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }

  .decision__body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-32);
    align-items: start;
  }

  .decision__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .decision__steps dt {
    margin-bottom: var(--space-4);
    font-size: var(--fs-14);
    font-weight: var(--weight-bold);
    line-height: var(--lh-snug);
    color: var(--case-accent);
  }

  .decision__steps dd {
    margin: 0;
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }

  .decision__media {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    min-width: 0;
  }

  /* no pictures beside it: the four steps run side by side */
  .decision--wide .decision__body {
    grid-template-columns: minmax(0, 1fr);
  }

  .decision--wide .decision__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--case-card-min-wide), 1fr));
    gap: var(--space-24);
  }

  @media (max-width: 1023px) {
    .decision__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import Verify from './Verify.astro';

interface Props {
  id?: string;
  eyebrow: string;
  title?: string;
  lead?: string;
  verify?: boolean;
  /** "01", "02": the number of a feature, above the eyebrow, as the decisions are numbered on the other cases */
  index?: string;
}

const { id, eyebrow, title, lead, verify = false, index } = Astro.props;
const titleId = id && title ? `${id}-title` : undefined;
---

<section class="section" id={id} aria-labelledby={titleId} aria-label={titleId ? undefined : eyebrow}>
  <div class="section__head">
    <div class="section__heading">
      {index && <p class="section__index">{index}</p>}
      <p class="section__eyebrow">{eyebrow}</p>
      {title && <h2 class="section__title" id={titleId}>{title}{verify && <Verify />}</h2>}
      {lead && <p class="section__lead">{lead}</p>}
    </div>
    <!-- An optional picture beside the heading (a decorative illustration) -->
    <div class="section__art"><slot name="art" /></div>
  </div>
  <div class="section__body"><slot /></div>
</section>

<style>
  .section {
    scroll-margin-top: calc(var(--header-h) + var(--space-24));
  }

  .section__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
  }

  .section__heading {
    min-width: 0;
  }

  .section__index {
    margin-bottom: var(--space-8);
    font-size: var(--fs-14);
    font-weight: var(--weight-bold);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    color: var(--case-accent);
  }

  .section__art:empty {
    display: none;
  }

  .section__art {
    flex: none;
    width: var(--case-art-w);
    /* the picture has air around it; pull it in so it sits level with the heading */
    margin-block: calc(-1 * var(--space-36));
  }

  .section__art :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 1023px) {
    .section__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .section__art {
      width: min(100%, var(--case-art-w-small));
      margin-block: calc(-1 * var(--space-16)) 0;
    }
  }

  .section__eyebrow {
    margin-bottom: var(--space-12);
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .section__title {
    max-width: var(--case-measure);
    font-family: var(--font-display);
    font-size: var(--fs-case-h2);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    color: var(--color-ink);
    letter-spacing: var(--ls-display);
    white-space: pre-line; /* a \n in the title breaks the line there, as in the case heroes */
  }

  .section__lead {
    max-width: var(--case-measure);
    margin-top: var(--space-16);
    font-size: var(--fs-20);
    line-height: var(--lh-lead);
    color: var(--color-ink);
  }

  .section__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    margin-top: var(--space-32);
  }

  .section__body > :global(p) {
    max-width: var(--case-measure);
    font-size: var(--fs-18);
    line-height: var(--lh-body);
  }
</style>

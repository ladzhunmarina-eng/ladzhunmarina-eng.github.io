---
import Verify from './Verify.astro';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lead?: string;
  verify?: boolean;
}

const { id, eyebrow, title, lead, verify = false } = Astro.props;
const titleId = id ? `${id}-title` : undefined;
---

<section class="section" id={id} aria-labelledby={titleId}>
  <p class="section__eyebrow">{eyebrow}</p>
  <h2 class="section__title" id={titleId}>{title}{verify && <Verify />}</h2>
  {lead && <p class="section__lead">{lead}</p>}
  <div class="section__body"><slot /></div>
</section>

<style>
  .section {
    scroll-margin-top: calc(var(--header-h) + var(--space-24));
  }

  .section__eyebrow {
    margin-bottom: var(--space-12);
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .section__title {
    max-width: var(--case-measure);
    font-family: var(--font-display);
    font-size: var(--fs-case-h2);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    color: var(--color-ink);
    letter-spacing: var(--ls-display);
  }

  .section__lead {
    max-width: var(--case-measure);
    margin-top: var(--space-16);
    font-size: var(--fs-20);
    line-height: var(--lh-lead);
    color: var(--color-ink);
  }

  .section__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    margin-top: var(--space-32);
  }

  .section__body > :global(p) {
    max-width: var(--case-measure);
    font-size: var(--fs-18);
    line-height: var(--lh-body);
  }
</style>

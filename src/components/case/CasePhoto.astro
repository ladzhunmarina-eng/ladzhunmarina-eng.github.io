---
import { Image } from 'astro:assets';

/* A photograph at the width of the column, with the card radius. */
interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;
}

const { src, alt, ratio = '1008 / 567' } = Astro.props;
---

<div class="photo" style={`--ratio: ${ratio}`}>
  <Image class="photo__image" src={src} alt={alt} widths={[720, 1008, 1512]} sizes="(max-width: 1023px) 100vw, 1008px" quality={80} />
</div>

<style>
  .photo {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-icon-bg);
  }

  .photo :global(.photo__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

---
interface Props {
  items: readonly { chose: string; over: string; why: string }[];
}

const { items } = Astro.props;
---

<ol class="decisions">
  {items.map((item) => (
    <li class="decision">
      <dl>
        <div class="decision__row decision__row--chose">
          <dt>Chose</dt>
          <dd>{item.chose}</dd>
        </div>
        <div class="decision__row">
          <dt>Over</dt>
          <dd>{item.over}</dd>
        </div>
        <div class="decision__row">
          <dt>Why</dt>
          <dd>{item.why}</dd>
        </div>
      </dl>
    </li>
  ))}
</ol>

<style>
  .decisions {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .decision {
    overflow: hidden;
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .decision__row {
    display: grid;
    grid-template-columns: var(--case-label-w) minmax(0, 1fr);
    gap: var(--space-16);
    padding: var(--space-14) var(--case-card-pad);
    border-bottom: 1px solid var(--case-line);
  }

  .decision__row:last-child {
    border-bottom: 0;
  }

  .decision__row--chose {
    background: var(--case-bg);
  }

  .decision dt {
    font-size: var(--fs-12);
    font-weight: var(--weight-medium);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .decision__row--chose dt {
    color: var(--case-on-bg);
  }

  .decision dd {
    margin: 0;
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }

  .decision__row--chose dd {
    font-weight: var(--weight-medium);
    color: var(--case-on-bg);
  }

  @media (max-width: 640px) {
    .decision__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
  }
</style>

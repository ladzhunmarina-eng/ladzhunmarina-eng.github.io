---
// GeomanistOLX, the typeface of the OLX mockups, is not available for the web; Figtree is the closest open one.
import '@fontsource-variable/figtree/index.css';
import UkrposhtaLogo from '../../assets/icons/carrier-ukrposhta.svg';
import NovaPostLogo from '../../assets/icons/carrier-novapost.svg';
import MeestLogo from '../../assets/icons/carrier-meest.svg';
import InfoIcon from '../../assets/icons/info.svg';

interface Props {
  title: string;
  badge: string;
  hint: string;
  priceLabel: string;
  priceNote: string;
  methodsLabel: string;
  methods: readonly { label: string; checked: boolean; disabled?: boolean }[];
}

const { title, badge, hint, priceLabel, priceNote, methodsLabel, methods } = Astro.props;
---

<!--
  A working copy of the seller's "Offer free delivery" card. Switching Ukrposhta on opens its settings
  (the second state in the design); switching it off closes them. The other two carriers only flip their switch.
-->
<div class="demo">
  <div class="demo__stage">
    <section class="form" aria-labelledby="form-title">
      <header class="form__head">
        <h4 id="form-title" class="form__title">{title}</h4>
        <p class="form__badge">{badge}</p>
      </header>
      <p class="form__desc">
        The delivery cost will be <strong>deducted from your payout</strong> after the buyer receives the order. If the buyer rejects it, <strong>OLX covers the return cost.</strong>{' '}<span class="form__link">How does this work?</span>
      </p>

      <ul class="carriers">
        <li class="carrier" data-carrier="ukrposhta" data-open="false">
          <div class="carrier__row">
            <UkrposhtaLogo class="carrier__logo" aria-hidden="true" />
            <p class="carrier__name">Ukrposhta</p>
            <button class="switch" type="button" role="switch" aria-checked="false" aria-label="Ukrposhta" aria-controls="ukrposhta-settings" data-demo-switch><span class="switch__knob"></span></button>
          </div>
          <div class="carrier__panel" id="ukrposhta-settings" inert>
            <div class="carrier__clip">
              <div class="settings">
                <div class="settings__price">
                  <label class="settings__label" for="min-price">{priceLabel}</label>
                  <div class="field">
                    <input class="field__input" id="min-price" type="number" inputmode="numeric" min="0" placeholder="0" aria-describedby="min-price-note" />
                    <span class="field__unit" aria-hidden="true">uah</span>
                  </div>
                  <p class="settings__note" id="min-price-note">
                    <InfoIcon class="settings__info" aria-hidden="true" />
                    <span>{priceNote}</span>
                  </p>
                </div>
                <fieldset class="methods">
                  <legend class="methods__label">{methodsLabel}</legend>
                  {methods.map((method) => (
                    <label class:list={['method', { 'method--off': method.disabled }]}>
                      <input class="method__input" type="checkbox" checked={method.checked} disabled={method.disabled} />
                      <span class="method__box" aria-hidden="true">
                        <svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7.4 5.6 10.4 11.5 3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </span>
                      <span class="method__text">{method.label}</span>
                    </label>
                  ))}
                </fieldset>
              </div>
            </div>
          </div>
        </li>
        <li class="carrier">
          <div class="carrier__row">
            <NovaPostLogo class="carrier__logo" aria-hidden="true" />
            <p class="carrier__name">Nova Post</p>
            <button class="switch" type="button" role="switch" aria-checked="false" aria-label="Nova Post" data-demo-switch><span class="switch__knob"></span></button>
          </div>
        </li>
        <li class="carrier">
          <div class="carrier__row">
            <MeestLogo class="carrier__logo" aria-hidden="true" />
            <p class="carrier__name">Meest</p>
            <button class="switch" type="button" role="switch" aria-checked="false" aria-label="Meest" data-demo-switch><span class="switch__knob"></span></button>
          </div>
        </li>
      </ul>
    </section>
    <span class="cursor" aria-hidden="true">
      <span class="cursor__ring"></span>
      <svg class="cursor__arrow" viewBox="0 0 20 24" fill="none"><path d="M2 1.5v17.2l4.6-4.1 3 6.9 3-1.3-3-6.8 6.3-.4L2 1.5Z" fill="#fff" stroke="#02282c" stroke-width="1.5" stroke-linejoin="round" /></svg>
    </span>
  </div>
  <p class="demo__hint">{hint}</p>
</div>

<script>
  /*
   * The card plays itself like a short screen recording: a cursor switches Ukrposhta on, ticks two methods off
   * and on again, then switches Ukrposhta off, and starts over. It runs only while it is on screen, and a tap
   * or a click anywhere on it hands control to the visitor. With reduced motion it never plays by itself.
   */
  document.querySelectorAll<HTMLElement>('.demo').forEach((demo) => {
    const stage = demo.querySelector<HTMLElement>('.demo__stage')!;
    const cursor = demo.querySelector<HTMLElement>('.cursor')!;
    const switches = demo.querySelectorAll<HTMLButtonElement>('[data-demo-switch]');
    const ukrposhta = demo.querySelector<HTMLButtonElement>('[data-carrier="ukrposhta"] [data-demo-switch]')!;
    const boxes = [...demo.querySelectorAll<HTMLInputElement>('.method__input')];

    const setSwitch = (toggle: HTMLButtonElement, on: boolean) => {
      toggle.setAttribute('aria-checked', String(on));
      const carrier = toggle.closest<HTMLElement>('.carrier');
      const panel = carrier?.querySelector<HTMLElement>('.carrier__panel');
      if (!carrier || !panel) return;
      carrier.dataset.open = String(on);
      // closed settings must not be reachable by keyboard
      panel.toggleAttribute('inert', !on);
    };

    switches.forEach((toggle) => {
      toggle.addEventListener('click', () => setSwitch(toggle, toggle.getAttribute('aria-checked') !== 'true'));
    });

    // ---------- the recording ----------
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let run = 0; // each play gets a number; a newer number (or 0) cancels the older one
    let visible = false;
    let handedOver = false;

    const wait = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

    const reset = () => {
      setSwitch(ukrposhta, false);
      boxes.forEach((box) => (box.checked = !box.disabled));
    };

    const moveTo = (target: Element, ms: number) => {
      const t = target.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      cursor.style.setProperty('--ms', `${ms}ms`);
      cursor.style.setProperty('--x', `${t.left - s.left + t.width / 2}px`);
      cursor.style.setProperty('--y', `${t.top - s.top + t.height / 2}px`);
    };

    const press = () => {
      cursor.classList.remove('is-click');
      void cursor.offsetWidth; // restart the animation
      cursor.classList.add('is-click');
    };

    const play = async () => {
      const id = ++run;
      const alive = () => id === run;
      const step = async (target: Element, travel: number, action: () => void, after: number) => {
        moveTo(target, travel);
        await wait(travel + 120);
        if (!alive()) return false;
        press();
        await wait(110);
        if (!alive()) return false;
        action();
        await wait(after);
        return alive();
      };

      while (alive()) {
        reset();
        // the cursor starts at the lower right, out of the way
        const s = stage.getBoundingClientRect();
        cursor.style.setProperty('--ms', '0ms');
        cursor.style.setProperty('--x', `${s.width * 0.82}px`);
        cursor.style.setProperty('--y', `${s.height * 0.72}px`);
        cursor.dataset.show = 'true';
        await wait(900);
        if (!alive()) return;

        const first = boxes[0];
        const second = boxes[1];
        const mark = (box: HTMLInputElement) => box.closest('.method')!.querySelector('.method__box')!;

        if (!(await step(ukrposhta, 900, () => setSwitch(ukrposhta, true), 900))) return;
        if (!(await step(mark(first), 700, () => first.click(), 450))) return;
        if (!(await step(mark(second), 450, () => second.click(), 700))) return;
        // and back again
        if (!(await step(mark(second), 300, () => second.click(), 450))) return;
        if (!(await step(mark(first), 450, () => first.click(), 800))) return;
        if (!(await step(ukrposhta, 800, () => setSwitch(ukrposhta, false), 900))) return;

        cursor.dataset.show = 'false';
        await wait(1800);
      }
    };

    const stop = () => {
      run++;
      cursor.dataset.show = 'false';
    };

    const sync = () => {
      if (calm.matches || handedOver) return;
      if (visible) play();
      else {
        stop();
        reset();
      }
    };

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.6 },
    ).observe(stage);

    // the visitor takes over: stop the recording and leave things as they are
    stage.addEventListener('pointerdown', () => {
      if (handedOver) return;
      handedOver = true;
      stop();
    });
    stage.addEventListener('keydown', () => {
      if (handedOver) return;
      handedOver = true;
      stop();
    });
  });
</script>

<style>
  .demo {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .demo__stage {
    position: relative;
    display: flex;
    font-family: var(--form-font);
    justify-content: center;
    padding: var(--space-42) var(--space-24);
    border-radius: var(--radius-card);
    background: var(--color-icon-bg);
  }

  /* The recorded pointer. JS sets --x / --y (its tip, inside the stage) and --ms (how long the trip takes). */
  .cursor {
    --x: 0px;
    --y: 0px;
    --ms: 0ms;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 0;
    height: 0;
    opacity: 0;
    transform: translate(var(--x), var(--y));
    transition:
      transform var(--ms) var(--ease-out),
      opacity 0.3s ease-out;
    pointer-events: none;
  }

  .cursor[data-show='true'] {
    opacity: 1;
  }

  .cursor__arrow {
    position: absolute;
    top: -2px;
    left: -2px;
    width: 22px;
    height: 26px;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.25));
    transform-origin: 2px 2px;
  }

  .cursor__ring {
    position: absolute;
    top: -14px;
    left: -14px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgb(2 40 44 / 0.18);
    opacity: 0;
  }

  .cursor.is-click .cursor__ring {
    animation: demo-click 0.45s ease-out;
  }

  .cursor.is-click .cursor__arrow {
    animation: demo-press 0.25s ease-out;
  }

  @keyframes demo-click {
    from {
      opacity: 1;
      transform: scale(0.4);
    }
    to {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  @keyframes demo-press {
    40% {
      transform: scale(0.85);
    }
  }

  .demo__hint {
    max-width: var(--case-measure);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }

  /* ---------- The card ---------- */

  .form {
    width: min(100%, var(--form-w));
    padding: var(--space-16) var(--space-24);
    border: 1px solid var(--form-card-line);
    border-radius: 4px;
    background: var(--form-card-bg);
    color: var(--form-title);
  }

  .form__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
  }

  .form__title {
    font-size: var(--fs-16);
    font-weight: var(--weight-medium);
    line-height: var(--lh-ui);
    color: var(--form-title);
  }

  .form__badge {
    padding: var(--space-4) var(--space-8);
    border-radius: 4px;
    background: var(--olx-cyan);
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-ui);
    color: var(--form-title);
  }

  .form__desc {
    margin-top: var(--space-8);
    font-size: var(--fs-12);
    line-height: 1.2;
    color: var(--form-muted);
  }

  .form__desc strong {
    font-weight: var(--weight-bold);
  }

  .form__link {
    text-decoration: underline;
  }

  .carriers {
    margin-top: var(--space-12);
  }

  /* ---------- A carrier ---------- */

  .carrier + .carrier {
    border-top: 1px solid var(--form-divider);
  }

  .carrier__row {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    min-height: var(--form-row-h);
  }

  .carrier__row :global(.carrier__logo) {
    flex: none;
    width: var(--space-20);
    height: var(--space-20);
  }

  .carrier__name {
    flex: 1;
    font-size: var(--fs-16);
    line-height: var(--lh-ui);
    color: var(--olx-ink);
  }

  /* The switch: off is an outline with a small dark knob, on is filled with a white knob on the right */
  .switch {
    position: relative;
    flex: none;
    width: 40px;
    height: var(--space-24);
    padding: 0;
    border: 1px solid var(--form-title);
    border-radius: var(--radius-pill);
    background: var(--form-card-bg);
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out);
  }

  .switch__knob {
    position: absolute;
    top: 50%;
    left: 5px;
    width: var(--space-12);
    height: var(--space-12);
    margin-top: -6px;
    border-radius: 50%;
    background: var(--form-title);
    transition:
      transform 0.3s var(--ease-out),
      background-color 0.25s var(--ease-out),
      width 0.3s var(--ease-out),
      height 0.3s var(--ease-out),
      margin-top 0.3s var(--ease-out);
  }

  .switch[aria-checked='true'] {
    background: var(--form-title);
  }

  .switch[aria-checked='true'] .switch__knob {
    width: var(--space-16);
    height: var(--space-16);
    margin-top: -8px;
    background: var(--color-white);
    transform: translateX(15px);
  }

  .switch:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  /* ---------- The settings that open ---------- */

  /* Height eases between 0 and its content (the 0fr to 1fr grid trick), then the content fades in a beat later. */
  .carrier__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease-out);
  }

  .carrier[data-open='true'] .carrier__panel {
    grid-template-rows: 1fr;
  }

  .carrier__clip {
    min-height: 0;
    overflow: hidden;
  }

  .settings {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--space-8) 0 var(--space-12);
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }

  .carrier[data-open='true'] .settings {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.35s ease-out 0.12s,
      transform 0.45s var(--ease-out) 0.12s;
  }

  .settings__price {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .settings__label {
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--form-muted);
  }

  .field {
    position: relative;
  }

  .field__input {
    display: block;
    width: 100%;
    height: 48px;
    padding: 0 56px 0 var(--space-16);
    border: 1px solid var(--form-field-line);
    border-radius: 4px;
    background: var(--color-white);
    font: inherit;
    font-size: var(--fs-16);
    color: var(--form-title);
    appearance: textfield;
  }

  .field__input::-webkit-outer-spin-button,
  .field__input::-webkit-inner-spin-button {
    margin: 0;
    appearance: none;
  }

  .field__input::placeholder {
    color: var(--form-disabled);
  }

  .field__input:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .field__unit {
    position: absolute;
    top: 50%;
    right: var(--space-16);
    transform: translateY(-50%);
    font-size: var(--fs-16);
    color: var(--form-muted);
    pointer-events: none;
  }

  .settings__note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    font-size: var(--fs-12);
    line-height: 1.5;
    color: var(--form-muted);
  }

  .settings__note :global(.settings__info) {
    flex: none;
    width: var(--space-16);
    height: var(--space-16);
  }

  .methods {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .methods__label {
    margin-bottom: var(--space-12);
    padding: 0;
    font-size: var(--fs-16);
    line-height: var(--lh-ui);
    color: var(--form-disabled);
  }

  .method {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--fs-16);
    line-height: var(--lh-ui);
    color: var(--form-title);
    cursor: pointer;
  }

  .method--off {
    color: var(--form-disabled);
    cursor: default;
  }

  .method__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .method__box {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--space-18);
    height: var(--space-18);
    margin: 3px;
    border: 1px solid var(--form-card-line);
    border-radius: 2px;
    background: transparent;
    color: var(--color-white);
    transition: background-color 0.15s ease-out, border-color 0.15s ease-out;
  }

  .method__box :global(svg) {
    width: 14px;
    height: 14px;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.15s ease-out,
      transform 0.2s var(--ease-out);
  }

  .method__input:checked + .method__box {
    border-color: var(--form-title);
    background: var(--form-title);
  }

  .method__input:checked + .method__box :global(svg) {
    opacity: 1;
    transform: none;
  }

  .method__input:focus-visible + .method__box {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    .switch,
    .switch__knob,
    .carrier__panel,
    .settings,
    .carrier[data-open='true'] .settings,
    .method__box,
    .method__box :global(svg) {
      transition: none;
    }

    .cursor {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .demo__stage {
      padding: var(--space-24) var(--space-12);
    }
  }
</style>

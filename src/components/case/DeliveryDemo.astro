---
// The mockups set this card in Inter.
import '@fontsource-variable/inter/index.css';
import UkrposhtaLogo from '../../assets/icons/carrier-ukrposhta.svg';
import NovaPostLogo from '../../assets/icons/carrier-novapost.svg';
import MeestLogo from '../../assets/icons/carrier-meest.svg';
import InfoIcon from '../../assets/icons/info.svg';

interface Props {
  title: string;
  badge: string;
  hint: string;
  priceLabel: string;
  priceNote: string;
  methodsLabel: string;
  methods: readonly { label: string; checked: boolean; disabled?: boolean }[];
}

const { title, badge, hint, priceLabel, priceNote, methodsLabel, methods } = Astro.props;

// Every carrier has the same settings. Only the order of the rows and the logos differ.
const carriers = [
  { id: 'ukrposhta', name: 'Ukrposhta', Logo: UkrposhtaLogo },
  { id: 'novapost', name: 'Nova Post', Logo: NovaPostLogo },
  { id: 'meest', name: 'Meest', Logo: MeestLogo },
];
---

<!--
  A working copy of the seller's "Offer free delivery" card. Switching Ukrposhta on opens its settings
  (the second state in the design); switching it off closes them. The other two carriers only flip their switch.
-->
<div class="demo">
  <div class="demo__stage">
    <section class="form" aria-labelledby="form-title">
      <header class="form__head">
        <h4 id="form-title" class="form__title">{title}</h4>
        <p class="form__badge">{badge}</p>
      </header>
      <p class="form__desc">
        The delivery cost will be <strong>deducted from your payout</strong> after the buyer receives the order. If the buyer rejects it, <strong>OLX covers the return cost.</strong>{' '}<span class="form__link">How does this work?</span>
      </p>

      <ul class="carriers">
        {carriers.map(({ id, name, Logo }) => (
          <li class="carrier" data-carrier={id} data-open="false">
            <div class="carrier__row">
              <Logo class="carrier__logo" aria-hidden="true" />
              <p class="carrier__name">{name}</p>
              <button class="switch" type="button" role="switch" aria-checked="false" aria-label={name} aria-controls={`${id}-settings`} data-demo-switch>
                <span class="switch__knob" />
              </button>
            </div>
            <div class="carrier__panel" id={`${id}-settings`} inert>
              <div class="carrier__clip">
                <div class="settings">
                  <div class="settings__price">
                    <label class="settings__label" for={`${id}-price`}>{priceLabel}</label>
                    <div class="field">
                      <input class="field__input" id={`${id}-price`} type="number" inputmode="numeric" min="0" placeholder="0" aria-describedby={`${id}-price-note`} />
                      <span class="field__unit" aria-hidden="true">uah</span>
                    </div>
                    <p class="settings__note" id={`${id}-price-note`}>
                      <InfoIcon class="settings__info" aria-hidden="true" />
                      <span>{priceNote}</span>
                    </p>
                  </div>
                  <fieldset class="methods">
                    <legend class="methods__label">{methodsLabel}</legend>
                    {methods.map((method) => (
                      <label class:list={['method', { 'method--off': method.disabled }]}>
                        <input class="method__input" type="checkbox" checked={method.checked} disabled={method.disabled} />
                        <span class="method__box" aria-hidden="true">
                          <svg viewBox="0 0 14 14" fill="none">
                            <path d="M2.5 7.4 5.6 10.4 11.5 3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </span>
                        <span class="method__text">{method.label}</span>
                      </label>
                    ))}
                  </fieldset>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>
    <span class="cursor" aria-hidden="true">
      <span class="cursor__ring"></span>
      <svg class="cursor__arrow" viewBox="0 0 20 24" fill="none"><path d="M2 1.5v17.2l4.6-4.1 3 6.9 3-1.3-3-6.8 6.3-.4L2 1.5Z" fill="#fff" stroke="#02282c" stroke-width="1.5" stroke-linejoin="round" /></svg>
    </span>
  </div>
  <p class="demo__hint">{hint}</p>
</div>

<script>
  /*
   * The card plays itself like a short screen recording. For Ukrposhta, then for Nova Post, a cursor switches
   * the carrier on, types 1000 into the minimum price and ticks the delivery methods; then it starts over.
   * It runs only while it is on screen, and a tap or a click on it hands control to the visitor. With reduced
   * motion it never plays by itself.
   */
  document.querySelectorAll<HTMLElement>('.demo').forEach((demo) => {
    const stage = demo.querySelector<HTMLElement>('.demo__stage')!;
    const cursor = demo.querySelector<HTMLElement>('.cursor')!;
    const carriers = [...demo.querySelectorAll<HTMLElement>('.carrier')];

    const toggleOf = (carrier: HTMLElement) => carrier.querySelector<HTMLButtonElement>('[data-demo-switch]')!;

    // Opening or closing the settings of one carrier; opening one closes the others (an accordion).
    const setOpen = (carrier: HTMLElement, open: boolean) => {
      carrier.dataset.open = String(open);
      carrier.querySelector('.carrier__panel')?.toggleAttribute('inert', !open);
    };
    const openOnly = (carrier: HTMLElement) => carriers.forEach((c) => setOpen(c, c === carrier));

    const setEnabled = (carrier: HTMLElement, on: boolean) => {
      toggleOf(carrier).setAttribute('aria-checked', String(on));
      if (on) openOnly(carrier);
      else setOpen(carrier, false);
    };

    carriers.forEach((carrier) => {
      toggleOf(carrier).addEventListener('click', (event) => {
        event.stopPropagation();
        setEnabled(carrier, toggleOf(carrier).getAttribute('aria-checked') !== 'true');
      });
      // a click on the row itself folds or unfolds the settings
      carrier.querySelector('.carrier__row')!.addEventListener('click', () => {
        if (carrier.dataset.open === 'true') setOpen(carrier, false);
        else openOnly(carrier);
      });
    });

    // ---------- the recording ----------
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let run = 0; // each play gets a number; a newer number (or 0) cancels the older one
    let visible = false;
    let handedOver = false;

    const wait = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

    const reset = () => {
      carriers.forEach((carrier) => {
        setEnabled(carrier, false);
        carrier.querySelector<HTMLInputElement>('.field__input')!.value = '';
        carrier.querySelectorAll<HTMLInputElement>('.method__input').forEach((box) => (box.checked = false));
        carrier.querySelector<HTMLInputElement>('.field__input')!.blur();
        carrier.querySelector('.field')!.classList.remove('is-typing');
      });
    };

    // The pointer's tip goes to a spot inside the target (by default its middle, but never further than 40px in).
    const moveTo = (target: Element, ms: number, at?: { x: number; y: number }) => {
      const t = target.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      const x = at ? t.width * at.x : Math.min(t.width / 2, 40);
      const y = at ? t.height * at.y : t.height / 2;
      cursor.style.setProperty('--ms', `${ms}ms`);
      cursor.style.setProperty('--x', `${t.left - s.left + x}px`);
      cursor.style.setProperty('--y', `${t.top - s.top + y}px`);
    };

    const press = () => {
      cursor.classList.remove('is-click');
      void cursor.offsetWidth; // restart the animation
      cursor.classList.add('is-click');
    };

    const play = async () => {
      const id = ++run;
      const alive = () => id === run;

      // go to something, click it, run what the click does, then rest a moment
      const click = async (target: Element, travel: number, action: () => void, after: number) => {
        moveTo(target, travel);
        await wait(travel + 120);
        if (!alive()) return false;
        press();
        await wait(110);
        if (!alive()) return false;
        action();
        await wait(after);
        return alive();
      };

      const type = async (input: HTMLInputElement, text: string) => {
        for (const char of text) {
          input.value += char;
          await wait(170);
          if (!alive()) return false;
        }
        return true;
      };

      // one carrier: switch on, a minimum price, three methods
      const fill = async (carrier: HTMLElement) => {
        const field = carrier.querySelector<HTMLElement>('.field')!;
        const input = carrier.querySelector<HTMLInputElement>('.field__input')!;
        const boxes = [...carrier.querySelectorAll<HTMLInputElement>('.method__input')].slice(0, 3); // the first three methods
        if (!(await click(toggleOf(carrier), 900, () => setEnabled(carrier, true), 900))) return false;
        if (!(await click(field, 650, () => {
          input.focus({ preventScroll: true });
          field.classList.add('is-typing'); // the same look as :focus, for when the window itself is not focused
        }, 150))) return false;
        // the pointer steps aside, so it does not sit on top of what is being typed
        moveTo(field, 450, { x: 0.78, y: 1.45 });
        await wait(500);
        if (!alive()) return false;
        if (!(await type(input, '1000'))) return false;
        await wait(250);
        input.blur();
        field.classList.remove('is-typing');
        await wait(350);
        for (const box of boxes) {
          const mark = box.closest('.method')!.querySelector('.method__box')!;
          if (!(await click(mark, 500, () => box.click(), 280))) return false;
        }
        await wait(500);
        return alive();
      };

      while (alive()) {
        reset();
        const s = stage.getBoundingClientRect();
        // the cursor starts at the lower right, out of the way
        cursor.style.setProperty('--ms', '0ms');
        cursor.style.setProperty('--x', `${s.width * 0.82}px`);
        cursor.style.setProperty('--y', `${s.height * 0.7}px`);
        cursor.dataset.show = 'true';
        await wait(900);
        if (!alive()) return;

        if (!(await fill(carriers[0]))) return;
        if (!(await fill(carriers[1]))) return;

        cursor.dataset.show = 'false';
        await wait(2200);
        if (!alive()) return;
        // fold everything back before the next round
        carriers.forEach((carrier) => setEnabled(carrier, false));
        await wait(900);
      }
    };

    const stop = () => {
      run++;
      cursor.dataset.show = 'false';
    };

    const sync = () => {
      if (calm.matches || handedOver) return;
      if (visible) play();
      else {
        stop();
        reset();
      }
    };

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.35 },
    ).observe(stage);

    // the visitor takes over: stop the recording and leave things as they are
    const handOver = () => {
      if (handedOver) return;
      handedOver = true;
      stop();
    };
    stage.addEventListener('pointerdown', handOver);
    stage.addEventListener('keydown', handOver);
  });
</script>

<style>
  .demo {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .demo__stage {
    position: relative;
    display: flex;
    font-family: var(--form-font);
    justify-content: center;
    padding: var(--space-42) var(--space-24);
    border-radius: var(--radius-card);
    background: var(--color-icon-bg);
  }

  /* The recorded pointer. JS sets --x / --y (its tip, inside the stage) and --ms (how long the trip takes). */
  .cursor {
    --x: 0px;
    --y: 0px;
    --ms: 0ms;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 0;
    height: 0;
    opacity: 0;
    transform: translate(var(--x), var(--y));
    transition:
      transform var(--ms) var(--ease-out),
      opacity 0.3s ease-out;
    pointer-events: none;
  }

  .cursor[data-show='true'] {
    opacity: 1;
  }

  .cursor__arrow {
    position: absolute;
    top: -2px;
    left: -2px;
    width: 22px;
    height: 26px;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.25));
    transform-origin: 2px 2px;
  }

  .cursor__ring {
    position: absolute;
    top: -14px;
    left: -14px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgb(2 40 44 / 0.18);
    opacity: 0;
  }

  .cursor.is-click .cursor__ring {
    animation: demo-click 0.45s ease-out;
  }

  .cursor.is-click .cursor__arrow {
    animation: demo-press 0.25s ease-out;
  }

  @keyframes demo-click {
    from {
      opacity: 1;
      transform: scale(0.4);
    }
    to {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  @keyframes demo-press {
    40% {
      transform: scale(0.85);
    }
  }

  .demo__hint {
    max-width: var(--case-measure);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }

  /* ---------- The card ---------- */

  .form {
    width: min(100%, var(--form-w));
    padding: var(--space-16) var(--space-24);
    border: 1px solid var(--form-card-line);
    border-radius: 4px;
    background: var(--form-card-bg);
    color: var(--form-title);
  }

  .form__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
  }

  .form__title {
    font-size: var(--fs-16);
    font-weight: var(--weight-bold);
    line-height: var(--form-lh-tight);
    color: var(--form-title);
  }

  .form__badge {
    display: flex;
    align-items: center;
    height: var(--form-badge-h);
    padding-inline: var(--space-8);
    border-radius: 4px;
    background: var(--olx-cyan);
    font-size: var(--fs-12);
    font-weight: var(--weight-medium);
    line-height: var(--lh-lead);
    color: var(--form-title);
  }

  .form__desc {
    margin-top: var(--space-8);
    font-size: var(--fs-12);
    line-height: var(--lh-lead);
    color: var(--form-muted);
  }

  .form__desc strong {
    font-weight: var(--weight-semibold);
  }

  .form__link {
    text-decoration: underline;
  }

  .carriers {
    margin-top: var(--space-12);
  }

  /* ---------- A carrier ---------- */

  .carrier + .carrier {
    border-top: 1px solid var(--form-divider);
  }

  .carrier__row {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    min-height: var(--form-row-h);
    cursor: pointer;
  }

  .carrier__row :global(.carrier__logo) {
    flex: none;
    width: var(--space-20);
    height: var(--space-20);
  }

  .carrier__name {
    flex: 1;
    font-size: var(--fs-16);
    line-height: var(--form-lh-ui);
    color: var(--olx-ink);
  }

  /* The switch: off is an outline with a small dark knob, on is filled with a white knob on the right */
  .switch {
    position: relative;
    flex: none;
    width: 40px;
    height: var(--space-24);
    padding: 0;
    border: 1px solid var(--form-title);
    border-radius: var(--radius-pill);
    background: var(--form-card-bg);
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out);
  }

  .switch__knob {
    position: absolute;
    top: 50%;
    left: 5px;
    width: var(--space-12);
    height: var(--space-12);
    margin-top: -6px;
    border-radius: 50%;
    background: var(--form-title);
    transition:
      transform 0.3s var(--ease-out),
      background-color 0.25s var(--ease-out),
      width 0.3s var(--ease-out),
      height 0.3s var(--ease-out),
      margin-top 0.3s var(--ease-out);
  }

  .switch[aria-checked='true'] {
    background: var(--form-title);
  }

  .switch[aria-checked='true'] .switch__knob {
    width: var(--space-16);
    height: var(--space-16);
    margin-top: -8px;
    background: var(--color-white);
    transform: translateX(15px);
  }

  .switch:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  /* ---------- The settings that open ---------- */

  /* Height eases between 0 and its content (the 0fr to 1fr grid trick), then the content fades in a beat later. */
  .carrier__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease-out);
  }

  .carrier[data-open='true'] .carrier__panel {
    grid-template-rows: 1fr;
  }

  .carrier__clip {
    min-height: 0;
    overflow: hidden;
  }

  .settings {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--space-8) 0;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }

  .carrier[data-open='true'] .settings {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.35s ease-out 0.12s,
      transform 0.45s var(--ease-out) 0.12s;
  }

  .settings__price {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .settings__label {
    font-size: var(--fs-14);
    line-height: var(--form-lh-label);
    color: var(--form-muted);
  }

  .field {
    position: relative;
  }

  .field__input {
    display: block;
    width: 100%;
    height: 48px;
    padding: 0 56px 0 var(--space-16);
    border: 1px solid var(--form-field-line);
    border-radius: 4px;
    background: var(--color-white);
    font: inherit;
    font-size: var(--fs-16);
    color: var(--form-title);
    appearance: textfield;
  }

  .field__input::-webkit-outer-spin-button,
  .field__input::-webkit-inner-spin-button {
    margin: 0;
    appearance: none;
  }

  .field__input::placeholder {
    color: var(--form-disabled);
  }

  /* Focus: a dark border with a soft halo, and the caret in the same ink. The recording uses the real focus too. */
  .field__input {
    caret-color: var(--form-title);
    transition:
      border-color 0.2s ease-out,
      box-shadow 0.2s ease-out;
  }

  .field__input:focus,
  .field.is-typing .field__input {
    outline: none;
    border-color: var(--form-title);
    box-shadow: 0 0 0 3px var(--form-focus-halo);
  }

  .field__unit {
    position: absolute;
    top: 50%;
    right: var(--space-16);
    transform: translateY(-50%);
    font-size: var(--fs-16);
    color: var(--form-muted);
    pointer-events: none;
  }

  .settings__note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    font-size: var(--fs-12);
    line-height: 1.5;
    color: var(--form-muted);
  }

  .settings__note :global(.settings__info) {
    flex: none;
    width: var(--space-16);
    height: var(--space-16);
  }

  .methods {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .methods__label {
    margin-bottom: var(--space-12);
    padding: 0;
    font-size: var(--fs-14);
    line-height: var(--form-lh-label);
    color: var(--form-muted);
  }

  .method {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--fs-16);
    line-height: var(--form-lh-ui);
    color: var(--form-title);
    cursor: pointer;
  }

  .method--off {
    color: var(--form-disabled);
    cursor: default;
  }

  .method__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .method__box {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--space-18);
    height: var(--space-18);
    margin: 3px;
    border: 1px solid var(--form-title);
    border-radius: 2px;
    background: transparent;
    color: var(--color-white);
    transition: background-color 0.15s ease-out, border-color 0.15s ease-out;
  }

  .method__box :global(svg) {
    width: 14px;
    height: 14px;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.15s ease-out,
      transform 0.2s var(--ease-out);
  }

  .method__input:checked + .method__box {
    border-color: var(--form-title);
    background: var(--form-title);
  }

  .method__input:checked + .method__box :global(svg) {
    opacity: 1;
    transform: none;
  }

  .method__input:focus-visible + .method__box {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    .switch,
    .switch__knob,
    .carrier__panel,
    .settings,
    .carrier[data-open='true'] .settings,
    .method__box,
    .method__box :global(svg),
    .field__input {
      transition: none;
    }

    .cursor {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .demo__stage {
      padding: var(--space-24) var(--space-12);
    }
  }
</style>

---
import { Image } from 'astro:assets';

/*
 * A phone that plays a flow by itself: a finger taps through the screens and "types" into fields.
 * Coordinates are in the design's own pixels (390 x 844) and become shares of the phone.
 * The flow is a list of steps per screen: move, tap, type, wait.
 */
export type Step =
  | { move: [number, number] }
  | { tap: [number, number] }
  | { type: string; text: string }
  | { count: string; from: [number, number, number]; secs: number }
  | { scroll: number }
  | { wait: number };

interface Screen {
  /** One picture, or several stacked one above the other for a long screen */
  src: ImageMetadata | readonly ImageMetadata[];
  /** A screen taller than the phone: it scrolls inside it */
  tall?: boolean;
  alt: string;
  fields?: readonly { id: string; box: readonly [number, number, number, number]; multiline?: boolean; timer?: boolean }[];
}
interface Props {
  screens: readonly Screen[];
  tour: readonly (readonly Step[])[];
  /** Where the finger starts, in design pixels */
  start?: [number, number];
  /** A bar fixed to the bottom of the phone while the screens scroll behind it (358 x 89 in the design) */
  dock?: ImageMetadata;
}

const { screens, tour, start = [260, 330], dock } = Astro.props;

const W = 390;
const H = 844;
const x = (v: number) => `${(v / W) * 100}%`;
const y = (v: number) => `${(v / H) * 100}%`;
---


<figure class="onb" data-onboarding data-tour={JSON.stringify(tour)} data-start={JSON.stringify(start)}>
  <div class="onb__phone">
    {screens.map((screen, i) => (
      <div class:list={['onb__screen', { 'is-on': i === 0 }]} data-screen={i}>
        <div class:list={['onb__page', { 'onb__page--tall': screen.tall }]} data-page>
          {(Array.isArray(screen.src) ? screen.src : [screen.src]).map((src) => (
            <Image src={src} alt={i === 0 || !screen.tall ? screen.alt : ''} widths={[280, 390, 546]} sizes="280px" quality={85} loading={i === 0 ? 'eager' : 'lazy'} />
          ))}
        </div>
        {screen.fields?.map((field) => (
          <span class:list={['onb__type', { 'onb__type--multiline': field.multiline, 'onb__type--timer': field.timer }]} data-type={field.id} style={`left:${x(field.box[0])};top:${y(field.box[1])};width:${x(field.box[2])};height:${y(field.box[3])}`}></span>
        ))}
      </div>
    ))}
    {dock && <Image class="onb__dock" src={dock} alt="" widths={[280, 560]} sizes="260px" quality={90} />}
    <span class="onb__finger" data-finger aria-hidden="true"><span class="onb__ripple"></span></span>
  </div>
  <ol class="onb__dots" aria-hidden="true">
    {screens.map((_, i) => <li class:list={['onb__dot', { 'is-on': i === 0 }]}></li>)}
  </ol>
</figure>

<style>
  .onb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
    margin: 0;
  }

  .onb__phone {
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: 390 / 844;
    overflow: hidden;
    border-radius: 32px;
    background: var(--color-white);
    box-shadow: 0 var(--space-16) var(--space-32) rgb(44 47 51 / 0.12);
  }

  .onb__screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .onb__screen.is-on {
    opacity: 1;
  }

  .onb__page {
    width: 100%;
    height: 100%;
    will-change: transform;
  }

  .onb__screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .onb__phone :global(.onb__dock) {
    position: absolute;
    left: calc(16 / 390 * 100%);
    bottom: 0;
    width: calc(358 / 390 * 100%);
    height: auto;
    pointer-events: none;
  }

  .onb__page--tall {
    height: auto;
  }

  .onb__page--tall :global(img) {
    height: auto;
    object-fit: fill;
  }

  /* What the finger "types" covers the field's placeholder */
  .onb__type {
    position: absolute;
    display: flex;
    align-items: center;
    padding-left: calc(19 / 390 * 100cqw);
    border-radius: calc(10 / 390 * 100cqw);
    background: var(--color-white);
    font-family: Inter, system-ui, sans-serif;
    font-size: calc(16 / 390 * 100cqw);
    color: var(--sleep-ink);
    opacity: 0;
    white-space: nowrap;
  }

  /* A running clock drawn over the one in the picture, in the same dark plate */
  .onb__type--timer {
    justify-content: center;
    padding-left: 0;
    border-radius: 0;
    background: var(--sleep-ink);
    font-size: calc(34 / 390 * 100cqw);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-white);
  }

  .onb__type--multiline {
    align-items: flex-start;
    padding-top: calc(10 / 390 * 100cqw);
  }

  .onb__type.is-on {
    opacity: 1;
  }

  .onb__finger {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(34 / 390 * 100cqw);
    height: calc(34 / 390 * 100cqw);
    margin: calc(-17 / 390 * 100cqw) 0 0 calc(-17 / 390 * 100cqw);
    border: 2px solid var(--color-white);
    border-radius: 50%;
    background: rgb(44 47 51 / 0.35);
    box-shadow: 0 2px 8px rgb(44 47 51 / 0.3);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(50cqw, 120cqw, 0);
    transition: transform 0.55s cubic-bezier(0.45, 0, 0.25, 1), opacity 0.3s ease;
  }

  .onb__finger.is-on {
    opacity: 1;
  }

  .onb__finger.is-down {
    scale: 0.85;
  }

  .onb__ripple {
    position: absolute;
    inset: calc(-2px);
    border: 2px solid var(--sleep-accent);
    border-radius: 50%;
    opacity: 0;
  }

  .onb__finger.is-tap .onb__ripple {
    animation: onb-ripple 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  @keyframes onb-ripple {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  .onb__dots {
    display: flex;
    gap: var(--space-8);
  }

  .onb__dot {
    width: var(--space-8);
    height: var(--space-8);
    border-radius: 50%;
    background: var(--case-line);
    transition: background-color 0.3s ease, width 0.3s ease;
  }

  .onb__dot.is-on {
    width: var(--space-24);
    border-radius: var(--radius-pill);
    background: var(--case-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .onb__screen,
    .onb__finger,
    .onb__dot {
      transition: none;
    }
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const W = 390;
  const H = 844;

  type Step =
    | { move: [number, number] }
    | { tap: [number, number] }
    | { type: string; text: string }
    | { count: string; from: [number, number, number]; secs: number }
    | { scroll: number }
    | { wait: number };

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  document.querySelectorAll<HTMLElement>('[data-onboarding]').forEach((root) => {
    if (calm.matches || !('IntersectionObserver' in window)) return;

    const tour: Step[][] = JSON.parse(root.dataset.tour ?? '[]');
    const start: [number, number] = JSON.parse(root.dataset.start ?? '[260,330]');
    const phone = root.querySelector<HTMLElement>('.onb__phone')!;
    const finger = root.querySelector<HTMLElement>('[data-finger]')!;
    const screens = [...root.querySelectorAll<HTMLElement>('.onb__screen')];
    const dots = [...root.querySelectorAll<HTMLElement>('.onb__dot')];
    const typed = [...root.querySelectorAll<HTMLElement>('[data-type]')];
    let run = 0;

    const pages = [...root.querySelectorAll<HTMLElement>('[data-page]')];

    const scrollTo = async (page: HTMLElement, to: number) => {
      const w = phone.clientWidth;
      const from = Number(page.dataset.at ?? 0);
      const ms = Math.max(500, Math.abs(to - from) * 1.5);
      page.dataset.at = String(to);
      page.style.transition = `transform ${ms}ms cubic-bezier(0.45, 0, 0.25, 1)`;
      page.style.transform = `translate3d(0, ${-(to / W) * w}px, 0)`;
      await sleep(ms);
    };

    const show = (i: number) => {
      pages.forEach((page, n) => {
        if (n === i) {
          page.style.transition = 'none';
          page.style.transform = 'translate3d(0, 0, 0)';
          page.dataset.at = '0';
        }
      });
      screens.forEach((s, n) => s.classList.toggle('is-on', n === i));
      dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
    };

    const place = ([px, py]: [number, number]) => {
      const w = phone.clientWidth;
      finger.style.transform = `translate3d(${(px / W) * w}px, ${(py / H) * (w * H / W)}px, 0)`;
    };

    const tap = async (at: [number, number]) => {
      place(at);
      await sleep(600);
      finger.classList.add('is-down');
      await sleep(120);
      finger.classList.remove('is-down');
      finger.classList.remove('is-tap');
      void finger.offsetWidth;
      finger.classList.add('is-tap');
      await sleep(260);
    };

    const play = async (id: number) => {
      const alive = () => id === run;
      while (alive()) {
        typed.forEach((t) => {
          t.textContent = '';
          t.classList.remove('is-on');
        });
        show(0);
        finger.classList.remove('is-on');
        await sleep(500);
        for (let i = 0; i < tour.length && alive(); i += 1) {
          show(i);
          if (i === 0) {
            finger.style.transition = 'none';
            place(start);
            void finger.offsetWidth;
            finger.style.transition = '';
          }
          finger.classList.add('is-on');
          await sleep(i === 0 ? 250 : 450);
          for (const step of tour[i]) {
            if (!alive()) return;
            if ('move' in step) {
              place(step.move);
              await sleep(600);
            } else if ('tap' in step) {
              await tap(step.tap);
            } else if ('wait' in step) {
              await sleep(step.wait);
            } else if ('scroll' in step) {
              await scrollTo(pages[i], step.scroll);
            } else if ('count' in step) {
              // seconds tick on a clock: h:mm:ss
              const clock = root.querySelector<HTMLElement>(`[data-type="${step.count}"]`)!;
              clock.classList.add('is-on');
              let [h, m, sec] = step.from;
              for (let n = 0; n <= step.secs && alive(); n += 1) {
                clock.textContent = `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
                sec += 1;
                if (sec === 60) {
                  sec = 0;
                  m += 1;
                }
                if (m === 60) {
                  m = 0;
                  h += 1;
                }
                await sleep(1000);
              }
            } else {
              const field = root.querySelector<HTMLElement>(`[data-type="${step.type}"]`)!;
              field.classList.add('is-on');
              for (let c = 1; c <= step.text.length && alive(); c += 1) {
                field.textContent = step.text.slice(0, c);
                await sleep(45);
              }
              await sleep(200);
            }
          }
          await sleep(150);
        }
        await sleep(1000);
      }
    };

    const seen = new IntersectionObserver(
      ([entry]) => {
        run += 1;
        if (entry.isIntersecting) play(run);
      },
      { threshold: 0.5 },
    );
    seen.observe(root);
  });
</script>

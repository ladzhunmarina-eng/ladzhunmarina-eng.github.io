---
import { Image } from 'astro:assets';

/*
 * A phone that plays a flow by itself: a finger taps through the screens and "types" into fields.
 * Coordinates are in the design's own pixels (390 x 844 for a phone, 198 x 242 for a watch) and become shares of the device.
 * The flow is a list of steps per screen: move, tap, type, wait.
 */
export type Step =
  | { move: [number, number] }
  | { tap: [number, number] }
  | { type: string; text: string }
  | { count: string; from: [number, number, number]; secs: number; compact?: boolean; format?: 'ms' }
  | { scroll: number; show?: number }
  | { pop: string; for: number }
  /** a pop that stays until it is closed (a drop-down open while an option is picked) */
  | { open: string }
  | { close: string }
  /** a field takes a value at once, as when it is picked from a drop-down rather than typed */
  | { fill: string; text: string }
  | { wait: number };

interface Field {
  id: string;
  box: readonly [number, number, number, number];
  multiline?: boolean;
  timer?: boolean;
  fontSize?: number;
  /** no plate behind the text, for a field that is already empty */
  bare?: boolean;
  /** the text's inset from the box's left edge, in design pixels (19 by default) */
  pad?: number;
}
interface Screen {
  /** One picture, or several stacked one above the other for a long screen */
  src: ImageMetadata | readonly ImageMetadata[];
  /** A screen taller than the phone: it scrolls inside it */
  tall?: boolean;
  /** The top of this screen stays fixed while it scrolls: a picture and the height in design pixels to keep */
  head?: { src: ImageMetadata; height: number };
  /** A picture the size of the screen, see-through where the page shows, laid over it and not scrolling (a desktop app's top bar and side menu) */
  frame?: ImageMetadata;
  /**
   * Small pictures laid over the screen in design pixels, in order. One with `spin` turns round and round, a turn every
   * `spin` milliseconds, anticlockwise when negative (a loader).
   */
  layers?: readonly { src: ImageMetadata; box: readonly [number, number, number, number]; spin?: number }[];
  /** A panel over the screen that scrolls by itself (a filters drop-down): its picture and the window it shows through, in design pixels */
  sheet?: {
    src: ImageMetadata;
    box: readonly [number, number, number, number];
    /** the top of the panel that stays put while the rest scrolls, in design pixels */
    head?: number;
    /** the bottom of the panel that stays put (its actions), in design pixels */
    foot?: number;
    /** the window's corner radius, in design pixels */
    radius?: number;
    /** fields inside the panel, which scroll with it: boxes in design pixels from the panel picture's top left, at the size it is shown */
    fields?: readonly Field[];
    /** pops inside the panel (its drop-downs), which scroll with it: boxes as for its fields */
    pops?: readonly { id: string; src: ImageMetadata; box: readonly [number, number, number, number] }[];
  };
  /** Small pictures that pop in for a moment (a "Copied!" tag): where they sit, in design pixels */
  pops?: readonly {
    id: string;
    src: ImageMetadata;
    box: readonly [number, number, number, number];
    alt?: string;
    /** the point it grows from, in design pixels inside its picture (a button it carries in its pressed state stays put) */
    origin?: readonly [number, number];
  }[];
  alt: string;
  fields?: readonly Field[];
}
interface Props {
  screens: readonly Screen[];
  tour: readonly (readonly Step[])[];
  /** Where the finger starts, in design pixels */
  start?: [number, number];
  /** A bar fixed to the bottom of the phone while the screens scroll behind it (358 x 89 in the design) */
  dock?: ImageMetadata;
  /** A picture of the screen whose top 92px stay fixed above the scrolling screens (the status bar and title) */
  head?: ImageMetadata;
  /** The screen's size in design pixels */
  size?: [number, number];
  /** 'plain' has no frame at all, for a screen that sits inside a mockup picture; 'window' is a desktop screen in a rounded card */
  variant?: 'phone' | 'watch' | 'plain' | 'window';
  /** The step dots under the device */
  dots?: boolean;
}

const { screens, tour, start = [260, 330], dock, head, size = [390, 844], variant = 'phone', dots = true } = Astro.props;

const [W, H] = size;
// The pictures' sizes: a phone is shown about 280px wide, a desktop window across the content column
const wide = variant === 'window';
const shot = wide ? { widths: [720, 1008, 1512, 2016], sizes: '(max-width: 1023px) 100vw, 1008px' } : { widths: [280, 390, 546], sizes: '280px' };
// A typed field's class and place; its box as shares of what it sits in (the screen, or a scrolling panel's picture)
const fieldClass = (field: Field) => ['onb__type', { 'onb__type--multiline': field.multiline, 'onb__type--timer': field.timer, 'onb__type--bare': field.bare }];
const fieldStyle = (field: Field, w: number, h: number) =>
  `left:${(field.box[0] / w) * 100}%;top:${(field.box[1] / h) * 100}%;width:${(field.box[2] / w) * 100}%;height:${(field.box[3] / h) * 100}%` +
  (field.fontSize ? `;font-size:calc(${field.fontSize} / var(--w) * 100cqw)` : '') +
  (field.pad !== undefined ? `;padding-left:calc(${field.pad} / var(--w) * 100cqw)` : '');
// a scrolling panel's picture height, in design pixels, at the width it is shown
const sheetHeight = (sheet: NonNullable<Screen['sheet']>) => (sheet.box[2] * sheet.src.height) / sheet.src.width;
const popShot = wide ? { widths: [182, 364], sizes: '128px' } : { widths: [96, 192, 288], sizes: '96px' };
const x = (v: number) => `${(v / W) * 100}%`;
const y = (v: number) => `${(v / H) * 100}%`;
---


<figure class="onb" data-onboarding data-tour={JSON.stringify(tour)} data-start={JSON.stringify(start)} data-w={W} data-h={H} style={`--w: ${W}; --h: ${H}`}>
  <div class:list={['onb__phone', { 'onb__phone--watch': variant === 'watch', 'onb__phone--plain': variant === 'plain', 'onb__phone--window': variant === 'window' }]}>
    {screens.map((screen, i) => (
      <div class:list={['onb__screen', { 'is-on': i === 0 }]} data-screen={i}>
        <div class:list={['onb__page', { 'onb__page--tall': screen.tall }]} data-page>
          {(Array.isArray(screen.src) ? screen.src : [screen.src]).map((src) => (
            <Image src={src} alt={i === 0 || !screen.tall ? screen.alt : ''} widths={shot.widths} sizes={shot.sizes} quality={85} loading={i === 0 ? 'eager' : 'lazy'} />
          ))}
          <slot name={`page-${i}`} />
        </div>
        {screen.head && (
          <div class="onb__head onb__head--screen" aria-hidden="true" style={`height: calc(${screen.head.height} / var(--w) * 100cqw)`}>
            <Image src={screen.head.src} alt="" widths={[280, 560]} sizes="280px" quality={90} />
          </div>
        )}
        {screen.frame && <Image class="onb__frame" src={screen.frame} alt="" widths={shot.widths} sizes={shot.sizes} quality={85} loading="lazy" />}
        {screen.layers?.map((layer) => (
          <Image
            class:list={['onb__layer', { 'onb__layer--spin': layer.spin }]}
            src={layer.src}
            alt=""
            widths={[Math.round(layer.box[2]), Math.round(layer.box[2] * 2)]}
            sizes={wide ? `${Math.round((layer.box[2] / W) * 1008)}px` : `${Math.round((layer.box[2] / W) * 280)}px`}
            quality={90}
            style={`left:${x(layer.box[0])};top:${y(layer.box[1])};width:${x(layer.box[2])}${layer.spin ? `;--spin:${Math.abs(layer.spin)}ms;--spin-dir:${layer.spin < 0 ? 'reverse' : 'normal'}` : ''}`}
          />
        ))}
        {screen.sheet && (
          <div class="onb__sheet" aria-hidden="true" style={`left:${x(screen.sheet.box[0])};top:${y(screen.sheet.box[1])};width:${x(screen.sheet.box[2])};height:${y(screen.sheet.box[3])}${screen.sheet.radius ? `;border-radius:calc(${screen.sheet.radius} / var(--w) * 100cqw)` : ''}`}>
            <div class="onb__sheet-page" data-sheet>
              <Image src={screen.sheet.src} alt="" widths={[Math.round(screen.sheet.box[2]), Math.round(screen.sheet.box[2] * 2)]} sizes={wide ? `${Math.round((screen.sheet.box[2] / W) * 1008)}px` : '280px'} quality={85} loading="lazy" />
              {screen.sheet.fields?.map((field) => (
                <span class:list={fieldClass(field)} data-type={field.id} style={fieldStyle(field, screen.sheet!.box[2], sheetHeight(screen.sheet!))}></span>
              ))}
              {screen.sheet.pops?.map((pop) => {
                const [pw, ph] = [screen.sheet!.box[2], sheetHeight(screen.sheet!)];
                return (
                  <Image class="onb__pop onb__pop--down" src={pop.src} alt="" data-pop={pop.id} widths={[Math.round(pop.box[2]), Math.round(pop.box[2] * 2)]} sizes={wide ? `${Math.round((pop.box[2] / W) * 1008)}px` : '200px'} quality={90} style={`left:${(pop.box[0] / pw) * 100}%;top:${(pop.box[1] / ph) * 100}%;width:${(pop.box[2] / pw) * 100}%`} />
                );
              })}
            </div>
            {screen.sheet.head && (
              <div class="onb__sheet-head" style={`height:${((screen.sheet.head / screen.sheet.box[3]) * 100).toFixed(3)}%`}>
                <Image src={screen.sheet.src} alt="" widths={[Math.round(screen.sheet.box[2]), Math.round(screen.sheet.box[2] * 2)]} sizes={wide ? `${Math.round((screen.sheet.box[2] / W) * 1008)}px` : '280px'} quality={85} loading="lazy" />
              </div>
            )}
            {screen.sheet.foot && (
              <div class="onb__sheet-foot" style={`height:${((screen.sheet.foot / screen.sheet.box[3]) * 100).toFixed(3)}%`}>
                <Image src={screen.sheet.src} alt="" widths={[Math.round(screen.sheet.box[2]), Math.round(screen.sheet.box[2] * 2)]} sizes={wide ? `${Math.round((screen.sheet.box[2] / W) * 1008)}px` : '280px'} quality={85} loading="lazy" />
              </div>
            )}
          </div>
        )}
        {screen.pops?.map((pop) => (
          <Image class="onb__pop" src={pop.src} alt={pop.alt ?? ''} data-pop={pop.id} widths={popShot.widths} sizes={popShot.sizes} quality={90} style={`left:${x(pop.box[0])};top:${y(pop.box[1])};width:${x(pop.box[2])}${pop.origin ? `;transform-origin:${(pop.origin[0] / pop.box[2]) * 100}% ${(pop.origin[1] / pop.box[3]) * 100}%` : ''}`} />
        ))}
        <slot name={`screen-${i}`} />
        {screen.fields?.map((field) => (
          <span class:list={fieldClass(field)} data-type={field.id} style={fieldStyle(field, W, H)}></span>
        ))}
      </div>
    ))}
    {head && (
      <div class="onb__head" aria-hidden="true">
        <Image src={head} alt="" widths={[280, 560]} sizes="280px" quality={90} />
      </div>
    )}
    {dock && <Image class="onb__dock" src={dock} alt="" widths={[280, 560]} sizes="260px" quality={90} />}
    <span class="onb__finger" data-finger aria-hidden="true"><span class="onb__ripple"></span></span>
  </div>
  {dots && (
    <ol class="onb__dots" aria-hidden="true">
      {screens.map((_, i) => <li class:list={['onb__dot', { 'is-on': i === 0 }]}></li>)}
    </ol>
  )}
</figure>

<style>
  .onb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
    margin: 0;
  }

  .onb__phone {
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: var(--w) / var(--h);
    overflow: hidden;
    border-radius: 32px;
    background: var(--color-white);
  }

  /* A watch: a black glass with a ring around it */
  .onb__phone--watch {
    --finger: 18;
    --timer-bg: #000;
    border-radius: 22% / 18%;
    background: #000;
    box-shadow: 0 0 0 6px #25282c, 0 0 0 7px #4a4e55;
  }

  .onb__phone--plain {
    --finger: 18;
    --timer-bg: #000;
    border-radius: 0;
    background: #000;
    box-shadow: none;
  }

  /* A desktop screen: the shared card radius and a hairline, and a smaller finger for the wide design (1440 across) */
  .onb__phone--window {
    --finger: 26;
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
  }

  /*
   * The next screen fades in on top of the one before, which stays fully shown until it is covered and only then
   * goes: fading both at once would let the background show through halfway, a flash on every click.
   */
  .onb__screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0s linear 0.35s;
  }

  .onb__screen.is-on {
    z-index: 1;
    opacity: 1;
    transition: opacity 0.35s ease;
  }

  /* the status bar, the dock and the finger stay over every screen */
  .onb__phone > .onb__head,
  .onb__phone > :global(.onb__dock),
  .onb__finger {
    z-index: 2;
  }

  .onb__page {
    position: relative; /* what a page slot lays over its picture scrolls with it */
    width: 100%;
    height: 100%;
    will-change: transform;
  }

  .onb__screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* The top of the screen stays put: the picture's own top 92px of 390 wide, over a white plate.
     The height is set outright, not by aspect-ratio: Safari lets the picture inside stretch an aspect-ratio box to its
     full height, which laid the whole screenshot over the phone. */
  .onb__head {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(92 / var(--w) * 100cqw);
    overflow: hidden;
    background: var(--color-white);
    pointer-events: none;
  }

  .onb__head :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .onb__phone :global(.onb__dock) {
    position: absolute;
    left: calc(16 / var(--w) * 100%);
    bottom: 0;
    width: calc(358 / var(--w) * 100%);
    height: auto;
    pointer-events: none;
  }

  .onb__page--tall {
    height: auto;
  }

  /* The panel's window: its picture is taller than the window and scrolls inside it, the screen below stays */
  .onb__sheet {
    position: absolute;
    overflow: hidden;
  }

  .onb__sheet-page {
    position: relative; /* its fields are placed on its picture */
    will-change: transform;
  }

  /* The panel's header: the top of the same picture, laid over the scrolling part and not moving */
  .onb__sheet-head {
    position: absolute;
    inset: 0 0 auto 0;
    overflow: hidden;
  }

  /* The panel's actions: the bottom of the same picture, pinned to the bottom of the window, with a hairline over what scrolls under it */
  .onb__sheet-foot {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }

  .onb__sheet-foot :global(img) {
    flex-shrink: 0;
  }

  .onb__screen .onb__sheet :global(img) {
    height: auto;
    object-fit: fill;
  }

  .onb__page--tall :global(img) {
    height: auto;
    object-fit: fill;
  }

  /* What the finger "types" covers the field's placeholder */
  .onb__type {
    position: absolute;
    display: flex;
    align-items: center;
    padding-left: calc(19 / var(--w) * 100cqw);
    border-radius: calc(10 / var(--w) * 100cqw);
    background: var(--color-white);
    font-family: Inter, system-ui, sans-serif;
    font-size: calc(16 / var(--w) * 100cqw);
    color: var(--sleep-ink);
    opacity: 0;
    white-space: nowrap;
  }

  /* A running clock drawn over the one in the picture, in the same dark plate */
  /* A tag that pops in, stays a moment, and fades */
  .onb__screen :global(.onb__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .onb__screen :global(.onb__layer) {
    position: absolute;
    height: auto;
    pointer-events: none;
  }

  .onb__screen :global(.onb__layer--spin) {
    animation: onb-spin var(--spin) linear infinite var(--spin-dir);
  }

  @keyframes onb-spin {
    to {
      rotate: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .onb__screen :global(.onb__layer--spin) {
      animation: none;
    }
  }

  .onb__screen :global(.onb__pop) {
    position: absolute;
    height: auto;
    opacity: 0;
    transform: translateY(4px) scale(0.9);
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
  }

  /* a drop-down unfolds from its top edge, without the shrink */
  .onb__screen :global(.onb__pop--down) {
    transform: translateY(-6px);
    transform-origin: top;
  }

  .onb__screen :global(.onb__pop.is-on) {
    opacity: 1;
    transform: none;
  }

  .onb__type--timer {
    justify-content: center;
    padding-left: 0;
    border-radius: 0;
    background: var(--timer-bg, var(--sleep-ink));
    font-size: calc(34 / var(--w) * 100cqw);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-white);
  }

  .onb__type :global(.onb__sec) {
    margin-left: 0.12em;
    font-size: 0.5em;
    font-weight: 500;
    opacity: 0.7;
  }

  .onb__type--bare {
    background: none;
  }

  .onb__type--multiline {
    align-items: flex-start;
    padding-top: calc(10 / var(--w) * 100cqw);
  }

  .onb__type.is-on {
    opacity: 1;
  }

  .onb__finger {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--finger, 34) / var(--w) * 100cqw);
    height: calc(var(--finger, 34) / var(--w) * 100cqw);
    margin: calc(var(--finger, 34) / -2 / var(--w) * 100cqw) 0 0 calc(var(--finger, 34) / -2 / var(--w) * 100cqw);
    border: 2px solid var(--color-white);
    border-radius: 50%;
    background: rgb(44 47 51 / 0.35);
    box-shadow: 0 2px 8px rgb(44 47 51 / 0.3);
    opacity: 0;
    pointer-events: none;
    /* Placed with `translate`, not `transform`: the press's `scale` applies before `transform` and would shrink the
       finger's offset as well, so every tap jerked it towards the top left corner and back */
    translate: 50cqw 120cqw;
    transition: translate 0.55s cubic-bezier(0.45, 0, 0.25, 1), opacity 0.3s ease, scale 0.12s ease-out;
  }

  .onb__finger.is-on {
    opacity: 1;
  }

  .onb__finger.is-down {
    scale: 0.85;
  }

  .onb__ripple {
    position: absolute;
    inset: calc(-2px);
    border: 2px solid var(--sleep-accent);
    border-radius: 50%;
    opacity: 0;
  }

  .onb__finger.is-tap .onb__ripple {
    animation: onb-ripple 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  @keyframes onb-ripple {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  .onb__dots {
    display: flex;
    gap: var(--space-8);
  }

  .onb__dot {
    width: var(--space-8);
    height: var(--space-8);
    border-radius: 50%;
    background: var(--case-line);
    transition: background-color 0.3s ease, width 0.3s ease;
  }

  .onb__dot.is-on {
    width: var(--space-24);
    border-radius: var(--radius-pill);
    background: var(--case-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .onb__screen,
    .onb__finger,
    .onb__dot {
      transition: none;
    }
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  type Step =
    | { move: [number, number] }
    | { tap: [number, number] }
    | { type: string; text: string }
    | { count: string; from: [number, number, number]; secs: number; compact?: boolean; format?: 'ms' }
    | { scroll: number; show?: number }
    | { pop: string; for: number }
    | { open: string }
    | { close: string }
    | { fill: string; text: string }
    | { wait: number };

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  document.querySelectorAll<HTMLElement>('[data-onboarding]').forEach((root) => {
    if (calm.matches || !('IntersectionObserver' in window)) return;
    // One tour per phone: if the script runs again (a hot reload while editing), a second loop would fight the first
    // over the screens and the dots
    if (root.dataset.tourStarted === 'true') return;
    root.dataset.tourStarted = 'true';

    const W = Number(root.dataset.w ?? 390);
    const H = Number(root.dataset.h ?? 844);
    const tour: Step[][] = JSON.parse(root.dataset.tour ?? '[]');
    const start: [number, number] = JSON.parse(root.dataset.start ?? '[260,330]');
    const phone = root.querySelector<HTMLElement>('.onb__phone')!;
    const finger = root.querySelector<HTMLElement>('[data-finger]')!;
    const screens = [...root.querySelectorAll<HTMLElement>('.onb__screen')];
    const dots = [...root.querySelectorAll<HTMLElement>('.onb__dot')];
    const typed = [...root.querySelectorAll<HTMLElement>('[data-type]')];
    let run = 0;

    const pages = [...root.querySelectorAll<HTMLElement>('[data-page]')];

    const scrollTo = async (page: HTMLElement, to: number, showNext?: number) => {
      const w = phone.clientWidth;
      const from = Number(page.dataset.at ?? 0);
      const ms = Math.max(500, Math.abs(to - from) * 1.5);
      page.dataset.at = String(to);
      page.style.transition = `transform ${ms}ms cubic-bezier(0.45, 0, 0.25, 1)`;
      page.style.transform = `translate3d(0, ${-(to / W) * w}px, 0)`;
      // the next screen takes over while the scroll is still running, so two screens read as one that scrolls
      if (showNext !== undefined) setTimeout(() => show(showNext), ms * 0.6);
      await sleep(ms);
    };

    const show = (i: number) => {
      [pages[i], screens[i]?.querySelector<HTMLElement>('[data-sheet]')].forEach((page) => {
        if (!page) return;
        page.style.transition = 'none';
        page.style.transform = 'translate3d(0, 0, 0)';
        page.dataset.at = '0';
      });
      screens.forEach((s, n) => s.classList.toggle('is-on', n === i));
      dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
    };

    const place = ([px, py]: [number, number]) => {
      const w = phone.clientWidth;
      finger.style.translate = `${(px / W) * w}px ${(py / H) * (w * H / W)}px`;
    };

    const tap = async (at: [number, number]) => {
      place(at);
      await sleep(600);
      finger.classList.add('is-down');
      await sleep(120);
      finger.classList.remove('is-down');
      finger.classList.remove('is-tap');
      void finger.offsetWidth;
      finger.classList.add('is-tap');
      await sleep(260);
    };

    const play = async (id: number) => {
      const alive = () => id === run;
      while (alive()) {
        typed.forEach((t) => {
          t.textContent = '';
          t.classList.remove('is-on');
        });
        root.querySelectorAll('[data-pop]').forEach((p) => p.classList.remove('is-on'));
        show(0);
        finger.classList.remove('is-on');
        await sleep(500);
        for (let i = 0; i < tour.length && alive(); i += 1) {
          show(i);
          if (i === 0) {
            finger.style.transition = 'none';
            place(start);
            void finger.offsetWidth;
            finger.style.transition = '';
          }
          finger.classList.add('is-on');
          await sleep(i === 0 ? 250 : 450);
          for (const [k, step] of tour[i].entries()) {
            if (!alive()) return;
            if ('move' in step) {
              // A move that only leads up to a tap is a detour: the finger would stop there and set off again, often
              // back the way it came. It waits in place instead and then goes straight to the tap.
              const ahead = tour[i].slice(k + 1).find((s) => !('wait' in s));
              if (!(ahead && 'tap' in ahead)) place(step.move);
              await sleep(600);
            } else if ('tap' in step) {
              await tap(step.tap);
            } else if ('wait' in step) {
              await sleep(step.wait);
            } else if ('pop' in step) {
              const tag = root.querySelector<HTMLElement>(`[data-pop="${step.pop}"]`)!;
              tag.classList.add('is-on');
              await sleep(step.for);
              tag.classList.remove('is-on');
              await sleep(250);
            } else if ('open' in step) {
              root.querySelector<HTMLElement>(`[data-pop="${step.open}"]`)!.classList.add('is-on');
              await sleep(300);
            } else if ('close' in step) {
              root.querySelector<HTMLElement>(`[data-pop="${step.close}"]`)!.classList.remove('is-on');
              await sleep(150);
            } else if ('fill' in step) {
              const field = root.querySelector<HTMLElement>(`[data-type="${step.fill}"]`)!;
              field.textContent = step.text;
              field.classList.add('is-on');
              await sleep(250);
            } else if ('scroll' in step) {
              // a screen with a panel scrolls the panel, otherwise the screen itself
              await scrollTo(screens[i].querySelector<HTMLElement>('[data-sheet]') ?? pages[i], step.scroll, step.show);
            } else if ('count' in step) {
              // seconds tick on a clock: h:mm:ss
              const clock = root.querySelector<HTMLElement>(`[data-type="${step.count}"]`)!;
              clock.classList.add('is-on');
              let [h, m, sec] = step.from;
              for (let n = 0; n <= step.secs && alive(); n += 1) {
                const mm = String(m).padStart(2, '0');
                const ss = String(sec).padStart(2, '0');
                // compact: the clock keeps its h:mm and the seconds run small beside it
                if (step.format === 'ms') clock.textContent = `${mm}:${ss}`;
                else if (step.compact) clock.innerHTML = `${h}:${mm}<span class="onb__sec">:${ss}</span>`;
                else clock.textContent = `${h}:${mm}:${ss}`;
                sec += 1;
                if (sec === 60) {
                  sec = 0;
                  m += 1;
                }
                if (m === 60) {
                  m = 0;
                  h += 1;
                }
                await sleep(1000);
              }
            } else {
              const field = root.querySelector<HTMLElement>(`[data-type="${step.type}"]`)!;
              field.classList.add('is-on');
              for (let c = 1; c <= step.text.length && alive(); c += 1) {
                field.textContent = step.text.slice(0, c);
                await sleep(45);
              }
              await sleep(200);
            }
          }
          await sleep(150);
        }
        await sleep(1000);
      }
    };

    const seen = new IntersectionObserver(
      ([entry]) => {
        run += 1;
        if (entry.isIntersecting) play(run);
      },
      { threshold: 0.5 },
    );
    seen.observe(root);
  });
</script>

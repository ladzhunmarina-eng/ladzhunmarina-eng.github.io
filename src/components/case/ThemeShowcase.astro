---
import ThemePhone from './ThemePhone.astro';

/*
 * The light and dark theme: both phones edge to edge (their illustrations animated), with the thesis beside them.
 */
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lead: string;
  alts: { light: string; dark: string };
}

const { id, eyebrow, title, lead, alts } = Astro.props;
---

<section class="theme-block" id={id} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="theme-block__stage">
    <div class="theme-block__phone"><ThemePhone theme="light" side="left" alt={alts.light} /></div>
    <div class="theme-block__phone"><ThemePhone theme="dark" side="right" alt={alts.dark} /></div>
  </div>

  <div class="theme-block__side">
  <div class="theme-block__copy">
    <p class="theme-block__eyebrow">{eyebrow}</p>
    <h2 class="theme-block__title" id={id ? `${id}-title` : undefined}>{title}</h2>
    <p class="theme-block__lead">{lead}</p>
  </div>

  </div>
</section>

<style>
  /* On the page itself, no panel: the words on the left, the two phones edge to edge on the right. */
  .theme-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-32);
    align-items: center;
    scroll-margin-top: calc(var(--header-h) + var(--space-24));
  }

  .theme-block__stage {
    display: flex;
    gap: var(--space-12);
    order: 2;
  }

  .theme-block__phone {
    width: min(260px, 22vw);
  }

  .theme-block__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    min-width: 0;
  }

  .theme-block__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .theme-block__eyebrow {
    font-size: var(--fs-12);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .theme-block__title {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--fs-case-h2);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
    color: var(--color-ink);
  }

  .theme-block__lead {
    max-width: var(--case-measure);
    font-size: var(--fs-18);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  @media (max-width: 1023px) {
    .theme-block {
      grid-template-columns: minmax(0, 1fr);
    }

    .theme-block__stage {
      justify-content: center;
      order: 0;
    }

    .theme-block__phone {
      width: min(260px, 44vw);
    }
  }
</style>

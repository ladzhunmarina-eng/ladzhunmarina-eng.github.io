---
import ThemePhone from './ThemePhone.astro';

/*
 * The light and dark theme: a dark panel with both phones side by side (their illustrations animated), a thesis, and one card per theme.
 */
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lead: string;
  light: { title: string; text: string };
  dark: { title: string; text: string };
  alts: { light: string; dark: string };
}

const { id, eyebrow, title, lead, light, dark, alts } = Astro.props;
---

<section class="theme-block" id={id} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="theme-block__stage">
    <div class="theme-block__phone"><ThemePhone theme="light" side="left" alt={alts.light} /></div>
    <div class="theme-block__phone"><ThemePhone theme="dark" side="right" alt={alts.dark} /></div>
  </div>

  <div class="theme-block__side">
  <div class="theme-block__copy">
    <p class="theme-block__eyebrow">{eyebrow}</p>
    <h2 class="theme-block__title" id={id ? `${id}-title` : undefined}>{title}</h2>
    <p class="theme-block__lead">{lead}</p>
  </div>

  <ul class="theme-block__cards">
    <li class="theme-card theme-card--light">
      <span class="theme-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" />
        </svg>
      </span>
      <h3>{light.title}</h3>
      <p>{light.text}</p>
    </li>
    <li class="theme-card theme-card--dark">
      <span class="theme-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" />
        </svg>
      </span>
      <h3>{dark.title}</h3>
      <p>{dark.text}</p>
    </li>
  </ul>
  </div>
</section>

<style>
  /* On the page itself, no panel: the two phones stand edge to edge on the left, the words and the two cards on the right. */
  .theme-block {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-32);
    align-items: start;
    scroll-margin-top: calc(var(--header-h) + var(--space-24));
  }

  .theme-block__stage {
    display: flex;
    gap: var(--space-12);
  }

  .theme-block__phone {
    width: min(260px, 22vw);
  }

  .theme-block__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    min-width: 0;
  }

  .theme-block__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .theme-block__eyebrow {
    font-size: var(--fs-12);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .theme-block__title {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--fs-case-h2);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
    color: var(--color-ink);
  }

  .theme-block__lead {
    max-width: var(--case-measure);
    font-size: var(--fs-18);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  .theme-block__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .theme-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--case-card-pad);
    border-radius: var(--radius-card);
  }

  .theme-card--light {
    background: var(--color-white);
    color: var(--sleep-ink);
  }

  .theme-card--dark {
    background: #262a31;
    border: 1px solid rgb(255 255 255 / 0.1);
    color: var(--color-white);
  }

  .theme-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-44);
    height: var(--space-44);
    border-radius: var(--radius-person);
  }

  .theme-card--light .theme-card__icon {
    background: var(--sleep-pill-blue);
    color: var(--sleep-accent-text);
  }

  .theme-card--dark .theme-card__icon {
    background: rgb(255 255 255 / 0.08);
    color: var(--sleep-accent);
  }

  .theme-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
  }

  .theme-card p {
    font-size: var(--fs-16);
    line-height: var(--lh-body);
  }

  .theme-card--light p {
    color: var(--sleep-muted);
  }

  .theme-card--dark p {
    color: rgb(255 255 255 / 0.65);
  }

  @media (max-width: 1023px) {
    .theme-block {
      grid-template-columns: minmax(0, 1fr);
    }

    .theme-block__stage {
      justify-content: center;
    }

    .theme-block__phone {
      width: min(260px, 44vw);
    }
  }
</style>

---
interface Props {
  phases: readonly { name: string; items: readonly string[] }[];
  tools: readonly string[];
}

const { phases, tools } = Astro.props;
---

<div class="process">
  <ol class="process__steps">
    {phases.map((phase, index) => (
      <li class="step">
        <p class="step__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
        <h3 class="step__name">{phase.name}</h3>
        <ul class="step__items">
          {phase.items.map((item) => <li>{item}</li>)}
        </ul>
      </li>
    ))}
  </ol>

  <div class="process__tools">
    <h3 class="process__tools-title">Tools</h3>
    <ul class="process__chips">
      {tools.map((tool) => <li class="process__chip">{tool}</li>)}
    </ul>
  </div>
</div>

<style>
  .process {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .process__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--case-card-min), 1fr));
    gap: var(--space-16);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--case-card-pad);
    border-top: 4px solid var(--case-bg);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    background: var(--color-white);
    box-shadow: 0 0 0 1px var(--case-line);
  }

  .step__number {
    font-family: var(--font-display);
    font-size: var(--fs-14);
    font-weight: var(--weight-bold);
    letter-spacing: var(--ls-eyebrow);
    color: var(--case-accent);
  }

  .step__name {
    font-family: var(--font-display);
    font-size: var(--fs-24);
    font-weight: var(--weight-bold);
    line-height: var(--lh-24);
    color: var(--color-ink);
  }

  .step__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
  }

  .step__items li::before {
    content: '·';
    margin-right: var(--space-8);
    color: var(--case-accent);
  }

  .process__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12) var(--space-16);
  }

  .process__tools-title {
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .process__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .process__chip {
    padding: var(--space-4) var(--space-14);
    border-radius: var(--radius-pill);
    background: var(--color-icon-bg);
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
    color: var(--color-ink-button);
  }
</style>

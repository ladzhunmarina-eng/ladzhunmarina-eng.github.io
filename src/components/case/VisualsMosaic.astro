---
import { Image } from 'astro:assets';

interface Shot {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  shots: {
    rosters: Shot;
    battery: Shot;
    upload: Shot;
    uploading: Shot;
    attachment: Shot;
    createEvent: Shot;
    summary: Shot;
    empty: Shot;
    owed: Shot;
  };
}

const { shots } = Astro.props;
---

<!-- A set of screens and states, laid out like a contact sheet. Pairs of columns hold stacks of tiles of similar total height. -->
<div class="mosaic">
  <figure class="tile"><Image src={shots.rosters.src} alt={shots.rosters.alt} widths={[720, 1080, 1440]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} /></figure>
  <figure class="tile"><Image src={shots.battery.src} alt={shots.battery.alt} widths={[720, 1080, 1440]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} /></figure>

  <div class="pair">
    <div class="stack">
      <figure class="tile"><Image src={shots.upload.src} alt={shots.upload.alt} widths={[480, 720, 1080]} sizes="(max-width: 1023px) 100vw, 496px" quality={85} /></figure>
      <figure class="tile"><Image src={shots.uploading.src} alt={shots.uploading.alt} widths={[480, 720, 1080]} sizes="(max-width: 1023px) 100vw, 496px" quality={85} /></figure>
      <figure class="tile"><Image src={shots.attachment.src} alt={shots.attachment.alt} widths={[480, 720, 1080]} sizes="(max-width: 1023px) 100vw, 496px" quality={85} /></figure>
    </div>
    <div class="stack">
      <figure class="tile"><Image src={shots.createEvent.src} alt={shots.createEvent.alt} widths={[480, 720, 1080]} sizes="(max-width: 1023px) 100vw, 496px" quality={85} /></figure>
    </div>
  </div>

  <div class="pair">
    <div class="stack">
      <figure class="tile"><Image src={shots.summary.src} alt={shots.summary.alt} widths={[480, 720, 1080]} sizes="(max-width: 1023px) 100vw, 496px" quality={85} /></figure>
    </div>
    <div class="stack">
      <figure class="tile"><Image src={shots.empty.src} alt={shots.empty.alt} widths={[480, 720, 1080]} sizes="(max-width: 1023px) 100vw, 496px" quality={85} /></figure>
      <figure class="tile"><Image src={shots.owed.src} alt={shots.owed.alt} widths={[480, 720, 1080]} sizes="(max-width: 1023px) 100vw, 496px" quality={85} /></figure>
    </div>
  </div>
</div>

<style>
  .mosaic {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
    align-items: start;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .tile {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--case-line);
    border-radius: var(--radius-person);
    background: var(--color-white);
  }

  .tile :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 640px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

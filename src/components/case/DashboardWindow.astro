---
import { Image } from 'astro:assets';
import sidebar from '../../assets/images/dash/sidebar.png';
import profile from '../../assets/images/dash/profile.png';
import header from '../../assets/images/dash/header.png';
import tabs from '../../assets/images/dash/tabs-five.png';
import actions from '../../assets/images/dash/actions.png';
import search from '../../assets/images/dash/search.png';
import overview from '../../assets/images/dash/overview.png';
import timeline from '../../assets/images/dash/timeline.png';
import summary from '../../assets/images/dash/summary-blank.png';
import gaugeGreen from '../../assets/images/dash/gauge-green.png';
import gaugeRed from '../../assets/images/dash/gauge-red.png';
import gaugeGrey from '../../assets/images/dash/gauge-grey.png';
import barRed from '../../assets/images/dash/bar-red.png';
import barGreen from '../../assets/images/dash/bar-green.png';
import barOrange from '../../assets/images/dash/bar-orange.png';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import map from '../../assets/images/dash/map-blank.png';
import c1Arc0 from '../../assets/images/dash/map-c1-arc0.png';
import c1Arc1 from '../../assets/images/dash/map-c1-arc1.png';
import c2Arc0 from '../../assets/images/dash/map-c2-arc0.png';
import c2Arc1 from '../../assets/images/dash/map-c2-arc1.png';
import c3Arc0 from '../../assets/images/dash/map-c3-arc0.png';
import c3Arc1 from '../../assets/images/dash/map-c3-arc1.png';
import c4Arc0 from '../../assets/images/dash/map-c4-arc0.png';
import c4Arc1 from '../../assets/images/dash/map-c4-arc1.png';
import c5Arc0 from '../../assets/images/dash/map-c5-arc0.png';
import documents from '../../assets/images/dash/documents.png';
import LogoShield from './LogoShield.astro';

interface Part {
  title: string;
  text: string;
  /** Where in the page (design pixels, 1440 wide) this part starts: the window scrolls here when its button is pressed */
  at: number;
}

interface Props {
  /** The blocks of the page as buttons under the window; without them the window stands alone */
  parts?: readonly Part[];
  /** A short line over the bottom edge until the visitor first scrolls */
  hint?: string;
  /** Blur the product's logo in the corner */
  blurLogo?: boolean;
  /** The window is the first thing on the page: load it straight away */
  eager?: boolean;
  /** How much of the page the window shows at once, in design pixels (900 by default; 1025 is the height of the rosters screens) */
  viewHeight?: number;
  /** Show the buttons under the window (they are always kept for the scroll stops) */
  showParts?: boolean;
  /** While the window is on screen, the page scrolls itself from block to block, until the visitor scrolls it */
  autoScroll?: boolean;
}

const { parts = [], hint, blurLogo = false, eager = false, viewHeight = 900, showParts = true, autoScroll = false } = Astro.props;

// The page is drawn from the design's own groups, each placed where it sits on the 1440 x 2640 canvas (x, y, width in design pixels).
const W = 1440;
const PAGE_H = 2640; // the whole page, with a little room under the last block
const VIEW_H = viewHeight; // how much of it the window shows at a time
const HEADER_H = 139; // the bar that stays at the top
const stay = [
  { src: sidebar, x: 0, y: 0, w: 251 },
  { src: profile, x: 14, y: 652, w: 224 },
  { src: header, x: 251, y: 0, w: 1188 },
  { src: tabs, x: 277, y: 91, w: 649 },
  { src: actions, x: 645, y: 25, w: 334 },
  { src: search, x: 1003, y: 25, w: 413 },
];
const scrolls = [
  { src: overview, x: 275, y: 171, w: 1141 },
  { src: timeline, x: 276, y: 335, w: 1141 },
  { src: summary, x: 275, y: 528, w: 1141 },
  { src: map, x: 275, y: 1293, w: 1138 },
  { src: documents, x: 275, y: 1792, w: 1141 },
];
/*
 * The parts of the summary that come alive once the window is on screen and they are in view: the gauge fills round,
 * the timesheet bar grows, the numbers count up. The summary picture has them cleared; they sit here where the Figma
 * has them (page coordinates), the numbers set as in the design (Poppins 34px, 44px for the gauge's).
 */
const gauge = {
  box: { x: 464, y: 753.55, w: 217.72, h: 121.26 },
  centre: { x: 572.86, y: 862.4 }, // the circle the arcs belong to
  arcs: [
    { src: gaugeGreen, x: 464, y: 753.55, w: 158.2, h: 121.26 },
    { src: gaugeRed, x: 623.93, y: 779.87, w: 45.75, h: 52.42 },
    { src: gaugeGrey, x: 653.1, y: 832.49, w: 28.62, h: 41.45 },
  ],
};
const bar = {
  box: { x: 899, y: 1089, w: 493, h: 24 },
  parts: [
    { src: barRed, x: 899, w: 79 },
    { src: barGreen, x: 983, w: 294 },
    { src: barOrange, x: 1282, w: 110 },
  ],
};
// value, where the Figma's text box sits (x, y, width) and how it is aligned; the gauge's number is larger
const numbers = [
  { value: 150, x: 887, y: 621, w: 54, align: 'center' },
  { value: 50, x: 1159.6, y: 621, w: 43, align: 'center' },
  { value: 1200, x: 887, y: 754, w: 74, align: 'center' },
  { value: 120000, x: 1159.6, y: 754, w: 144, align: 'left', prefix: '$', commas: true },
  { value: 12000, x: 887, y: 885, w: 116, align: 'center', prefix: '$' },
  { value: 120, x: 902, y: 1031, w: 52, align: 'left' },
  { value: 40, x: 311, y: 1029, w: 45, align: 'left' },
  { value: 8, x: 587, y: 1029, w: 40, align: 'center' },
  { value: 20, x: 311, y: 1162, w: 42, align: 'center' },
  { value: 12, x: 587, y: 1162, w: 33, align: 'center' },
  { value: 40, x: 546, y: 817.2, w: 56, align: 'center', size: 44 },
] as const;
/*
 * The vehicles map: each cluster pops in (its glass and black disc), its ring draws round from the bottom left (the
 * green share, then the orange), its number counts up; the chips' numbers count too. The map picture has them cleared;
 * boxes are the Figma's render bounds (with the shadows), in page coordinates, and the disc's centre the ring turns on.
 * The glass is drawn as in the Figma, white at 10% blurring the map under it (its background blur) with a soft shadow,
 * so it is a live element rather than a picture: a picture of it would have nothing under it to blur.
 */
const mapClusters = [
  { glass: { x: 803, y: 1480, w: 64, h: 64, blur: 4 }, disc: { x: 811, y: 1488, w: 48, h: 48 }, box: { x: 799, y: 1480, w: 72, h: 72 }, centre: { x: 835, y: 1512 }, arcs: [{ src: c1Arc0, x: 809, y: 1486, w: 53, h: 45.23 }, { src: c1Arc1, x: 817.67, y: 1527.57, w: 36.52, h: 10.43 }], value: 45, text: { x: 826, y: 1503, w: 18, size: 14, weight: 400 } },
  { glass: { x: 996, y: 1496, w: 57, h: 57, blur: 4 }, disc: { x: 1003.1, y: 1503.1, w: 42.8, h: 42.8 }, box: { x: 992, y: 1496, w: 65, h: 65 }, centre: { x: 1024.5, y: 1524.5 }, arcs: [{ src: c2Arc0, x: 1003.04, y: 1503, w: 43.81, h: 37.41 }, { src: c2Arc1, x: 1010.21, y: 1536.88, w: 30.19, h: 9.12 }], value: 34, text: { x: 1015.5, y: 1515.5, w: 18, size: 14, weight: 400 } },
  { glass: { x: 954, y: 1637, w: 38, h: 38, blur: 2.67 }, disc: { x: 958.8, y: 1641.8, w: 28.5, h: 28.5 }, box: { x: 951.33, y: 1637, w: 43.33, h: 43.33 }, centre: { x: 973.05, y: 1656.05 }, arcs: [{ src: c3Arc0, x: 958.69, y: 1641.67, w: 29.21, h: 24.94 }, { src: c3Arc1, x: 963.47, y: 1664.25, w: 20.13, h: 6.08 }], value: 23, text: { x: 965.5, y: 1648, w: 15, size: 12, weight: 500 } },
  { glass: { x: 587, y: 1564, w: 86, h: 86, blur: 4.53 }, disc: { x: 597.8, y: 1574.8, w: 64.5, h: 64.5 }, box: { x: 582.47, y: 1564, w: 95.05, h: 95.05 }, centre: { x: 630.05, y: 1607.05 }, arcs: [{ src: c4Arc0, x: 596.74, y: 1574.74, w: 66.53, h: 55.96 }, { src: c4Arc1, x: 596.74, y: 1583.3, w: 66.53, h: 55.96 }], value: 56, text: { x: 621, y: 1598, w: 18, size: 14, weight: 400 } },
  { glass: { x: 594, y: 1418, w: 64, h: 64, blur: 4 }, disc: { x: 602, y: 1426, w: 48, h: 48 }, box: { x: 590, y: 1418, w: 72, h: 72 }, centre: { x: 626, y: 1450 }, arcs: [{ src: c5Arc0, x: 601, y: 1424, w: 51, h: 51 }], value: 45, text: { x: 617, y: 1441, w: 18, size: 14, weight: 400 } },
];
// the chips over the map: the label stays, the number counts (Poppins 14px on a 24px line)
const mapChips = [
  { label: 'In Total ', value: 23, x: 1066, y: 1364, w: 71 },
  { label: 'Available ', value: 10, x: 1169, y: 1364, w: 82 },
  { label: 'In use ', value: 13, x: 1302, y: 1364, w: 58 },
];

const show = (value: number, prefix = '', commas = false) => prefix + (commas ? value.toLocaleString('en-US') : String(value));
const at = (x: number, y: number, w: number, h: number) =>
  `left:${((x / W) * 100).toFixed(3)}%;top:${((y / PAGE_H) * 100).toFixed(3)}%;width:${((w / W) * 100).toFixed(3)}%;height:${((h / PAGE_H) * 100).toFixed(3)}%;`;
const within = (inner: { x: number; y: number; w: number; h: number }, outer: { x: number; y: number; w: number; h: number }) =>
  `left:${(((inner.x - outer.x) / outer.w) * 100).toFixed(3)}%;top:${(((inner.y - outer.y) / outer.h) * 100).toFixed(3)}%;width:${((inner.w / outer.w) * 100).toFixed(3)}%;height:${((inner.h / outer.h) * 100).toFixed(3)}%;`;

const pos = (item: { x: number; y: number; w: number }, height: number) =>
  `left:${((item.x / W) * 100).toFixed(3)}%;top:${((item.y / height) * 100).toFixed(3)}%;width:${((item.w / W) * 100).toFixed(3)}%;`;
---

<div class="dash" data-header={HEADER_H} data-width={W} data-parts={JSON.stringify(parts.map((part) => part.at))} data-auto={autoScroll ? '' : undefined}>
  <!-- The window: the sidebar and the top bar stay, the page scrolls under them -->
  <div class="dash__view" style={`--view-ratio: ${W} / ${VIEW_H}`}>
    <div class="dash__scroll" role="region" aria-label="The event dashboard. Scroll to see the whole page." tabindex="0">
      <div class="dash__page" style={`--page-ratio: ${W} / ${PAGE_H}`}>
        {scrolls.map((item) => (
          <Image class="dash__piece" src={item.src} alt="" style={pos(item, PAGE_H)} widths={[720, 1080, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} loading={eager ? 'eager' : 'lazy'} />
        ))}
        <div class="dash__live dash__gauge" data-live style={`${at(gauge.box.x, gauge.box.y, gauge.box.w, gauge.box.h)}--cx:${(((gauge.centre.x - gauge.box.x) / gauge.box.w) * 100).toFixed(2)}%;--cy:${(((gauge.centre.y - gauge.box.y) / gauge.box.h) * 100).toFixed(2)}%`} aria-hidden="true">
          {gauge.arcs.map((arc) => (
            <Image class="dash__part" src={arc.src} alt="" style={within({ x: arc.x, y: arc.y, w: arc.w, h: arc.h }, gauge.box)} widths={[Math.round(arc.w * 2)]} sizes={`${Math.round(arc.w * 0.7)}px`} quality={90} />
          ))}
        </div>
        <div class="dash__live dash__bar" data-live style={at(bar.box.x, bar.box.y, bar.box.w, bar.box.h)} aria-hidden="true">
          <div class="dash__bar-fill">
            {bar.parts.map((part) => (
              <Image class="dash__part" src={part.src} alt="" style={within({ x: part.x, y: bar.box.y, w: part.w, h: bar.box.h }, bar.box)} widths={[Math.round(part.w * 2)]} sizes={`${Math.round(part.w * 0.7)}px`} quality={90} />
            ))}
          </div>
        </div>
        {mapClusters.map((c, i) => (
          <div class="dash__live dash__cluster" data-live style={`${at(c.box.x, c.box.y, c.box.w, c.box.h)}--i:${i}`} aria-hidden="true">
            <div class="dash__cluster-pop">
              <span class="dash__glass" style={`${within(c.glass, c.box)}--blur:${c.glass.blur}`}></span>
              <span class="dash__disc" style={within(c.disc, c.box)}></span>
              <div class="dash__ring" style={`--cx:${(((c.centre.x - c.box.x) / c.box.w) * 100).toFixed(2)}%;--cy:${(((c.centre.y - c.box.y) / c.box.h) * 100).toFixed(2)}%`}>
                {c.arcs.map((a) => (
                  <Image class="dash__part" src={a.src} alt="" style={within({ x: a.x, y: a.y, w: a.w, h: a.h }, c.box)} widths={[Math.round(a.w * 2)]} sizes={`${Math.round(a.w * 0.7)}px`} quality={90} />
                ))}
              </div>
            </div>
          </div>
        ))}
        {mapClusters.map((c, i) => (
          <span class="dash__live dash__number dash__number--center dash__number--on-dark" data-live data-count={c.value} data-prefix="" style={`${at(c.text.x, c.text.y, c.text.w, c.text.size * 1.3)}--size:${c.text.size};--weight:${c.text.weight};--i:${i}`}>{c.value}</span>
        ))}
        {mapChips.map((chip) => (
          <span class="dash__live dash__number dash__number--chip" data-live data-count={chip.value} data-prefix={chip.label} style={`${at(chip.x, chip.y, chip.w, 24)}--size:14`}>{chip.label}{chip.value}</span>
        ))}
        {numbers.map((n) => (
          <span class:list={['dash__live', 'dash__number', `dash__number--${n.align}`]} data-live data-count={n.value} data-prefix={'prefix' in n ? n.prefix : ''} data-commas={'commas' in n ? '' : undefined} style={`${at(n.x, n.y, n.w, 44)}--size:${'size' in n ? n.size : 34}`}>{show(n.value, 'prefix' in n ? n.prefix : '', 'commas' in n)}</span>
        ))}
      </div>
    </div>
    {hint && <p class="dash__hint" aria-hidden="true">{hint}</p>}
    {blurLogo && <LogoShield left={3.19} top={(2.44 * 900) / VIEW_H} width={11.11} height={(6.44 * 900) / VIEW_H} />}
    <div class="dash__stay" aria-hidden="true">
      {stay.map((item) => (
        <Image class="dash__piece dash__piece--stay" src={item.src} alt="" style={pos(item, VIEW_H)} widths={[480, 960, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} loading="eager" />
      ))}
    </div>
  </div>

  {showParts && parts.length > 0 && (
    <ol class="dash__parts">
      {parts.map((part, index) => (
        <li>
          <button class="part" type="button" data-dash-go={index} aria-label={`Show ${part.title} in the dashboard`}>
            <span class="part__number" aria-hidden="true">{index + 1}</span>
            <span class="part__body">
              <span class="part__title">{part.title}</span>
              <span class="part__text">{part.text}</span>
            </span>
          </button>
        </li>
      ))}
    </ol>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.dash').forEach((dash) => {
    const scroller = dash.querySelector<HTMLElement>('.dash__scroll')!;
    const page = dash.querySelector<HTMLElement>('.dash__page')!;
    const buttons = [...dash.querySelectorAll<HTMLButtonElement>('[data-dash-go]')];
    const anchors: number[] = JSON.parse(dash.dataset.parts ?? '[]');
    const design = Number(dash.dataset.width);
    const header = Number(dash.dataset.header);
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

    // design pixels to screen pixels
    const scale = () => page.getBoundingClientRect().width / design;
    // a little air above the block a button asks for, under the fixed bar
    const target = (index: number) => Math.max(0, (anchors[index] - header - 16) * scale());

    // The button of the block at the top of the window is marked (and the one sharing its place); at the very end, the last one
    const sync = () => {
      const top = scroller.scrollTop / scale() + header + 24;
      const atEnd = scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 2;
      let current = 0;
      anchors.forEach((at, index) => {
        if (at <= top) current = index;
      });
      buttons.forEach((button, index) => {
        const near = anchors[index] === anchors[current] || (atEnd && index === anchors.length - 1);
        button.toggleAttribute('data-current', near);
        if (near) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        scroller.scrollTo({ top: target(index), behavior: calm.matches ? 'auto' : 'smooth' });
        scroller.focus({ preventScroll: true });
      });
    });
    // the hint goes with the first scroll
    scroller.addEventListener('scroll', () => dash.setAttribute('data-scrolled', ''), { passive: true, once: true });
    scroller.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();

    // The gauge, the timesheet bar and the numbers come alive when the window is on screen and they are in view in it,
    // and are reset once either is no longer true, so they play on every pass. Without this script, or with reduced
    // motion, they simply show their final state.
    if (!calm.matches && 'IntersectionObserver' in window) {
      dash.classList.add('dash--live');
      const lives = [...dash.querySelectorAll<HTMLElement>('[data-live]')];
      const inView = new Set<Element>();
      const frames = new Map<Element, number>();
      let onScreen = false;
      const write = (el: HTMLElement, value: number) => {
        const shown = el.hasAttribute('data-commas') ? Math.round(value).toLocaleString('en-US') : String(Math.round(value));
        el.textContent = (el.dataset.prefix ?? '') + shown;
      };
      const count = (el: HTMLElement) => {
        const to = Number(el.dataset.count);
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / 1400);
          write(el, to * (1 - Math.pow(1 - t, 3)));
          if (t < 1) frames.set(el, requestAnimationFrame(step));
        };
        cancelAnimationFrame(frames.get(el) ?? 0);
        frames.set(el, requestAnimationFrame(step));
      };
      const draw = () =>
        lives.forEach((el) => {
          const on = onScreen && inView.has(el);
          if (on === el.classList.contains('is-drawn')) return;
          el.classList.toggle('is-drawn', on);
          if (el.dataset.count === undefined) return;
          if (on) count(el);
          else {
            cancelAnimationFrame(frames.get(el) ?? 0);
            write(el, 0);
          }
        });
      lives.forEach((el) => el.dataset.count !== undefined && write(el, 0));
      const inWindow = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.intersectionRatio >= 0.6) inView.add(entry.target);
            else if (!entry.isIntersecting) inView.delete(entry.target);
          });
          draw();
        },
        { root: scroller, threshold: [0, 0.6] },
      );
      lives.forEach((el) => inWindow.observe(el));
      new IntersectionObserver(
        ([entry]) => {
          onScreen = entry.isIntersecting;
          draw();
        },
        { threshold: 0.4 },
      ).observe(dash);
    }

    // The page scrolls itself from block to block while the window is on screen, and stops for good as soon as the visitor touches it.
    if (dash.hasAttribute('data-auto') && !calm.matches && 'IntersectionObserver' in window) {
      // the top, then every block that is further down than the first screen shows (each place once)
      const stops = [0, ...new Set(anchors.filter((at) => at > header + 200))];
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      let timers: number[] = [];
      let frame = 0;
      let running = false;
      let handedOver = false;

      const glide = (to: number, ms: number) => {
        const from = scroller.scrollTop;
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / ms);
          scroller.scrollTop = from + (to - from) * ease(t);
          if (t < 1) frame = requestAnimationFrame(step);
        };
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(step);
      };
      const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
      const stop = () => {
        running = false;
        timers.forEach(window.clearTimeout);
        timers = [];
        cancelAnimationFrame(frame);
      };
      const tour = () => {
        if (!running || handedOver) return;
        let at = 0;
        stops.forEach((stopAt, i) => {
          if (i === 0) return;
          at += 1700;
          later(at, () => glide(Math.max(0, (stopAt - header - 16) * scale()), 1600));
          at += 1600;
        });
        at += 2600;
        later(at, () => glide(0, 1900));
        at += 3000;
        later(at, tour);
      };

      ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach((type) =>
        scroller.addEventListener(
          type,
          () => {
            handedOver = true;
            stop();
          },
          { passive: true },
        ),
      );
      new IntersectionObserver(
        ([entry]) => {
          if (handedOver) return;
          if (entry.isIntersecting && !running) {
            running = true;
            tour();
          } else if (!entry.isIntersecting && running) {
            stop();
            scroller.scrollTop = 0;
          }
        },
        { threshold: 0.6 },
      ).observe(dash);
    }
  });
</script>

<style>
  .dash {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .dash__view {
    position: relative;
    aspect-ratio: var(--view-ratio);
    overflow: hidden;
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .dash__scroll {
    position: absolute;
    inset: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .dash__scroll:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: calc(-1 * var(--focus-width));
  }

  .dash__page {
    position: relative;
    width: 100%;
    aspect-ratio: var(--page-ratio);
  }

  /* a pill over the bottom edge: scrolling is possible here */
  .dash__hint {
    position: absolute;
    bottom: var(--space-16);
    left: 50%;
    z-index: 2;
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--erma-ink);
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
    color: var(--color-white);
    transform: translateX(-50%);
    pointer-events: none;
    transition:
      opacity 0.3s ease-out,
      transform 0.4s var(--ease-out);
  }

  .dash[data-scrolled] .dash__hint {
    opacity: 0;
    transform: translate(-50%, var(--space-8));
  }

  .dash__stay {
    position: absolute;
    inset: 0;
    pointer-events: none; /* wheel and touch go through to the page underneath */
  }

  .dash__piece {
    position: absolute;

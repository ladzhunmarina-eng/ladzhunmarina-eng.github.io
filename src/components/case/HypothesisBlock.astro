---
interface Props {
  hypothesis: { if: string; because: string; then: string; guardrail?: string };
}

const { hypothesis } = Astro.props;
const parts = [
  { key: 'If', text: hypothesis.if },
  { key: 'Because', text: hypothesis.because },
  { key: 'Then', text: hypothesis.then },
];
---

<div class="hypothesis">
  <dl class="hypothesis__parts">
    {parts.map((part) => (
      <div class="hypothesis__part">
        <dt>{part.key}</dt>
        <dd>{part.text}</dd>
      </div>
    ))}
  </dl>
  {hypothesis.guardrail && (
    <p class="hypothesis__guardrail"><strong>Guardrail</strong> {hypothesis.guardrail}</p>
  )}
</div>

<style>
  .hypothesis {
    overflow: hidden;
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .hypothesis__parts {
    display: flex;
    flex-direction: column;
  }

  .hypothesis__part {
    display: grid;
    grid-template-columns: var(--case-label-w) minmax(0, 1fr);
    gap: var(--space-16);
    padding: var(--case-card-pad);
    border-bottom: 1px solid var(--case-line);
  }

  .hypothesis dt {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    font-weight: var(--weight-extrabold);
    color: var(--case-accent);
  }

  .hypothesis dd {
    margin: 0;
    font-size: var(--fs-18);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }

  .hypothesis__guardrail {
    padding: var(--space-16) var(--case-card-pad);
    background: var(--case-bg);
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--case-on-bg);
  }

  .hypothesis__guardrail strong {
    margin-right: var(--space-8);
    font-size: var(--fs-12);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .hypothesis__part {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
</style>

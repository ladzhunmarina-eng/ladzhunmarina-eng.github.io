---
import { Image } from 'astro:assets';
import Badges from '../../assets/icons/erma-badges.svg';

interface Props {
  /** The title in two lines; the middle words in the accent colour */
  lineOne: string;
  accent: string;
  lineTwoEnd: string;
  tags: readonly string[];
  image: ImageMetadata;
  imageAlt: string;
  about: string;
  meta: readonly { label: string; value: string }[];
}

const { lineOne, accent, lineTwoEnd, tags, image, imageAlt, about, meta } = Astro.props;
const title = `${lineOne} ${accent} ${lineTwoEnd}`;
---

<header class="top">
  <h1 class="top__title" aria-label={title}>
    <span class="top__line" aria-hidden="true">{lineOne}<Badges class="top__badges" /></span>
    <span class="top__line" aria-hidden="true"><span class="top__accent">{accent}</span> {lineTwoEnd}</span>
  </h1>

  <ul class="top__tags" aria-label="Platforms">
    {tags.map((tag) => <li class="top__tag">{tag}</li>)}
  </ul>

  <figure class="top__shot">
    <Image src={image} alt={imageAlt} widths={[720, 1080, 1440]} sizes="(max-width: 1023px) 100vw, 1218px" quality={85} loading="eager" />
  </figure>

  <section class="about" aria-label="About the project">
    <h2 class="about__label">About</h2>
    <div class="about__body">
      <p class="about__text">{about}</p>
      <dl class="about__meta">
        {meta.map((item) => (
          <div class="about__row">
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</header>

<style>
  .top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-24);
  }

  /* The title: two centred lines, the words in the middle in the accent colour, two round badges after the first line */
  .top__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-erma-title);
    font-weight: var(--weight-bold);
    line-height: 1.05;
    letter-spacing: var(--ls-display);
    text-align: center;
    color: var(--color-ink);
  }

  .top__line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 0.22em;
  }

  .top__accent {
    color: var(--erma-orange);
  }

  .top__title :global(.top__badges) {
    flex: none;
    width: 1.1em;
    height: auto;
    margin-left: 0.1em;
  }

  .top__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-12);
  }

  .top__tag {
    padding: var(--space-8) var(--space-20);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
    color: var(--color-ink);
  }

  /* The dashboard, fading into the page at the bottom */
  .top__shot {
    position: relative;
    width: 100%;
    max-width: var(--erma-shot-w);
    margin: var(--space-32) 0 0;
    mask-image: linear-gradient(to bottom, #000 62%, transparent);
  }

  .top__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  /* About: a label, then a big statement and a short table of facts */
  .about {
    display: grid;
    grid-template-columns: var(--erma-about-label-w) minmax(0, 1fr);
    gap: var(--space-32);
    width: 100%;
    margin-top: calc(-1 * var(--space-24));
  }

  .about__label {
    font-family: var(--font-display);
    font-size: var(--fs-24);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
    color: var(--color-ink);
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .about__text {
    font-size: var(--fs-erma-about);
    line-height: 1.3;
    letter-spacing: var(--ls-heading);
    color: var(--color-ink);
  }

  .about__meta {
    max-width: var(--erma-meta-w);
  }

  .about__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-16);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--case-line);
    font-size: var(--fs-16);
    line-height: var(--lh-snug);
  }

  .about__row:first-child {
    border-top: 1px solid var(--case-line);
  }

  .about__row dt {
    color: var(--color-muted);
  }

  .about__row dd {
    margin: 0;
    color: var(--color-ink);
  }

  @media (max-width: 1023px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-16);
      margin-top: calc(-1 * var(--space-16));
    }
  }
</style>

---
import { Image } from 'astro:assets';
import PhoneTour from './PhoneTour.astro';
import mockup from '../../assets/images/watch-mockup.png';
import type { Step } from './PhoneTour.astro';
import home from '../../assets/images/watch-1-home.png';
import children from '../../assets/images/watch-2-children.png';
import start from '../../assets/images/watch-3-start.png';
import time from '../../assets/images/watch-3b-time.png';
import stop from '../../assets/images/watch-4-stop-timer.png';
import stopped from '../../assets/images/watch-5-stopped.png';

/* The main function on the wrist, played by itself: open the app, pick the child, start the sleep, set the time, watch the clock, stop it. Coordinates are in the watch screen's own 198 x 242. */
interface Props {
  alt: string;
}

const { alt } = Astro.props;

const screens = [
  { src: home, alt },
  { src: children, alt: 'Select a child: Anna, awake since 8:06, and Teo, sleeping since 12:00.' },
  { src: start, alt: 'Anna, awake for 3:50, with a Start sleep button.' },
  { src: time, alt: 'Set the time: two wheels, 15 and 30, with a Save button.' },
  {
    src: stop,
    alt: 'Anna, sleeping since 12:00, with a Stop sleep button.',
    fields: [{ id: 'clock', box: [40, 104, 118, 36] as const, timer: true, fontSize: 26 }],
  },
  { src: stopped, alt: 'A green check and the word Stopped.' },
];

const tour = [
  [{ move: [150, 60] }, { wait: 300 }, { tap: [99, 128] }], // open the app
  [{ move: [100, 150] }, { wait: 300 }, { tap: [100, 67] }], // pick Anna
  [{ move: [99, 130] }, { wait: 400 }, { tap: [99, 198] }], // Start sleep
  [{ move: [145, 70] }, { wait: 300 }, { tap: [145, 111] }, { wait: 500 }, { move: [99, 170] }, { wait: 200 }, { tap: [99, 198] }], // set the time, Save
  [{ move: [99, 160] }, { wait: 300 }, { count: 'clock', from: [0, 0, 1], secs: 5, format: 'ms' }, { tap: [99, 198] }], // the clock runs, then Stop sleep
  [{ move: [99, 130] }, { wait: 1600 }], // Stopped
] satisfies Step[][];
---

<div class="mock">
  <Image class="mock__photo" src={mockup} alt="" widths={[380, 640]} sizes="380px" quality={85} />
  <div class="mock__screen">
    <div class="mock__tour">
      <PhoneTour screens={screens} tour={tour} start={[150, 180]} size={[198, 242]} variant="plain" dots={false} />
    </div>
  </div>
</div>

<style>
  /* The photo of the watch; the prototype plays inside its display (140,182 and 350 x 450 in the picture's 640 x 820). */
  .mock {
    position: relative;
    aspect-ratio: 640 / 820;
    overflow: hidden;
  }

  /* The picture's grey backdrop is brightened to white and multiplied onto the page, so only the watch and its soft shadow remain. */
  .mock :global(.mock__photo) {
    display: block;
    width: 100%;
    height: 100%;
    filter: brightness(1.14);
    mix-blend-mode: multiply;
    /* the shadow runs on past the crop: fade it out instead of cutting it */
    -webkit-mask-image: linear-gradient(to right, #000 74%, transparent 100%), linear-gradient(to bottom, #000 90%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, #000 74%, transparent 100%), linear-gradient(to bottom, #000 90%, transparent 100%);
    mask-composite: intersect;
  }

  .mock__screen {
    position: absolute;
    left: calc(140 / 640 * 100%);
    top: calc(182 / 820 * 100%);
    width: calc(350 / 640 * 100%);
    height: calc(450 / 820 * 100%);
    overflow: hidden;
    border-radius: 15.7% / 12.2%;
    background: #000;
  }

  /* The watch screen is a little narrower than the display, so it is widened to fill it and the sides trimmed. */
  .mock__tour {
    width: 105.2%;
    margin-left: -2.6%;
  }
</style>

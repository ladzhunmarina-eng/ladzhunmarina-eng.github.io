---
import PhoneTour from './PhoneTour.astro';
import type { Step } from './PhoneTour.astro';
import home from '../../assets/images/watch-1-home.png';
import children from '../../assets/images/watch-2-children.png';
import start from '../../assets/images/watch-3-start.png';
import time from '../../assets/images/watch-3b-time.png';
import stop from '../../assets/images/watch-4-stop-timer.png';
import stopped from '../../assets/images/watch-5-stopped.png';

/* The main function on the wrist, played by itself: open the app, pick the child, start the sleep, set the time, watch the clock, stop it. Coordinates are in the watch screen's own 198 x 242. */
interface Props {
  alt: string;
}

const { alt } = Astro.props;

const screens = [
  { src: home, alt },
  { src: children, alt: 'Select a child: Anna, awake since 8:06, and Teo, sleeping since 12:00.' },
  { src: start, alt: 'Anna, awake for 3:50, with a Start sleep button.' },
  { src: time, alt: 'Set the time: two wheels, 15 and 30, with a Save button.' },
  {
    src: stop,
    alt: 'Anna, sleeping since 12:00, with a Stop sleep button.',
    fields: [{ id: 'clock', box: [40, 104, 118, 36] as const, timer: true, fontSize: 26 }],
  },
  { src: stopped, alt: 'A green check and the word Stopped.' },
];

const tour = [
  [{ move: [150, 60] }, { wait: 300 }, { tap: [99, 128] }], // open the app
  [{ move: [100, 150] }, { wait: 300 }, { tap: [100, 67] }], // pick Anna
  [{ move: [99, 130] }, { wait: 400 }, { tap: [99, 198] }], // Start sleep
  [{ move: [145, 70] }, { wait: 300 }, { tap: [145, 111] }, { wait: 500 }, { move: [99, 170] }, { wait: 200 }, { tap: [99, 198] }], // set the time, Save
  [{ move: [99, 160] }, { wait: 300 }, { count: 'clock', from: [0, 0, 1], secs: 5, format: 'ms' }, { tap: [99, 198] }], // the clock runs, then Stop sleep
  [{ move: [99, 130] }, { wait: 1600 }], // Stopped
] satisfies Step[][];
---

<PhoneTour screens={screens} tour={tour} start={[150, 180]} size={[198, 242]} variant="watch" />

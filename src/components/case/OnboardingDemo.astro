---
import PhoneTour from './PhoneTour.astro';
import type { Step } from './PhoneTour.astro';
import start from '../../assets/images/onb-1-start.png';
import signup from '../../assets/images/onb-2-signup.png';
import email from '../../assets/images/onb-3-email-icon.png';
import congrats from '../../assets/images/onb-4-congrats.png';
import child from '../../assets/images/onb-5-child.png';
import birthday from '../../assets/images/onb-6-birthday.png';
import photo from '../../assets/images/onb-7-photo.png';

/* The parent onboarding, played by itself. */
interface Props {
  alt: string;
}

const { alt } = Astro.props;

const screens = [
  { src: start, alt },
  { src: signup, alt: 'Sign up as Parent: full name, email, password and timezone.', fields: [{ id: 'email', box: [17, 255, 357, 46] as const }, { id: 'password', box: [17, 343, 357, 46] as const }] },
  { src: email, alt: 'Verify your email: a link was sent to the address.' },
  { src: congrats, alt: 'Congratulations, you are registered. Let’s start.' },
  { src: child, alt: 'The child’s name and gender.' },
  { src: birthday, alt: 'The child’s birthday and whether they were premature.' },
  { src: photo, alt: 'Last step: add a favourite photo, or skip it for now.' },
];

const tour = [
  [{ move: [150, 420] }, { wait: 300 }, { tap: [190, 415] }], // Sign up as Parent
  [
    { move: [190, 280] },
    { tap: [190, 280] },
    { type: 'email', text: 'ladzhunmarina@gmail.com' },
    { move: [190, 366] },
    { tap: [190, 366] },
    { type: 'password', text: '••••••••' },
    { move: [195, 562] },
    { wait: 250 },
    { tap: [195, 562] },
  ],
  [{ move: [195, 330] }, { wait: 1500 }], // the link is clicked off screen
  [{ move: [195, 700] }, { tap: [195, 787] }], // Let's start
  [{ move: [195, 700] }, { wait: 500 }, { tap: [195, 787] }], // Next
  [{ move: [195, 700] }, { wait: 500 }, { tap: [195, 787] }], // Next
  [{ move: [195, 640] }, { wait: 450 }, { tap: [195, 709] }], // Skip for now
] satisfies Step[][];
---

<PhoneTour screens={screens} tour={tour} />

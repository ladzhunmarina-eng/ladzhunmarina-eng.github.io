---
interface Props {
  columns: readonly { name: string; rows: readonly (readonly [string, string])[] }[];
  method: string;
}

const { columns, method } = Astro.props;
---

<div class="impact">
  <div class="impact__columns">
    {columns.map((column) => (
      <section class="column" aria-label={column.name}>
        <h3 class="column__name">{column.name}</h3>
        <ul class="column__rows">
          {column.rows.map(([value, label]) => (
            <li class="row">
              <p class="row__value">{value}</p>
              <p class="row__label">{label}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p class="impact__method">{method}</p>
</div>

<style>
  .impact {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .impact__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--case-card-min-wide), 1fr));
    gap: var(--space-16);
  }

  .column {
    padding: var(--case-card-pad);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .column:first-child {
    background: var(--case-bg);
    border-color: transparent;
  }

  .column__name {
    margin-bottom: var(--space-16);
    font-family: var(--font-display);
    font-size: var(--fs-24);
    font-weight: var(--weight-bold);
    line-height: var(--lh-24);
    color: var(--color-ink);
  }

  .column__rows {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-12);
    border-top: 1px solid var(--case-line);
  }

  .column:first-child .row {
    border-top-color: rgb(0 0 0 / 0.15);
  }

  .row__value {
    font-family: var(--font-display);
    font-size: var(--fs-case-stat-sm);
    font-weight: var(--weight-extrabold);
    line-height: var(--lh-display);
    color: var(--case-on-bg);
  }

  .row__label {
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
    color: var(--color-ink);
  }

  .impact__method {
    max-width: var(--case-measure);
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
    color: var(--color-muted);
  }
</style>

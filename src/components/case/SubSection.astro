---
import Verify from './Verify.astro';

/* A titled block inside a Section (a test, the survey, a flow). */
interface Props {
  title: string;
  lead?: string;
  verify?: boolean;
}

const { title, lead, verify = false } = Astro.props;
---

<div class="sub">
  <h3 class="sub__title">{title}{verify && <Verify />}</h3>
  {lead && <p class="sub__lead">{lead}</p>}
  <div class="sub__body"><slot /></div>
</div>

<style>
  .sub {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-top: var(--space-32);
  }

  .sub__title {
    max-width: var(--case-measure);
    font-family: var(--font-display);
    font-size: var(--fs-case-h3);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    color: var(--color-ink);
  }

  .sub__lead {
    max-width: var(--case-measure);
    font-size: var(--fs-18);
    line-height: var(--lh-body);
  }

  .sub__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    margin-top: var(--space-8);
  }
</style>

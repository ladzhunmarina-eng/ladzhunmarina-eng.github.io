---
interface Props {
  heading: string;
  text: string;
  source: string;
}

const { heading, text, source } = Astro.props;
---

<figure class="review">
  <p class="review__stars" role="img" aria-label="5 out of 5 stars">★★★★★</p>
  <h3 class="review__heading">{heading}</h3>
  <blockquote class="review__text">{text}</blockquote>
  <figcaption class="review__source">{source}</figcaption>
</figure>

<style>
  .review {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    padding: var(--space-32);
    border-radius: var(--radius-card);
    background: var(--case-bg);
    color: var(--case-on-bg);
  }

  .review__stars {
    font-size: var(--fs-20);
    letter-spacing: 0.15em;
    line-height: 1;
  }

  .review__heading {
    font-family: var(--font-display);
    font-size: var(--fs-24);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
  }

  .review__text {
    max-width: var(--case-measure);
    font-size: var(--fs-18);
    line-height: var(--lh-body);
  }

  .review__source {
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    opacity: 0.75;
  }
</style>

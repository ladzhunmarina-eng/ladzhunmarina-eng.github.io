---
import Verify from './Verify.astro';
import CartIcon from '../../assets/icons/cart.svg';

interface Variant {
  id: string;
  name: string;
  label?: string;
  icon?: string;
  leader?: boolean;
  [key: string]: unknown;
}
interface Props {
  variants: readonly Variant[];
  /** Which fields of each variant to show as numbers, e.g. [{ key: 'bundle', label: 'Bundle rate' }]. */
  metrics?: readonly { key: string; label: string }[];
  verify?: boolean;
}

const { variants, metrics = [], verify = false } = Astro.props;
---

<ul class="variants" data-variants>
  {variants.map((variant) => (
    <li class="variant" style={`--mark: var(--case-variant-${variant.id.toLowerCase()}, var(--case-variant-a))`}>
      <div class="variant__head">
        <p class="variant__id" aria-hidden="true">{variant.id}</p>
        <p class="variant__name">{variant.name}{verify && <Verify />}</p>
        {variant.leader && <p class="variant__badge">Leader</p>}
      </div>
      {variant.label && (
        <p class="variant__button">
          {variant.icon === 'cart' && <CartIcon aria-hidden="true" />}
          {variant.label}
        </p>
      )}
      {metrics.length > 0 && (
        <dl class="variant__metrics">
          {metrics.map((metric) => (
            <div class="variant__metric">
              <dt>{metric.label}</dt>
              <dd>{String(variant[metric.key])}</dd>
            </div>
          ))}
        </dl>
      )}
    </li>
  ))}
</ul>

<style>
  .variants {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--case-card-min), 1fr));
    gap: var(--space-16);
  }

  .variant {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--case-card-pad);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .variant__head {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .variant__id {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-32);
    height: var(--space-32);
    border-radius: 50%;
    background: var(--mark);
    font-size: var(--fs-16);
    font-weight: var(--weight-bold);
    line-height: var(--lh-ui);
    color: var(--case-variant-text);
  }

  .variant__name {
    font-size: var(--fs-16);
    font-weight: var(--weight-medium);
    line-height: var(--lh-ui);
    color: var(--color-ink);
  }

  /* "Leader" is a cyan badge, not a recoloured card. */
  .variant__badge {
    margin-left: auto;
    padding: var(--space-2) var(--space-10);
    border-radius: var(--radius-pill);
    background: var(--case-bg);
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    color: var(--case-on-bg);
  }

  /* When the cards come into view the badge pops in and sends out two soft rings, then settles. */
  [data-motion='ready'] .variant__badge {
    opacity: 0;
    transform: scale(0.8);
  }

  [data-motion='go'] .variant__badge {
    animation:
      badge-in 0.6s cubic-bezier(0.25, 1, 0.5, 1) 0.4s both,
      badge-ring 1.4s cubic-bezier(0.25, 1, 0.5, 1) 0.9s 2;
  }

  @keyframes badge-in {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes badge-ring {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--case-bg) 70%, transparent);
    }
    to {
      box-shadow: 0 0 0 var(--space-14) transparent;
    }
  }

  /* The button as it looked in that variant */
  .variant__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    height: var(--button-height);
    border-radius: var(--space-8);
    background: var(--case-button-ghost);
    font-size: var(--fs-16);
    font-weight: var(--weight-medium);
    line-height: var(--lh-ui);
    color: var(--color-ink);
  }

  .variant__button :global(svg) {
    width: var(--space-24);
    height: var(--space-24);
  }

  .variant__metrics {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-16) 0 15px;
  }

  /* Label left, value right. In a card too narrow for that, every metric stacks in two lines, both on the left. */
  .variant__metric {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4) var(--space-12);
  }

  @container (max-width: 220px) {
    .variant__metric {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
  }

  .variant__metric dt {
    white-space: nowrap;
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }

  .variant__metric dd {
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--fs-20);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    color: var(--color-ink);
  }

  /* The leader's labels are in ink, not grey */
  .variant:has(.variant__badge) .variant__metric dt {
    color: var(--color-ink);
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-variants]').forEach((variants) => {
    if (calm.matches || !('IntersectionObserver' in window) || !variants.querySelector('.variant__badge')) return;
    variants.dataset.motion = 'ready';
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        seen.disconnect();
        variants.dataset.motion = 'go';
      },
      { threshold: 0.6 },
    );
    seen.observe(variants);
  });
</script>

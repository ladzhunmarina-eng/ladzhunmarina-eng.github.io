---
import Verify from './Verify.astro';
import CartIcon from '../../assets/icons/cart.svg';

interface Variant {
  id: string;
  name: string;
  label?: string;
  icon?: string;
  leader?: boolean;
  [key: string]: unknown;
}
interface Props {
  variants: readonly Variant[];
  /** Which fields of each variant to show as numbers, e.g. [{ key: 'bundle', label: 'Bundle rate' }]. */
  metrics?: readonly { key: string; label: string }[];
  verify?: boolean;
}

const { variants, metrics = [], verify = false } = Astro.props;
---

<ul class="variants">
  {variants.map((variant) => (
    <li class="variant" style={`--mark: var(--case-variant-${variant.id.toLowerCase()}, var(--case-variant-a))`}>
      <div class="variant__head">
        <p class="variant__id" aria-hidden="true">{variant.id}</p>
        <p class="variant__name">{variant.name}{verify && <Verify />}</p>
        {variant.leader && <p class="variant__badge">Leader</p>}
      </div>
      {variant.label && (
        <p class="variant__button">
          {variant.icon === 'cart' && <CartIcon aria-hidden="true" />}
          {variant.label}
        </p>
      )}
      {metrics.length > 0 && (
        <dl class="variant__metrics">
          {metrics.map((metric) => (
            <div class="variant__metric">
              <dt>{metric.label}</dt>
              <dd>{String(variant[metric.key])}</dd>
            </div>
          ))}
        </dl>
      )}
    </li>
  ))}
</ul>

<style>
  .variants {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--case-card-min), 1fr));
    gap: var(--space-16);
  }

  .variant {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--case-card-pad);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .variant__head {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .variant__id {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-32);
    height: var(--space-32);
    border-radius: 50%;
    background: var(--mark);
    font-size: var(--fs-16);
    font-weight: var(--weight-bold);
    line-height: var(--lh-ui);
    color: var(--case-variant-text);
  }

  .variant__name {
    font-size: var(--fs-16);
    font-weight: var(--weight-medium);
    line-height: var(--lh-ui);
    color: var(--color-ink);
  }

  /* "Leader" is a cyan badge, not a recoloured card. */
  .variant__badge {
    margin-left: auto;
    padding: var(--space-2) var(--space-10);
    border-radius: var(--radius-pill);
    background: var(--case-bg);
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-snug);
    color: var(--case-on-bg);
  }

  /* The button as it looked in that variant */
  .variant__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    height: var(--button-height);
    border-radius: var(--space-8);
    background: var(--case-button-ghost);
    font-size: var(--fs-16);
    line-height: var(--lh-ui);
    color: var(--color-ink);
  }

  .variant__button :global(svg) {
    width: var(--space-24);
    height: var(--space-24);
  }

  .variant__metrics {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-16) 0 15px;
  }

  /* Label left, value right. If the card is too narrow for both, the value drops under its label, still on the right, instead of breaking in the middle. */
  .variant__metric {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4) var(--space-12);
  }

  .variant__metric dt {
    white-space: nowrap;
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-muted);
  }

  .variant__metric dd {
    margin: 0 0 0 auto;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--fs-20);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    color: var(--color-ink);
  }

  /* The leader's labels are in ink, not grey */
  .variant:has(.variant__badge) .variant__metric dt {
    color: var(--color-ink);
  }
</style>

---
import { Image } from 'astro:assets';

interface Persona {
  name: string;
  role: string;
  age: string;
  location: string;
  bio: string;
  values: readonly string[];
  goals: readonly string[];
  pains: readonly string[];
  channels: readonly string[];
  quote: string;
  photoAlt: string;
}

interface Props {
  persona: Persona;
  photo: ImageMetadata;
}

const { persona, photo } = Astro.props;
---

<section class="profile" aria-label={persona.name}>
  <figure class="profile__who">
    <Image class="profile__photo" src={photo} alt={persona.photoAlt} widths={[360, 720]} sizes="(max-width: 1023px) 80vw, 320px" quality={85} />
    <figcaption class="profile__quote">{persona.quote}</figcaption>
  </figure>

  <div class="profile__body">
    <header class="profile__head">
      <div>
        <h3 class="profile__name">{persona.name}</h3>
        <p class="profile__role">{persona.role}</p>
      </div>
      <dl class="profile__facts">
        <div><dt>Age</dt><dd>{persona.age}</dd></div>
        <div><dt>Location</dt><dd>{persona.location}</dd></div>
      </dl>
    </header>

    <div class="profile__grid">
      <section class="profile__block profile__block--wide">
        <h4 class="profile__label">Biography</h4>
        <p class="profile__text">{persona.bio}</p>
      </section>
      <section class="profile__block">
        <h4 class="profile__label">Values</h4>
        <ul class="profile__list">{persona.values.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="profile__block">
        <h4 class="profile__label">Goals</h4>
        <ul class="profile__list">{persona.goals.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="profile__block">
        <h4 class="profile__label">Pain points</h4>
        <ul class="profile__list">{persona.pains.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="profile__block profile__block--wide">
        <h4 class="profile__label">Channels and devices</h4>
        <ul class="profile__chips">{persona.channels.map((item) => <li>{item}</li>)}</ul>
      </section>
    </div>
  </div>
</section>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(0, var(--erma-photo-w)) minmax(0, 1fr);
    gap: var(--space-32);
    padding: var(--case-card-pad);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .profile__who {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin: 0;
  }

  .profile__who :global(.profile__photo) {
    display: block;
    width: 100%;
    aspect-ratio: 358 / 502;
    object-fit: cover;
    border-radius: var(--radius-person);
  }

  .profile__quote {
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    text-align: center;
    color: var(--color-ink);
  }

  .profile__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    min-width: 0;
  }

  .profile__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-16);
  }

  .profile__name {
    font-family: var(--font-display);
    font-size: var(--fs-24);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
    color: var(--color-ink);
  }

  .profile__role {
    margin-top: var(--space-4);
    font-size: var(--fs-16);
    color: var(--color-muted);
  }

  .profile__facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .profile__facts div {
    display: flex;
    gap: var(--space-8);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
  }

  .profile__facts dt {
    color: var(--color-muted);
  }

  .profile__facts dd {
    margin: 0;
    font-weight: var(--weight-medium);
    color: var(--color-ink);
  }

  .profile__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-24) var(--space-32);
  }

  .profile__block--wide {
    grid-column: 1 / -1;
  }

  .profile__label {
    margin-bottom: var(--space-8);
    font-size: var(--fs-12);
    font-weight: var(--weight-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    line-height: var(--lh-snug);
    color: var(--case-accent);
  }

  .profile__text,
  .profile__list {
    font-size: var(--fs-14);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }

  .profile__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-left: var(--space-16);
    list-style: disc;
  }

  .profile__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .profile__chips li {
    padding: var(--space-4) var(--space-12);
    border-radius: var(--space-4);
    background: var(--color-icon-bg);
    font-size: var(--fs-14);
    line-height: var(--lh-snug);
    color: var(--color-ink);
  }

  @media (max-width: 1023px) {
    .profile {
      grid-template-columns: minmax(0, 1fr);
    }

    .profile__who {
      max-width: var(--erma-photo-w);
    }
  }

  @media (max-width: 640px) {
    .profile__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

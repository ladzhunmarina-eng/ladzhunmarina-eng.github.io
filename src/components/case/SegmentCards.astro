---
interface Props {
  segments: readonly { name: string; value: string; text: string }[];
}

const { segments } = Astro.props;
---

<ul class="segments">
  {segments.map((segment) => (
    <li class="segment">
      <p class="segment__value">{segment.value}</p>
      <h3 class="segment__name">{segment.name}</h3>
      <p class="segment__text">{segment.text}</p>
    </li>
  ))}
</ul>

<style>
  .segments {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--case-card-min), 1fr));
    gap: var(--space-16);
  }

  .segment {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--case-card-pad);
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .segment__value {
    font-family: var(--font-display);
    font-size: var(--fs-case-stat);
    font-weight: var(--weight-extrabold);
    line-height: var(--lh-display);
    color: var(--case-accent);
  }

  .segment__name {
    font-size: var(--fs-20);
    font-weight: var(--weight-medium);
    line-height: var(--lh-20);
    color: var(--color-ink);
  }

  .segment__text {
    font-size: var(--fs-16);
    line-height: var(--lh-body);
  }
</style>

---
import { Image } from 'astro:assets';
import LogoShield from './LogoShield.astro';
import upload from '../../assets/images/erma-ts-default.png';
import hover from '../../assets/images/erma-ts-hover-bg.png';
import loading from '../../assets/images/erma-ts-loading-bg.png';
import chip from '../../assets/images/erma-ts-chip.png';
import bolt from '../../assets/images/erma-ts-bolt.png';
import oneday from '../../assets/images/erma-ts-bars-bg.png';

interface Props {
  alt: string;
}

const { alt } = Astro.props;

// Everything is a share of the 1440 x 1025 screen (the picture's own size in the design)
const W = 1440;
const H = 1025;
const pct = (v: number, of: number) => (v / of) * 100;
const logo = { left: 3.75, top: 2.54, width: 10.07, height: 4.78 };
const chipBox = `left:${pct(1098, W)}%;top:${pct(370, H)}%;width:${pct(186, W)}%;`; // the file being dragged, where it ends up over the drop zone
// The files' progress bars, each filling to 100%: the top of its row's bar group, the percent it reaches, the width of its fill (design pixels, the whole 94px track) and where its percent starts
const barTops = [332, 392, 446, 504, 562, 617, 675, 733, 791, 849, 907];
const bars = barTops.map((top) => ({ top, pct: 100, fill: 94, tx: 634 }));
// The table runs on to the bottom of the page: three more files under the eight of the design, and the pagination moved down below them
const more = [
  { file: 'File_K9M2X4.pdf', who: 'Daniel Reyes', from: '06 Dec 2025', to: '08 Dec 2025' },
  { file: 'Aaron_12 Dec 2025.pdf', who: 'Noah Fischer', from: '11 Dec 2025', to: '12 Dec 2025' },
  { file: 'File_Z3B7N1.csv', who: 'Olivia Brooks', from: '19 Dec 2025', to: '21 Dec 2025' },
].map((row, i) => ({ ...row, top: 772 + i * 57 }));
const box = (x: number, y: number, w?: number, h?: number) =>
  `left:${pct(x, W)}%;top:${pct(y, H)}%;${w ? `width:${pct(w, W)}%;` : ''}${h ? `height:${pct(h, H)}%;` : ''}`;
const pages = [2, 3, 4, 5, 6, 7, 8, 9];
const boltBox = `left:${pct(816, W)}%;top:${pct(462, H)}%;width:${pct(60, W)}%;`; // the loader's bolt
---

<figure class="ts" data-ts>
  <div class="ts__screen">
    <Image src={upload} alt={alt} widths={[640, 1008, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
    <Image class="ts__layer ts__layer--hover" src={hover} alt="" widths={[640, 1008, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
    <Image class="ts__layer ts__layer--loading" src={loading} alt="" widths={[640, 1008, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
    <Image class="ts__layer ts__layer--oneday" src={oneday} alt="" widths={[640, 1008, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
    <div class="ts__more" aria-hidden="true">
      <span class="ts__cover" style={box(277, 778, 1137, 70)}></span>
      {more.map((row) => (
        <div class="ts__row" style={box(277, row.top, 1137, 57)}>
          <span class="ts__file">{row.file}</span>
          <span class="ts__who">{row.who}<svg viewBox="0 0 8 4" aria-hidden="true"><path d="M0 0l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></span>
          <span class="ts__date ts__date--from">{row.from}</span>
          <span class="ts__date ts__date--to">{row.to}</span>
          <span class="ts__status">Select<svg viewBox="0 0 8 4" aria-hidden="true"><path d="M0 0l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></span>
          <svg class="ts__trash" viewBox="0 0 20 22" aria-hidden="true"><path d="M2 4h16M7 4V2h6v2M4 4l1 16h10l1-16M8 8v8M12 8v8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" /></svg>
        </div>
      ))}
      <div class="ts__pager" style={box(277, 950, 1137, 50)}>
        <span class="ts__per">Items per page</span>
        <span class="ts__perbox">12<svg viewBox="0 0 8 4" aria-hidden="true"><path d="M0 0l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></span>
        <span class="ts__prev">‹</span>
        <span class="ts__page ts__page--on">1</span>
        {pages.map((n) => <span class="ts__page">{n}</span>)}
        <span class="ts__next">›</span>
      </div>
    </div>
    <ul class="ts__bars" aria-hidden="true">
      {bars.map((bar, i) => (
        <li class="ts__bar" style={`--top: ${pct(bar.top, H)}%; --fill: ${(bar.fill / 94) * 100}%; --tx: ${((bar.tx - 527) / 133) * 100}%; --i: ${i}`}>
          <span class="ts__track"><span class="ts__fill"></span></span>
          <span class="ts__pct"><span data-count={bar.pct}>{bar.pct}</span>%</span>
        </li>
      ))}
    </ul>
    <Image class="ts__chip" src={chip} alt="" widths={[186, 372]} sizes="(max-width: 1023px) 13vw, 130px" quality={90} style={chipBox} />
    <Image class="ts__bolt" src={bolt} alt="" widths={[60, 120]} sizes="(max-width: 1023px) 4vw, 42px" quality={90} style={boltBox} />
    <LogoShield {...logo} />
  </div>
</figure>

<style>
  .ts {
    margin: 0;
  }

  .ts__screen {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 1440 / 1025;
    overflow: hidden;
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .ts__screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  /* The next screens lie over the first and fade in */
  .ts__screen :global(.ts__layer) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  [data-over] .ts__screen :global(.ts__layer--hover),
  [data-load] .ts__screen :global(.ts__layer--loading),
  [data-oneday] .ts__screen :global(.ts__layer--oneday) {
    opacity: 1;
  }

  /* each screen replaces the one before it: the hover is only the drop zone turning blue; the loader covers it, the bars screen covers the loader */
  [data-load] .ts__screen :global(.ts__layer--hover),
  [data-oneday] .ts__screen :global(.ts__layer--loading) {
    opacity: 0;
  }

  /* The rest of the table: three more files and the pagination under them, laid over the picture's own pagination */
  .ts__more {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    font-size: 0.972cqw; /* 14 of the 1440px design */
    line-height: 1;
    color: #1e1e1e;
  }

  [data-oneday] .ts__more {
    opacity: 1;
  }

  .ts__cover {
    position: absolute;
    background: var(--color-white);
  }

  .ts__row {
    position: absolute;
    border-bottom: 1px solid #eaeaea;
    background: var(--color-white);
  }

  .ts__row > * {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
  }

  .ts__file {
    left: 1.7%; /* 298 of the 1137 row, from 277 */
    color: #0a4bbf;
  }

  .ts__who,
  .ts__status,
  .ts__perbox {
    display: inline-flex;
    align-items: center;
    gap: 0.45cqw;
    border-radius: 0.28cqw;
    background: #f9f9f9;
  }

  .ts__who {
    left: 37.2%; /* 700 */
    padding: 0.5cqw 0.8cqw;
  }

  .ts__who svg,
  .ts__status svg,
  .ts__perbox svg {
    width: 0.55cqw;
    height: auto;
  }

  .ts__date {
    left: 54.5%; /* 897 */
  }

  .ts__date--to {
    left: 68.4%; /* 1053 */
  }

  .ts__status {
    left: 85.6%; /* 1252 */
    padding: 0.6cqw 0.9cqw;
    font-size: 0.75cqw;
  }

  .ts__trash {
    left: 96.3%; /* 1376 */
    width: 1.45cqw;
    height: auto;
    color: #444;
  }

  /* the pagination: items per page on the left, the page numbers on the right */
  .ts__pager {
    position: absolute;
  }

  .ts__pager > * {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .ts__per {
    left: 0;
  }

  .ts__perbox {
    left: 10.8%; /* 123 of the 1137 */
    gap: 1cqw;
    padding: 1.1cqw 0.8cqw;
    border: 1px solid #dcdcdc;
    background: var(--color-white);
    font-size: 0.833cqw;
  }

  .ts__prev,
  .ts__next,
  .ts__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.67cqw;
    height: 1.67cqw;
    font-size: 0.833cqw;
    border-radius: 0.28cqw;
  }

  .ts__prev {
    left: 75.4%;
    color: #bbb;
    font-size: 1.4cqw;
  }

  .ts__next {
    left: 98%;
    font-size: 1.4cqw;
  }

  .ts__pager > .ts__page:nth-child(4) {
    left: 77.57%;
  }

  .ts__pager > .ts__page:nth-child(5) {
    left: 79.60%;
  }

  .ts__pager > .ts__page:nth-child(6) {
    left: 81.71%;
  }

  .ts__pager > .ts__page:nth-child(7) {
    left: 83.73%;
  }

  .ts__pager > .ts__page:nth-child(8) {
    left: 85.84%;
  }

  .ts__pager > .ts__page:nth-child(9) {
    left: 88.04%;
  }

  .ts__pager > .ts__page:nth-child(10) {
    left: 90.15%;
  }

  .ts__pager > .ts__page:nth-child(11) {
    left: 92.26%;
  }

  .ts__pager > .ts__page:nth-child(12) {
    left: 94.37%;
  }

  .ts__pager .ts__page--on {
    background: #ff5000;
    color: #fff;
  }

  /* The files' progress bars: they fill in turn, and the percents count up */
  .ts__bars {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .ts__bar {
    position: absolute;
    left: 36.6%; /* 527 of 1440 */
    top: var(--top);
    width: 9.2%; /* the 94px track and the percent: 133px */
    height: 1.756%; /* 18px */
    opacity: 0;
    transition: opacity 0.3s ease calc(var(--i) * 0.1s);
  }

  [data-oneday] .ts__bar {
    opacity: 1;
  }

  .ts__track {
    position: absolute;
    left: 0;
    top: 38.9%; /* 7px of 18 */
    width: 70.7%; /* 94 of 133 */
    height: 22.2%; /* 4px of 18 */
    border-radius: 40px;
    background: #eaeaea;
    overflow: hidden;
  }

  .ts__fill {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 40px;
    background: #1da735;
  }

  [data-oneday] .ts__fill {
    width: var(--fill);
    transition: width 1.8s cubic-bezier(0.25, 1, 0.5, 1) calc(0.2s + var(--i) * 0.12s);
  }

  .ts__pct {
    position: absolute;
    left: var(--tx);
    top: 0;
    font-size: 0.972cqw;
    line-height: 1.75;
    white-space: nowrap;
    color: #000;
    font-variant-numeric: tabular-nums;
  }

  /* the file being dragged in from below, to the drop zone */
  .ts__screen :global(.ts__chip) {
    position: absolute;
    z-index: 2;
    height: auto;
    opacity: 0;
    transform: translate(4.17cqw, 20.83cqw); /* 60px right and 300px down in the 1440px design */
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.18));
  }

  [data-chip] .ts__screen :global(.ts__chip) {
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  [data-moved] .ts__screen :global(.ts__chip) {
    transform: none;
    transition:
      transform 1.3s cubic-bezier(0.45, 0, 0.2, 1),
      opacity 0.3s ease;
  }

  [data-drop] .ts__screen :global(.ts__chip) {
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  /* the bolt over the loader breathes while the files upload */
  .ts__screen :global(.ts__bolt) {
    position: absolute;
    z-index: 2;
    height: auto;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  [data-load] .ts__screen :global(.ts__bolt) {
    opacity: 1;
    animation: ts-pulse 1.1s ease-in-out infinite;
  }

  [data-oneday] .ts__screen :global(.ts__bolt) {
    opacity: 0;
    animation: none;
  }

  @keyframes ts-pulse {
    0%,
    100% {
      transform: scale(0.88);
    }
    50% {
      transform: scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts__bar,
    .ts__fill,
    .ts__screen :global(.ts__layer),
    .ts__screen :global(.ts__chip),
    .ts__screen :global(.ts__bolt) {
      transition: none;
    }

    [data-load] .ts__screen :global(.ts__bolt) {
      animation: none;
    }
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-ts]').forEach((demo) => {
    if (calm.matches || !('IntersectionObserver' in window)) return;

    let timers: number[] = [];
    let running = false;
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const reset = () => ['data-chip', 'data-moved', 'data-over', 'data-drop', 'data-load', 'data-oneday'].forEach((name) => demo.removeAttribute(name));
    const countUp = (el: HTMLElement, delay: number) => {
      const target = Number(el.dataset.count);
      const start = performance.now() + delay;
      const step = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / 1800));
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(step);
      };
      el.textContent = '0';
      requestAnimationFrame(step);
    };
    const stop = () => {
      running = false;
      timers.forEach(window.clearTimeout);
      timers = [];
      reset();
    };

    // The drop zone waits, a file is dragged in from below, the zone turns blue, the file is dropped, the loader takes over,
    // the files' progress bars fill.
    const play = () => {
      if (!running) return;
      reset();
      at(1200, () => demo.setAttribute('data-chip', ''));
      at(1500, () => demo.setAttribute('data-moved', ''));
      at(2200, () => demo.setAttribute('data-over', ''));
      at(3600, () => demo.setAttribute('data-drop', ''));
      at(3700, () => demo.setAttribute('data-load', ''));
      at(6200, () => {
        demo.setAttribute('data-oneday', '');
        demo.querySelectorAll<HTMLElement>('[data-count]').forEach((el, i) => countUp(el, 200 + i * 120));
      });
      at(12200, reset);
      at(13400, play);
    };

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !running) {
          running = true;
          play();
        } else if (!entry.isIntersecting && running) {
          stop();
        }
      },
      { threshold: 0.5 },
    ).observe(demo);
  });
</script>

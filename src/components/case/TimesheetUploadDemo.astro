---
import { Image } from 'astro:assets';
import LogoShield from './LogoShield.astro';
import upload from '../../assets/images/erma-ts-default.png';
import hover from '../../assets/images/erma-ts-hover-bg.png';
import loading from '../../assets/images/erma-ts-loading-bg.png';
import sidebar from '../../assets/images/erma-rosters-five.png';
import chip from '../../assets/images/erma-ts-chip.png';
import bolt from '../../assets/images/erma-ts-bolt.png';
import oneday from '../../assets/images/erma-ts-final-bg.png';

interface Props {
  alt: string;
}

const { alt } = Astro.props;

// Everything is a share of the 1440 x 1025 screen (the picture's own size in the design)
const W = 1440;
const H = 1025;
const pct = (v: number, of: number) => (v / of) * 100;
const logo = { left: 3.75, top: 2.54, width: 10.07, height: 4.78 };
const chipBox = `left:${pct(1098, W)}%;top:${pct(370, H)}%;width:${pct(186, W)}%;`; // the file being dragged, where it ends up over the drop zone
// The files' progress bars, each filling to 100%: the top of its row's bar group, the percent it reaches, the width of its fill (design pixels, the whole 94px track) and where its percent starts
const barTops = [334, 391, 448, 505, 562, 619, 676, 733, 790, 847, 904]; // the top of each row's bar group (the track sits 7px lower)
const bars = barTops.map((top) => ({ top, pct: 100, fill: 94, tx: 621 }));
const boltBox = `left:${pct(816, W)}%;top:${pct(462, H)}%;width:${pct(60, W)}%;`; // the loader's bolt
---

<figure class="ts" data-ts>
  <div class="ts__screen">
    <Image src={upload} alt={alt} widths={[640, 1008, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
    <Image class="ts__layer ts__layer--hover" src={hover} alt="" widths={[640, 1008, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
    <Image class="ts__layer ts__layer--loading" src={loading} alt="" widths={[640, 1008, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
    <Image class="ts__layer ts__layer--oneday" src={oneday} alt="" widths={[640, 1008, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
    <ul class="ts__bars" aria-hidden="true">
      {bars.map((bar, i) => (
        <li class="ts__bar" style={`--top: ${pct(bar.top, H)}%; --fill: ${(bar.fill / 94) * 100}%; --tx: ${((bar.tx - 512) / 133) * 100}%; --i: ${i}`}>
          <span class="ts__track"><span class="ts__fill"></span></span>
          <span class="ts__pct"><span data-count={bar.pct}>{bar.pct}</span>%</span>
        </li>
      ))}
    </ul>
    <Image class="ts__chip" src={chip} alt="" widths={[186, 372]} sizes="(max-width: 1023px) 13vw, 130px" quality={90} style={chipBox} />
    <Image class="ts__bolt" src={bolt} alt="" widths={[60, 120]} sizes="(max-width: 1023px) 4vw, 42px" quality={90} style={boltBox} />
    <!-- the sidebar of the roster screens (with the profile card), over the old one on every screen of the upload -->
    <div class="ts__side" aria-hidden="true">
      <Image src={sidebar} alt="" widths={[640, 1008, 1568]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
    </div>
    <LogoShield {...logo} />
  </div>
</figure>

<style>
  .ts {
    margin: 0;
  }

  .ts__screen {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 1440 / 1025;
    overflow: hidden;
    border: 1px solid var(--case-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .ts__screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  /* The sidebar: the first 251 of the 1440 pixels of the rosters screen, the full height */
  .ts__side {
    position: absolute;
    z-index: 1;
    left: 0;
    top: 0;
    width: 17.43%; /* 251 of 1440 */
    height: 100%;
    overflow: hidden;
  }

  .ts__side :global(img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 573.7%; /* the whole 1440px screen, so only its sidebar shows */
    max-width: none;
    height: 100%;
  }

  /* The next screens lie over the first and fade in */
  .ts__screen :global(.ts__layer) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  [data-over] .ts__screen :global(.ts__layer--hover),
  [data-load] .ts__screen :global(.ts__layer--loading),
  [data-oneday] .ts__screen :global(.ts__layer--oneday) {
    opacity: 1;
  }

  /* each screen replaces the one before it: the hover is only the drop zone turning blue; the loader covers it, the bars screen covers the loader */
  [data-load] .ts__screen :global(.ts__layer--hover),
  [data-oneday] .ts__screen :global(.ts__layer--loading) {
    opacity: 0;
  }

  /* The files' progress bars: they fill in turn, and the percents count up */
  .ts__bars {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .ts__bar {
    position: absolute;
    left: 35.55%; /* 512 of 1440 */
    top: var(--top);
    width: 9.2%; /* the 94px track and the percent: 133px */
    height: 1.756%; /* 18px */
    opacity: 0;
    transition: opacity 0.3s ease calc(var(--i) * 0.1s);
  }

  [data-oneday] .ts__bar {
    opacity: 1;
  }

  .ts__track {
    position: absolute;
    left: 0;
    top: 38.9%; /* 7px of 18 */
    width: 70.7%; /* 94 of 133 */
    height: 22.2%; /* 4px of 18 */
    border-radius: 40px;
    background: #eaeaea;
    overflow: hidden;
  }

  .ts__fill {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 40px;
    background: #1da735;
  }

  [data-oneday] .ts__fill {
    width: var(--fill);
    transition: width 1.8s cubic-bezier(0.25, 1, 0.5, 1) calc(0.2s + var(--i) * 0.12s);
  }

  .ts__pct {
    position: absolute;
    left: var(--tx);
    top: 0;
    font-size: 0.972cqw;
    line-height: 1.75;
    white-space: nowrap;
    color: #000;
    font-variant-numeric: tabular-nums;
  }

  /* the file being dragged in from below, to the drop zone */
  .ts__screen :global(.ts__chip) {
    position: absolute;
    z-index: 2;
    height: auto;
    opacity: 0;
    transform: translate(4.17cqw, 20.83cqw); /* 60px right and 300px down in the 1440px design */
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.18));
  }

  [data-chip] .ts__screen :global(.ts__chip) {
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  [data-moved] .ts__screen :global(.ts__chip) {
    transform: none;
    transition:
      transform 1.3s cubic-bezier(0.45, 0, 0.2, 1),
      opacity 0.3s ease;
  }

  [data-drop] .ts__screen :global(.ts__chip) {
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  /* the bolt over the loader breathes while the files upload */
  .ts__screen :global(.ts__bolt) {
    position: absolute;
    z-index: 2;
    height: auto;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  [data-load] .ts__screen :global(.ts__bolt) {
    opacity: 1;
    animation: ts-pulse 1.1s ease-in-out infinite;
  }

  [data-oneday] .ts__screen :global(.ts__bolt) {
    opacity: 0;
    animation: none;
  }

  @keyframes ts-pulse {
    0%,
    100% {
      transform: scale(0.88);
    }
    50% {
      transform: scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts__bar,
    .ts__fill,
    .ts__screen :global(.ts__layer),
    .ts__screen :global(.ts__chip),
    .ts__screen :global(.ts__bolt) {
      transition: none;
    }

    [data-load] .ts__screen :global(.ts__bolt) {
      animation: none;
    }
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-ts]').forEach((demo) => {
    if (calm.matches || !('IntersectionObserver' in window)) return;

    let timers: number[] = [];
    let running = false;
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const reset = () => ['data-chip', 'data-moved', 'data-over', 'data-drop', 'data-load', 'data-oneday'].forEach((name) => demo.removeAttribute(name));
    const countUp = (el: HTMLElement, delay: number) => {
      const target = Number(el.dataset.count);
      const start = performance.now() + delay;
      const step = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / 1800));
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(step);
      };
      el.textContent = '0';
      requestAnimationFrame(step);
    };
    const stop = () => {
      running = false;
      timers.forEach(window.clearTimeout);
      timers = [];
      reset();
    };

    // The drop zone waits, a file is dragged in from below, the zone turns blue, the file is dropped, the loader takes over,
    // the files' progress bars fill.
    const play = () => {
      if (!running) return;
      reset();
      at(1200, () => demo.setAttribute('data-chip', ''));
      at(1500, () => demo.setAttribute('data-moved', ''));
      at(2200, () => demo.setAttribute('data-over', ''));
      at(3600, () => demo.setAttribute('data-drop', ''));
      at(3700, () => demo.setAttribute('data-load', ''));
      at(6200, () => {
        demo.setAttribute('data-oneday', '');
        demo.querySelectorAll<HTMLElement>('[data-count]').forEach((el, i) => countUp(el, 200 + i * 120));
      });
      at(12200, reset);
      at(13400, play);
    };

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !running) {
          running = true;
          play();
        } else if (!entry.isIntersecting && running) {
          stop();
        }
      },
      { threshold: 0.5 },
    ).observe(demo);
  });
</script>

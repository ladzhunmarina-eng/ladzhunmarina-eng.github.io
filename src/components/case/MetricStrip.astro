---
interface Props {
  metrics: readonly { value: string; label: string }[];
}

const { metrics } = Astro.props;
---

<ul class="strip" aria-label="Key results">
  {metrics.map((metric) => (
    <li class="strip__item">
      <p class="strip__value">{metric.value}</p>
      <p class="strip__label">{metric.label}</p>
    </li>
  ))}
</ul>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--case-card-min), 1fr));
    gap: var(--space-24) var(--space-32);
    padding: var(--space-32);
    border-radius: var(--radius-panel);
    background: var(--case-strip-bg);
  }

  .strip__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .strip__value {
    font-family: var(--font-display);
    font-size: var(--fs-case-stat);
    font-weight: var(--weight-extrabold);
    line-height: var(--lh-display);
    color: var(--case-strip-value);
  }

  .strip__label {
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
    color: var(--case-strip-fg);
  }
</style>

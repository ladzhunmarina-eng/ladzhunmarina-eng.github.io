---
import DribbbleIcon from '../assets/icons/dribbble.svg';
import LinkedinIcon from '../assets/icons/linkedin.svg';
import GithubIcon from '../assets/icons/github.svg';

interface Props {
  class?: string;
  direction?: 'row' | 'column';
}

const { class: className, direction = 'row' } = Astro.props;
const links = [
  { label: 'GitHub', href: '#', Icon: GithubIcon },
  { label: 'LinkedIn', href: '#', Icon: LinkedinIcon },
  { label: 'Dribbble', href: '#', Icon: DribbbleIcon },
];
---

<ul class:list={['social', `social--${direction}`, className]} aria-label="Social profiles">
  {links.map(({ label, href, Icon }) => (
    <li>
      <a class="social__link" href={href} aria-label={label} rel="me noopener">
        <Icon aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex;
    align-items: center;
    gap: var(--social-gap-row);
  }

  .social--column {
    flex-direction: column;
    gap: var(--social-gap-col);
  }

  .social > li {
    display: flex;
  }

  .social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-hit);
    height: var(--icon-hit);
    background: var(--color-icon-bg);
    color: var(--color-icon-muted);
    border-radius: 50%;
    transition: color 0.15s ease;
  }

  .social__link :global(svg) {
    display: block;
  }

  .social__link:focus-visible {
    border-radius: 50%;
  }

  .social__link:hover {
    color: var(--color-ink-button);
  }
</style>

---
import { Image } from 'astro:assets';
import avatar from '../assets/images/avatar.png';
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero__title">
    Hi, I’m <span class="hero__avatar"><Image
        src={avatar}
        alt=""
        width={278}
        height={278}
        widths={[139, 278, 417]}
        sizes="139px"
        loading="eager"
      /></span> Marina <span class="hero__wave" role="img" aria-label="waving hand">👋</span>, practicing product design since 2015, building complex digital products for real business needs.
  </h1>
  <div class="hero__actions">
    <Button href="#work">View cases</Button>
    <Button href="#" variant="outline" trail>CV</Button>
    <Button class="hero__contact" href="#contact" variant="outline-strong">Contact me</Button>
  </div>
  <SocialLinks class="hero__rail" direction="column" />
  <SocialLinks class="hero__social" />
</section>

<style>
  .hero {
    position: relative;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--hero-top) var(--hero-gutter) 0;
  }

  .hero__title {
    max-width: var(--hero-measure);
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-0);
    color: var(--color-ink);
  }

  /* The photo takes the gap in the first line; it rises above the line like in the design. */
  .hero__avatar {
    position: relative;
    display: inline-block;
    width: var(--hero-avatar-size);
    height: 0;
    margin-inline: var(--hero-avatar-gap);
    vertical-align: baseline;
  }

  .hero__avatar img {
    position: absolute;
    bottom: calc(var(--hero-baseline) + var(--hero-avatar-raise) - var(--hero-avatar-size));
    left: 0;
    width: 100%;
    height: auto;
  }

  /*
   * The emoji waves once after the page loads. It is an inline-block so it can rotate, with its own
   * line-height so the emoji font's taller metrics do not stretch the first line.
   */
  .hero__wave {
    display: inline-block;
    line-height: 1;
    transform-origin: var(--wave-pivot);
    animation: hero-wave var(--wave-duration) ease-in-out var(--wave-delay) 1;
  }

  @keyframes hero-wave {
    0%,
    100% {
      transform: rotate(0deg);
    }
    15% {
      transform: rotate(var(--wave-angle));
    }
    30% {
      transform: rotate(calc(var(--wave-angle) * -0.6));
    }
    45% {
      transform: rotate(var(--wave-angle));
    }
    60% {
      transform: rotate(calc(var(--wave-angle) * -0.4));
    }
    75% {
      transform: rotate(calc(var(--wave-angle) * 0.6));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__wave {
      animation: none;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-14);
    margin-top: var(--space-30);
  }

  /* Contact me is in the header from 860px; below that the hero carries it. */
  .hero :global(.hero__contact) {
    display: inline-flex;
  }

  @media (min-width: 860px) {
    .hero :global(.hero__contact) {
      display: none;
    }
  }

  /* Social icons: a vertical rail beside the heading on desktop, a row under the buttons below that. */
  .hero :global(.hero__rail) {
    display: none;
  }

  .hero :global(.hero__social) {
    margin-top: var(--space-16);
  }

  @media (min-width: 1025px) {
    .hero :global(.hero__rail) {
      position: absolute;
      top: var(--rail-top);
      right: var(--gutter);
      display: flex;
    }

    .hero :global(.hero__social) {
      display: none;
    }
  }
</style>

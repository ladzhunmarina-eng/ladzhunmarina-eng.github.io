---
import { Image } from 'astro:assets';
import avatar from '../assets/images/avatar.png';
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero__title">
    Hi, I’m <span class="hero__avatar"><Image
        src={avatar}
        alt=""
        width={278}
        height={278}
        widths={[139, 278, 417]}
        sizes="139px"
        loading="eager"
      /></span> Marina <span class="hero__wave" role="img" aria-label="waving hand">👋</span>, practicing product design since 2015, building complex digital products for real business needs.
  </h1>
  <div class="hero__actions">
    <Button href="#contact">Contact me</Button>
    <Button href="#" variant="outline">CV</Button>
  </div>
  <SocialLinks class="hero__social" />
</section>

<style>
  .hero {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--hero-top) var(--hero-gutter) 0;
  }

  .hero__title {
    max-width: var(--hero-measure);
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--weight-bold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-0);
    color: var(--color-ink);
  }

  /* The photo takes the gap in the first line; it rises above the line like in the design. */
  .hero__avatar {
    position: relative;
    display: inline-block;
    width: var(--hero-avatar-size);
    height: 0;
    margin-inline: var(--hero-avatar-gap);
    vertical-align: baseline;
  }

  .hero__avatar img {
    position: absolute;
    bottom: calc(var(--hero-baseline) + var(--hero-avatar-raise) - var(--hero-avatar-size));
    left: 0;
    width: 100%;
    height: auto;
  }

  /* The emoji font has taller metrics; keep it from stretching the first line. */
  .hero__wave {
    line-height: 0;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-14);
    margin-top: var(--space-30);
  }

  /* Phones only: the header's icon group is hidden there, so the icons sit under the buttons. */
  .hero :global(.hero__social) {
    display: none;
    margin-top: var(--space-16);
  }

  @media (max-width: 640px) {
    .hero :global(.hero__social) {
      display: flex;
    }
  }
</style>

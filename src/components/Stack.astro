---
import { Image } from 'astro:assets';
import { stack, tools } from '../data/content';

// Each line becomes a list of pieces: text, or a chip that carries the comma or full stop after it, so a
// line break can never leave punctuation on its own at the start of a line.
type Piece = { text: string } | { tool: keyof typeof tools; after: string };

const lines: Piece[][] = stack.lines.map((line) => {
  const pieces: Piece[] = [];
  for (const part of line) {
    if (typeof part !== 'string') {
      pieces.push({ tool: part.tool, after: '' });
      continue;
    }
    const last = pieces[pieces.length - 1];
    const lead = part.match(/^[,.]+/)?.[0] ?? '';
    if (last && 'tool' in last && lead) {
      last.after = lead;
      if (part.length > lead.length) pieces.push({ text: part.slice(lead.length) });
    } else {
      pieces.push({ text: part });
    }
  }
  return pieces;
});

// The chips come in one after another; this is each chip's place in that order.
let chipIndex = 0;
---

<section class="stack" id="stack" aria-labelledby="stack-title">
  <h2 id="stack-title" class="visually-hidden">{stack.title}</h2>

  <p class="stack__sentence">
    {lines.map((line) => (
      <span class="line">
        {line.map((piece) => {
          if ('text' in piece) return piece.text;
          const tool = tools[piece.tool];
          const index = chipIndex++;
          return (
            <span class="unit">
              <span class="tool" style={`--i: ${index}`}>
                <Image class="tool__logo" src={tool.logo} alt="" width={64} height={64} widths={[32, 64, 96]} sizes="1.15em" />
                {tool.name}
              </span>
              {piece.after}
            </span>
          );
        })}
      </span>
    ))}
  </p>
</section>

<script>
  // The chips settle into the sentence the first time it scrolls into view. Without this script
  // (or with reduced motion) they are simply there from the start.
  const section = document.querySelector<HTMLElement>('.stack');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section && !calm.matches && 'IntersectionObserver' in window) {
    section.dataset.reveal = 'ready';
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        seen.disconnect();
        section.dataset.reveal = 'go';
      },
      { threshold: 0.35 },
    );
    seen.observe(section);
  }
</script>

<style>
  .stack {
    display: flex;
    justify-content: center;
    padding: var(--space-167) var(--gutter);
    text-align: center;
  }

  .stack__sentence {
    max-width: var(--stack-w);
    font-size: var(--fs-statement);
    font-weight: var(--weight-medium);
    line-height: calc(var(--lh-body) * 1.15); /* a little more air between the lines of chips */
    color: var(--color-ink);
    text-wrap: balance;
    letter-spacing: var(--ls-display);
  }

  /* One clause per line. If a line is too long for the screen it wraps inside itself. */
  .line {
    display: block;
  }

  .unit {
    white-space: nowrap;
  }

  /* A tool: its logo and name in a soft pill that sits in the line of text */
  .tool {
    /* inline-block, so the name's baseline is the chip's baseline and it sits on the line of the sentence */
    display: inline-block;
    padding: 0.06em 0.4em 0.06em 0.15em;
    line-height: var(--lh-tight);
    border-radius: var(--radius-pill);
    background: var(--color-tool-chip);
    vertical-align: baseline;
    white-space: nowrap;
    transition: background-color 0.2s ease-out;
  }

  /* Every logo is a circle; on hover it relaxes into the shape it was drawn with. */
  .tool :global(.tool__logo) {
    display: inline-block; /* the global reset makes images block, which would ignore vertical-align */
    width: 1.15em;
    height: 1.15em;
    margin-right: 0.26em;
    vertical-align: -0.2em;
    border-radius: 50%;
    object-fit: cover;
    transition:
      border-radius 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .tool:hover {
    background: var(--color-white);
  }

  /* ...and tips a few degrees, as if picked up. */
  .tool:hover :global(.tool__logo) {
    border-radius: 0;
    transform: rotate(-12deg);
  }

  /* The settle-in: each chip rises a little and fades up, a short beat after the one before it. */
  .stack[data-reveal='ready'] .tool {
    opacity: 0;
    transform: translateY(0.3em) scale(0.94);
  }

  .stack[data-reveal='go'] .tool {
    transition:
      opacity 0.6s var(--ease-out) calc(var(--i) * 70ms),
      transform 0.6s var(--ease-out) calc(var(--i) * 70ms),
      background-color 0.2s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .tool,
    .tool :global(.tool__logo) {
      transition: none;
    }

    .tool:hover :global(.tool__logo) {
      border-radius: 50%;
      transform: none;
    }
  }
</style>

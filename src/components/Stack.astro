---
import { Image } from 'astro:assets';
import { stack, tools } from '../data/content';
---

<section class="stack" id="stack" aria-labelledby="stack-title">
  <h2 id="stack-title" class="stack__title">{stack.title}</h2>

  <p class="stack__sentence">
    {stack.sentence.map((part) => {
      if (typeof part === 'string') return part;
      const tool = tools[part.tool];
      return (
        <span class="tool">
          {tool.logo ? (
            <Image class="tool__logo" src={tool.logo} alt="" width={64} height={64} widths={[32, 64, 96]} sizes="1.15em" />
          ) : (
            <span class="tool__logo tool__logo--initial" aria-hidden="true"><span>{tool.name[0]}</span></span>
          )}
          {tool.name}
        </span>
      );
    })}
  </p>
</section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-32);
    padding: var(--space-167) var(--gutter);
    text-align: center;
  }

  .stack__title {
    font-size: var(--fs-14);
    font-weight: var(--weight-medium);
    line-height: var(--lh-14-20);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stack__sentence {
    max-width: var(--stack-w);
    font-size: var(--fs-stack);
    font-weight: var(--weight-medium);
    line-height: 1.5;
    letter-spacing: var(--ls-title);
    color: var(--color-ink);
  }

  /* A tool: its logo and name in a soft pill that sits in the line of text */
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    padding: 0.02em 0.4em 0.02em 0.14em;
    border-radius: var(--radius-pill);
    background: var(--color-tool-chip);
    vertical-align: baseline;
    white-space: nowrap;
    transition: background-color 0.2s ease-out;
  }

  .tool:hover {
    background: var(--color-nav-active);
  }

  .tool :global(.tool__logo) {
    flex: none;
    width: 1.15em;
    height: 1.15em;
  }

  /* A tool without a logo file yet: its initial on a white tile, the size of a logo */
  .tool :global(.tool__logo--initial) {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.3em;
    background: var(--color-white);
    color: var(--color-ink);
    font-weight: var(--weight-bold);
    line-height: 1;
  }

  .tool__logo--initial span {
    font-size: 0.6em;
  }

  @media (prefers-reduced-motion: reduce) {
    .tool {
      transition: none;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import ArrowIcon from '../assets/icons/arrow-up-right.svg';

interface Props {
  number: string;
  theme: string;
  category: string;
  title: string;
  href: string;
  description: string;
  image: ImageMetadata;
  alt: string;
  place: { left: string; top: string; width: string; height: string };
  bleed?: boolean;
  index: number;
}

const { number, theme, category, title, href, description, image, alt, place, bleed = false, index } = Astro.props;
const themeVars = {
  yellow: '1',
  cream: '2',
  lilac: '3',
  mint: '4',
}[theme];
---

<article class="work" style={`--i: ${index}; --bg: var(--work-${themeVars}-bg); --panel: var(--work-${themeVars}-panel); --accent: var(--work-${themeVars}-accent);`}>
  <div class="work__tabrow">
    <div class="work__container work__container--tabs">
      <div class="work__tab">
        <p class="work__tab-label">Featured Work {number}</p>
      </div>
    </div>
  </div>
  <div class="work__body">
    <div class="work__container">
      <div class="work__inner">
      <div class:list={['work__panel', { 'work__panel--bleed': bleed }]}>
        <Image
          class="work__image"
          src={image}
          alt={alt}
          widths={[480, 720, 1080, 1440]}
          sizes="(max-width: 1024px) 100vw, 726px"
          quality={85}
          loading="eager"
          style={`left:${place.left};top:${place.top};width:${place.width};height:${place.height};`}
        />
      </div>
      <div class="work__text">
        <p class="work__category">{category}</p>
        <h2 class="work__title"><a class="work__link" href={href}>{title}</a></h2>
        <p class="work__description">{description}</p>
        <!-- The whole card is one link (see .work__link); this pill says so, and turns black with the card's hover. -->
        <p class="work__go" aria-hidden="true">
          View case
          <ArrowIcon />
        </p>
      </div>
      </div>
    </div>
  </div>
</article>

<style>
  /* The panel itself is full-bleed. Only .work__container constrains the content. */
  .work {
    width: 100%;
  }

  .work__container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* The row stays transparent: the page background shows beside the tab, above the body. */
  .work__tabrow {
    height: var(--work-tab-row);
  }

  .work__container--tabs {
    display: flex;
    height: 100%;
  }

  .work__tab {
    display: flex;
    align-items: center;
    flex: none;
    width: var(--work-tab-width);
    padding-left: var(--work-tab-pad);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--bg);
  }

  .work__tab-label {
    font-family: var(--font-display);
    font-size: var(--fs-tab);
    font-weight: var(--weight-light);
    line-height: var(--lh-tight);
    color: var(--accent);
  }

  .work__body {
    padding-block: var(--space-57);
    background: var(--bg);
  }

  .work__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--work-text-col);
    column-gap: var(--space-59);
    align-items: center;
    max-width: var(--work-inner-max);
  }

  .work__panel {
    position: relative;
    aspect-ratio: var(--work-panel-aspect);
    border-radius: var(--radius-panel);
    background: var(--panel);
  }

  .work__panel :global(.work__image) {
    position: absolute;
    max-width: none;
    object-fit: contain;
    object-position: center bottom;
    /* Default: the screens sit at 91% (371 / 409 in the design), a touch higher; hover brings them to full size. */
    transform: translateY(-1.3%) scale(0.907);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /*
   * Screenshots that run off the bottom of the panel stay glued to its bottom edge as they shrink and grow,
   * so the default state never shows their cut-off edge floating above the panel's bottom.
   */
  .work__panel--bleed :global(.work__image) {
    transform: scale(0.907);
    transform-origin: 50% 100%;
  }

  .work__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-18);
    min-width: 0;
  }

  .work__category {
    font-size: var(--fs-20);
    line-height: var(--lh-tight);
    color: var(--color-muted);
  }

  .work__title {
    font-family: var(--font-display);
    font-size: var(--fs-32);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    color: var(--color-ink);
    letter-spacing: var(--ls-heading);
    white-space: pre-line; /* a "\n" in a title is where it breaks */
  }

  /* One link covers the whole card, so the card is a single click target. */
  .work__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-panel);
  }

  .work__link:focus-visible {
    outline: none;
  }

  .work__link:focus-visible::after {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  /*
   * "This is clickable", as in the design's Default and Hover states: a white "View case" pill that turns black,
   * while the screens grow from 91% to full size. Always visible, so touch screens get it too.
   */
  .work__go {
    display: flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-12);
    height: var(--button-height);
    padding-inline: 25px 26px;
    border-radius: var(--radius-button);
    background: var(--color-white);
    color: var(--color-black);
    font-size: var(--fs-16);
    line-height: var(--lh-ui);
    transition:
      background-color 0.25s ease-out,
      color 0.25s ease-out;
  }

  .work__go :global(svg) {
    width: var(--space-16);
    height: var(--space-16);
    stroke-width: 1.5;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .work__inner:hover .work__go,
  .work__inner:has(.work__link:focus-visible) .work__go {
    background: var(--color-black);
    color: var(--color-white);
  }

  .work__inner:hover .work__go :global(svg),
  .work__inner:has(.work__link:focus-visible) .work__go :global(svg) {
    transform: translate(2px, -2px);
  }

  .work__inner:hover .work__panel :global(.work__image),
  .work__inner:has(.work__link:focus-visible) .work__panel :global(.work__image) {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .work__panel :global(.work__image),
    .work__go,
    .work__go :global(svg) {
      transition: none;
    }

    .work__inner:hover .work__go :global(svg),
    .work__inner:has(.work__link:focus-visible) .work__go :global(svg) {
      transform: none;
    }
  }

  .work__description {
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--color-black);
  }

  /*
   * Stacking panels. Pure CSS sticky: every panel shares one top offset, later panels paint
   * above earlier ones, and tab N is shifted right by N tab widths so earlier tabs stay visible.
   * Nothing above .work may set overflow or transform, or sticky silently stops working.
   */
  @media (min-width: 1025px) and (min-height: 600px) {
    .work {
      position: sticky;
      top: var(--stack-top);
      z-index: calc(var(--i) + 1);
    }

    .work__tab {
      margin-left: calc(var(--i) * var(--work-tab-width));
    }

    .work__body {
      min-height: var(--work-body-h);
    }

    .work__panel {
      width: var(--work-panel-w);
    }
  }

  @media (max-width: 1024px) {
    .work__inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-30);
      align-items: start;
    }

    .work__body {
      padding-block: var(--space-30) var(--space-57);
    }

    .work__text {
      max-width: var(--work-text-tablet-max);
    }
  }
</style>

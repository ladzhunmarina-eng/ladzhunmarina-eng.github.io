---
import { Image } from 'astro:assets';
import ArrowIcon from '../assets/icons/arrow-up-right.svg';

interface Props {
  number: string;
  theme: string;
  category: string;
  title: string;
  href: string;
  description: string;
  tags: string[];
  image: ImageMetadata;
  alt: string;
  place: { left: string; top: string; width: string; height: string };
  index: number;
}

const { number, theme, category, title, href, description, tags, image, alt, place, index } = Astro.props;
const themeVars = {
  yellow: '1',
  cream: '2',
  lilac: '3',
  mint: '4',
}[theme];
---

<article class="work" style={`--i: ${index}; --bg: var(--work-${themeVars}-bg); --panel: var(--work-${themeVars}-panel); --accent: var(--work-${themeVars}-accent);`}>
  <div class="work__tabrow">
    <div class="work__container work__container--tabs">
      <div class="work__tab">
        <p class="work__tab-label">Featured Work {number}</p>
      </div>
    </div>
  </div>
  <div class="work__body">
    <div class="work__container">
      <div class="work__inner">
      <div class="work__panel">
        <Image
          class="work__image"
          src={image}
          alt={alt}
          widths={[480, 720, 1080, 1440]}
          sizes="(max-width: 1024px) 100vw, 726px"
          quality={85}
          loading="eager"
          style={`left:${place.left};top:${place.top};width:${place.width};height:${place.height};`}
        />
      </div>
      <div class="work__text">
        <p class="work__category">{category}</p>
        <h2 class="work__title"><a class="work__link" href={href}>{title}</a></h2>
        <p class="work__description">{description}</p>
        <ul class="work__tags" aria-label="Focus areas">
          {tags.map((tag) => <li class="work__tag">{tag}</li>)}
        </ul>
        <!-- The whole card is one link (see .work__link); this just says so, and lights up with the card. -->
        <p class="work__go" aria-hidden="true">
          <span class="work__go-label">View case</span>
          <span class="work__go-arrow"><ArrowIcon /></span>
        </p>
      </div>
      </div>
    </div>
  </div>
</article>

<style>
  /* The panel itself is full-bleed. Only .work__container constrains the content. */
  .work {
    width: 100%;
  }

  .work__container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* The row stays transparent: the page background shows beside the tab, above the body. */
  .work__tabrow {
    height: var(--work-tab-row);
  }

  .work__container--tabs {
    display: flex;
    height: 100%;
  }

  .work__tab {
    display: flex;
    align-items: center;
    flex: none;
    width: var(--work-tab-width);
    padding-left: var(--work-tab-pad);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--bg);
  }

  .work__tab-label {
    font-family: var(--font-display);
    font-size: var(--fs-tab);
    font-weight: var(--weight-light);
    line-height: var(--lh-24);
    letter-spacing: var(--ls-24);
    color: var(--accent);
  }

  .work__body {
    padding-block: var(--space-57);
    background: var(--bg);
  }

  .work__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--work-text-col);
    column-gap: var(--space-59);
    align-items: end;
    max-width: var(--work-inner-max);
  }

  .work__panel {
    position: relative;
    aspect-ratio: var(--work-panel-aspect);
    border-radius: var(--radius-panel);
    background: var(--panel);
  }

  .work__panel :global(.work__image) {
    position: absolute;
    max-width: none;
    object-fit: contain;
    object-position: center bottom;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .work__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
  }

  .work__category {
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
    color: var(--color-muted);
  }

  .work__title {
    font-family: var(--font-display);
    font-size: var(--fs-32);
    font-weight: var(--weight-extrabold);
    line-height: var(--lh-32);
    letter-spacing: var(--ls-0);
    color: var(--color-ink);
  }

  /* One link covers the whole card, so the card is a single click target. */
  .work__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-panel);
  }

  .work__link:focus-visible {
    outline: none;
  }

  .work__link:focus-visible::after {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  /* ---------- "This is clickable" ---------- */

  /* A call to action that is always visible (touch screens have no hover): label plus a round arrow. */
  .work__go {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    margin-top: var(--space-20);
    color: var(--accent);
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-medium);
  }

  .work__go-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--work-go-size);
    height: var(--work-go-size);
    border: 1px solid var(--accent);
    border-radius: 50%;
    transition:
      background-color 0.25s ease-out,
      color 0.25s ease-out,
      transform 0.25s ease-out;
  }

  .work__go-arrow :global(svg) {
    width: var(--space-20);
    height: var(--space-20);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* On hover (or keyboard focus) the card answers: the screens rise, the title underlines, the arrow fills. */
  .work__inner:hover .work__panel :global(.work__image),
  .work__inner:has(.work__link:focus-visible) .work__panel :global(.work__image) {
    transform: translateY(calc(-1 * var(--space-8))) scale(1.015);
  }

  .work__inner:hover .work__link,
  .work__inner:has(.work__link:focus-visible) .work__link {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .work__inner:hover .work__go-arrow,
  .work__inner:has(.work__link:focus-visible) .work__go-arrow {
    background: var(--accent);
    color: var(--bg);
  }

  .work__inner:hover .work__go-arrow :global(svg),
  .work__inner:has(.work__link:focus-visible) .work__go-arrow :global(svg) {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .work__panel :global(.work__image),
    .work__go-arrow :global(svg) {
      transition: none;
    }

    .work__inner:hover .work__panel :global(.work__image),
    .work__inner:has(.work__link:focus-visible) .work__panel :global(.work__image),
    .work__inner:hover .work__go-arrow :global(svg),
    .work__inner:has(.work__link:focus-visible) .work__go-arrow :global(svg) {
      transform: none;
    }
  }

  .work__description {
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    letter-spacing: var(--ls-20);
    color: var(--color-black);
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-20);
    padding-top: var(--space-12);
    color: var(--accent);
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    letter-spacing: var(--ls-16);
  }

  .work__tag {
    display: flex;
    align-items: center;
    gap: var(--space-20);
  }

  .work__tag + .work__tag::before {
    content: '';
    width: var(--tag-rule-width);
    height: var(--tag-rule-height);
    background: var(--accent);
  }

  /*
   * Stacking panels. Pure CSS sticky: every panel shares one top offset, later panels paint
   * above earlier ones, and tab N is shifted right by N tab widths so earlier tabs stay visible.
   * Nothing above .work may set overflow or transform, or sticky silently stops working.
   */
  @media (min-width: 1025px) and (min-height: 600px) {
    .work {
      position: sticky;
      top: var(--stack-top);
      z-index: calc(var(--i) + 1);
    }

    .work__tab {
      margin-left: calc(var(--i) * var(--work-tab-width));
    }

    .work__body {
      min-height: var(--work-body-h);
    }

    .work__panel {
      width: var(--work-panel-w);
    }
  }

  @media (max-width: 1024px) {
    .work__inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-30);
      align-items: start;
    }

    .work__body {
      padding-block: var(--space-30) var(--space-57);
    }

    .work__text {
      max-width: var(--work-text-tablet-max);
    }
  }

  /* Tags wrap on narrow screens; a rule at the start of a wrapped line looks broken, so drop the rules. */
  @media (max-width: 640px) {
    .work__tags {
      column-gap: var(--space-16);
    }

    .work__tag + .work__tag::before {
      display: none;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CaseBack from '../../components/case/CaseBack.astro';
import CaseHero from '../../components/case/CaseHero.astro';
import CaseNav from '../../components/case/CaseNav.astro';
import Section from '../../components/case/Section.astro';
import NoteCards from '../../components/case/NoteCards.astro';
import ProcessChart from '../../components/case/ProcessChart.astro';
import PersonaPair from '../../components/case/PersonaPair.astro';
import ScreensShowcase from '../../components/case/ScreensShowcase.astro';
import PhoneDecision from '../../components/case/PhoneDecision.astro';
import OnboardingDemo from '../../components/case/OnboardingDemo.astro';
import TrackerDemo from '../../components/case/TrackerDemo.astro';
import StatsDemo from '../../components/case/StatsDemo.astro';
import WatchDemo from '../../components/case/WatchDemo.astro';
import ClientsDemo from '../../components/case/ClientsDemo.astro';
import ThemeShowcase from '../../components/case/ThemeShowcase.astro';
import Reviews from '../../components/case/Reviews.astro';
import NextCase from '../../components/case/NextCase.astro';
import heroImage from '../../assets/images/sleep-hero-flat.png';
import personaPhoto from '../../assets/images/sleep-persona.png';
import expertPhoto from '../../assets/images/persona-expert.webp';
import signup from '../../assets/images/sleep-signup.png';
import settings from '../../assets/images/car-01.png';
import plan from '../../assets/images/car-02.png';
import empty from '../../assets/images/car-03.png';
import child from '../../assets/images/car-04-save.png';
import trendA from '../../assets/images/car-05.png';
import share from '../../assets/images/car-06.png';
import archived from '../../assets/images/car-07.png';
import calendar from '../../assets/images/car-08.png';
import trendB from '../../assets/images/car-09.png';
import tracker from '../../assets/images/car-10.png';
import { babySleepCase as study } from '../../data/cases/baby-sleep';

const { goal, persona, process, screens, decisions, theme, feedback } = study;
const shots = { signup, settings, plan, empty, child, trendA, share, archived, calendar, trendB, tracker };
const gallery = screens.items.map((item) => ({ src: shots[item.key as keyof typeof shots], alt: item.alt }));
const alts: Record<string, string> = {
  signup: 'Sign-up start: choose Parent or Consultant, or log in.',
  tracker: 'The day view of sleep with totals, a night sleep block and a start button.',
  clients: 'The consultant’s empty client list with a sleeping baby and a button to add a client.',
  trend: 'Weekly statistics as a trend chart of day, night and total sleep with averages.',
  watch: 'The Apple Watch home screen with the app icon.',
};
const blocks = decisions.items.map((item) => ({
  ...item,
  phones: item.phones.map((key) => ({ src: shots[key as keyof typeof shots], alt: alts[key] })),
}));
---

<Layout title={study.seo.title} description={study.seo.description} current="work">
  <article class="case" data-case-palette="sleep">
    <div class="case__container case__top">
      <div class="case__intro">
        <CaseBack />
        <CaseHero hero={study.hero} />
      </div>
      <div class="showcase">
        <Image class="showcase__image" src={heroImage} alt={study.hero.image} widths={[640, 960, 1280]} sizes="(max-width: 1023px) 100vw, 640px" quality={85} loading="eager" />
      </div>
    </div>

    <div class="case__container case__main">
      <CaseNav items={study.nav} />

      <div class="case__sections">
        <Section id="goal" eyebrow={goal.eyebrow} title={goal.title} lead={goal.lead}>
          <NoteCards cards={goal.cards} />
        </Section>

        <Section id="process" eyebrow={process.eyebrow} title={process.title}>
          <ProcessChart phases={process.phases} bars={process.bars} stepped />
        </Section>

        <Section id="persona" eyebrow={persona.eyebrow} title={persona.title} lead={persona.lead}>
          <PersonaPair personas={persona.cards.map((card) => ({ ...card, photo: card.photo === 'expert' ? expertPhoto : personaPhoto }))} />
        </Section>

        <Section id="decisions" eyebrow={decisions.eyebrow} title={decisions.title} lead={decisions.lead}>
          <div class="decisions">
            {blocks.map((block, i) => (
              <PhoneDecision index={i + 1} tags={block.tags} title={block.title} description={block.description} phones={block.phones}>
                {block.demo === 'onboarding' && (
                  <div class="demo">
                    <OnboardingDemo alt={alts.signup} />
                  </div>
                )}
                {block.demo === 'watch' && (
                  <div class="demo demo--watch">
                    <WatchDemo alt={alts.watch} />
                  </div>
                )}
                {block.demo === 'clients' && (
                  <div class="demo">
                    <ClientsDemo alt={alts.clients} />
                  </div>
                )}
                {block.demo === 'stats' && (
                  <div class="demo">
                    <StatsDemo alt={alts.trend} />
                  </div>
                )}
                {block.demo === 'tracker' && (
                  <div class="demo">
                    <TrackerDemo alt={alts.tracker} />
                  </div>
                )}
              </PhoneDecision>
            ))}
          </div>
        </Section>

        <ThemeShowcase id="theme" eyebrow={theme.eyebrow} tags={theme.tags} title={theme.title} lead={theme.lead} alts={theme.alts} />

        <Section id="feedback" eyebrow={feedback.eyebrow} title={feedback.title}>
          <Reviews rating={feedback.rating} reviews={feedback.reviews} />
        </Section>

      </div>
    </div>

    <ScreensShowcase id="screens" pill={screens.pill} title={screens.title} lead={screens.lead} screens={gallery} />

    <div class="case__container case__after">
      <NextCase current="/work/baby-sleep" />
    </div>
  </article>
</Layout>

<style>
  .case {
    background: var(--case-page);
  }

  .case__container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .case__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding-top: calc(var(--header-h) + var(--space-8) + var(--case-top-shift));
  }

  .case__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  /* The two phones sit on a panel the width of the column. */
  .showcase {
    display: flex;
    justify-content: center;
    padding: var(--space-32);
    border-radius: var(--radius-card);
    background: var(--sleep-mist);
  }

  .showcase :global(.showcase__image) {
    width: min(100%, 500px);
    height: auto;
  }

  .case__main {
    display: grid;
    grid-template-columns: var(--case-nav-w) minmax(0, 1fr);
    gap: var(--case-gap);
    padding-block: var(--case-section-gap);
  }

  /* The next case sits under the content column, as it did inside it */
  .case__after {
    padding-block: var(--case-section-gap) var(--space-144);
    padding-left: calc(var(--gutter) + var(--case-nav-w) + var(--case-gap));
  }

  .case__sections {
    display: flex;
    flex-direction: column;
    gap: var(--case-section-gap);
    min-width: 0;
  }

  .demo {
    width: 280px;
    max-width: 100%;
  }

  .demo--watch {
    width: 220px;
    max-width: 100%;
  }

  .decisions {
    display: flex;
    flex-direction: column;
    gap: var(--space-80);
  }

  @media (max-width: 1023px) {
    .case__main {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-32);
      padding-block: var(--space-56) var(--space-92);
    }

    .case__sections {
      gap: var(--space-80);
    }

    .case__after {
      padding-block: var(--space-56) var(--space-92);
      padding-left: var(--gutter);
    }
  }
</style>

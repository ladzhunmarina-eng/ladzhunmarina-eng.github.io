---
import Layout from '../../layouts/Layout.astro';
import CaseBack from '../../components/case/CaseBack.astro';
import CaseHero from '../../components/case/CaseHero.astro';
import CaseNav from '../../components/case/CaseNav.astro';
import Section from '../../components/case/Section.astro';
import NoteCards from '../../components/case/NoteCards.astro';
import PersonaPair from '../../components/case/PersonaPair.astro';
import VisualGrid from '../../components/case/VisualGrid.astro';
import NextCase from '../../components/case/NextCase.astro';
import CloutboostDashboard from '../../components/case/CloutboostDashboard.astro';
import anna from '../../assets/images/cb-persona.png';
import channel from '../../assets/images/cb-v01-channel.png';
import building from '../../assets/images/cb-v02-building.png';
import views from '../../assets/images/cb-v03-views.png';
import performance from '../../assets/images/cb-v04-performance.png';
import email from '../../assets/images/cb-v05-email.png';
import importFile from '../../assets/images/cb-v06-import.png';
import comments from '../../assets/images/cb-v07-comments.png';
import empty from '../../assets/images/cb-v08-empty.png';
import filters from '../../assets/images/cb-v09-filters.png';
import table from '../../assets/images/cb-v10-table.png';
import { cloutboostCase as study } from '../../data/cases/cloutboost';

const { goal, persona, visuals } = study;
const shots = { channel, building, views, performance, email, import: importFile, comments, empty, filters, table };
const groups = visuals.groups.map((group) => ({
  ...group,
  tiles: group.tiles.map((tile) => ({ src: shots[tile.key as keyof typeof shots], alt: tile.alt, cols: tile.cols })),
}));
const personas = persona.cards.map((card) => ({ ...card, photo: anna }));
---

<Layout title={study.seo.title} description={study.seo.description} current="work">
  <article class="case" data-case-palette="cloutboost">
    <div class="case__container case__top">
      <div class="case__intro">
        <CaseBack />
        <CaseHero hero={study.hero} />
      </div>
      <CloutboostDashboard alt={study.hero.image} hint="Scroll inside to explore the report" />
    </div>

    <div class="case__container case__main">
      <CaseNav items={study.nav} />

      <div class="case__sections">
        <Section id="goal" eyebrow={goal.eyebrow} title={goal.title} lead={goal.lead}>
          <NoteCards cards={goal.cards} />
        </Section>

        <Section id="persona" eyebrow={persona.eyebrow} title={persona.title}>
          <PersonaPair personas={personas} />
          <p class="also"><span class="also__label">Also used by:</span> {persona.alsoUsedBy}</p>
        </Section>

        <Section id="visuals" eyebrow={visuals.eyebrow} title={visuals.title}>
          <div class="groups">
            {groups.map((group) => (
              <section class="group" style={`--span: ${group.span}`} aria-labelledby={`visuals-${group.title.toLowerCase().replace(/\s+/g, '-')}`}>
                <header class="group__head">
                  <h3 class="group__title" id={`visuals-${group.title.toLowerCase().replace(/\s+/g, '-')}`}>{group.title}</h3>
                  <p class="group__caption">{group.caption}</p>
                </header>
                <VisualGrid tiles={group.tiles} />
              </section>
            ))}
          </div>
        </Section>
      </div>
    </div>

    <div class="case__container case__after">
      <NextCase current="/work/cloutboost" />
    </div>
  </article>
</Layout>

<style>
  .case {
    background: var(--case-page);
  }

  .case__container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .case__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding-top: calc(var(--header-h) + var(--space-8) + var(--case-top-shift));
  }

  .case__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .case__main {
    display: grid;
    grid-template-columns: var(--case-nav-w) minmax(0, 1fr);
    gap: var(--case-gap);
    padding-block: var(--case-section-gap);
  }

  .case__sections {
    display: flex;
    flex-direction: column;
    gap: var(--case-section-gap);
    min-width: 0;
  }

  /* The next case sits under the content column */
  .case__after {
    padding-block: 0 var(--space-144);
    padding-left: calc(var(--gutter) + var(--case-nav-w) + var(--case-gap));
  }

  .also {
    max-width: var(--case-measure);
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  .also__label {
    font-weight: var(--weight-bold);
    color: var(--color-ink);
  }

  /* The screens grouped by the step of the work; Reach out and Collaborate share a row */
  .groups {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-56) var(--space-16);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    grid-column: span var(--span);
    min-width: 0;
  }

  .group__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .group__title {
    font-size: var(--fs-20);
    font-weight: var(--weight-bold);
    line-height: var(--lh-snug);
    color: var(--color-ink);
  }

  .group__caption {
    font-size: var(--fs-14);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  @media (max-width: 1023px) {
    .case__main {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-32);
      padding-block: var(--space-56) var(--space-56);
    }

    .case__sections {
      gap: var(--space-80);
    }

    .case__after {
      padding-block: 0 var(--space-92);
      padding-left: var(--gutter);
    }

    .group {
      grid-column: 1 / -1;
    }
  }
</style>

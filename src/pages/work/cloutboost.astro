---
import Layout from '../../layouts/Layout.astro';
import CaseBack from '../../components/case/CaseBack.astro';
import CaseHero from '../../components/case/CaseHero.astro';
import CaseNav from '../../components/case/CaseNav.astro';
import Section from '../../components/case/Section.astro';
import NoteCards from '../../components/case/NoteCards.astro';
import PersonaPair from '../../components/case/PersonaPair.astro';
import FindInfluencersDemo from '../../components/case/FindInfluencersDemo.astro';
import CreateCampaignDemo from '../../components/case/CreateCampaignDemo.astro';
import SelectedInfluencersDemo from '../../components/case/SelectedInfluencersDemo.astro';
import EngagementDemo from '../../components/case/EngagementDemo.astro';
import ReportsDemo from '../../components/case/ReportsDemo.astro';
import DesignSystemCollage from '../../components/case/DesignSystemCollage.astro';
import MetricStrip from '../../components/case/MetricStrip.astro';
import StatGrid from '../../components/case/StatGrid.astro';
import NextCase from '../../components/case/NextCase.astro';
import CloutboostDashboard from '../../components/case/CloutboostDashboard.astro';
import { Image } from 'astro:assets';
import anna from '../../assets/images/cb-persona.png';
import gamers from '../../assets/images/cb-gamers.jpg';
import { cloutboostCase as study } from '../../data/cases/cloutboost';

const { goal, persona, flow, campaign, selected, engagement, reports, outcome, system } = study;
// Jake's photo, picked up if the file is there; without it his card shows his initials
const creatorPhoto =Object.values(import.meta.glob<ImageMetadata>('../../assets/images/cb-persona-creator.png', { eager: true, import: 'default' }))[0];
const personas = persona.cards.map((card) => ({ ...card, photo: card.photo === 'creator' ? creatorPhoto : anna }));
---

<Layout title={study.seo.title} description={study.seo.description} current="work">
  <article class="case" data-case-palette="cloutboost">
    <div class="case__container case__top">
      <div class="case__intro">
        <CaseBack />
        <CaseHero hero={study.hero} />
      </div>
      <CloutboostDashboard alt={study.hero.image} hint="Scroll inside to explore the report" />
    </div>

    <div class="case__container case__main">
      <CaseNav items={study.nav} />

      <div class="case__sections">
        <Section id="goal" eyebrow={goal.eyebrow} title={goal.title} lead={goal.lead}>
          <NoteCards cards={goal.cards} />
          <Image class="case__photo" src={gamers} alt={goal.image} widths={[720, 1008, 1512, 2016]} sizes="(max-width: 1023px) 100vw, 1008px" quality={85} />
        </Section>

        <Section id="persona" eyebrow={persona.eyebrow} title={persona.title}>
          <PersonaPair personas={personas} />
        </Section>

        <Section id="flow" index="01" eyebrow={flow.eyebrow} title={flow.title} lead={flow.lead}>
          <FindInfluencersDemo alt={flow.alt} />
        </Section>

        <Section id="campaign" index="02" eyebrow={campaign.eyebrow} title={campaign.title} lead={campaign.lead}>
          <CreateCampaignDemo alt={campaign.alt} />
        </Section>

        <Section id="selected" index="03" eyebrow={selected.eyebrow} title={selected.title} lead={selected.lead}>
          <SelectedInfluencersDemo alt={selected.alt} />
        </Section>

        <Section id="engagement" index="04" eyebrow={engagement.eyebrow} title={engagement.title} lead={engagement.lead}>
          <EngagementDemo alt={engagement.alt} />
        </Section>

        <Section id="reports" index="05" eyebrow={reports.eyebrow} title={reports.title} lead={reports.lead}>
          <ReportsDemo alt={reports.alt} />
        </Section>

        <Section id="outcome" eyebrow={outcome.eyebrow} title={outcome.title} lead={outcome.lead}>
          <MetricStrip metrics={study.impact} />
          <StatGrid stats={outcome.stats} />
        </Section>

        <Section id="system" eyebrow={system.eyebrow} title={system.title} lead={system.lead}>
          <DesignSystemCollage alt={system.alt} />
        </Section>
      </div>
    </div>

    <div class="case__container case__after">
      <NextCase current="/work/cloutboost" />
    </div>
  </article>
</Layout>

<style>
  .case {
    background: var(--case-page);
  }

  .case__container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .case__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding-top: calc(var(--header-h) + var(--space-8) + var(--case-top-shift));
  }

  .case__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .case__main {
    display: grid;
    grid-template-columns: var(--case-nav-w) minmax(0, 1fr);
    gap: var(--case-gap);
    padding-block: var(--case-section-gap);
  }

  .case__sections {
    display: flex;
    flex-direction: column;
    gap: var(--case-section-gap);
    min-width: 0;
  }

  /* A picture across the content column, with the cards' corners */
  .case :global(.case__photo) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-block);
  }

  /* The next case sits under the content column */
  .case__after {
    padding-block: 0 var(--space-144);
    padding-left: calc(var(--gutter) + var(--case-nav-w) + var(--case-gap));
  }

  @media (max-width: 1023px) {
    .case__main {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-32);
      padding-block: var(--space-56) var(--space-56);
    }

    .case__sections {
      gap: var(--space-80);
    }

    .case__after {
      padding-block: 0 var(--space-92);
      padding-left: var(--gutter);
    }
  }
</style>

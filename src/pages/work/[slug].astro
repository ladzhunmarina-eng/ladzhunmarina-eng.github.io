---
import Layout from '../../layouts/Layout.astro';
import CaseBack from '../../components/case/CaseBack.astro';
import CaseHero from '../../components/case/CaseHero.astro';
import MetricStrip from '../../components/case/MetricStrip.astro';
import CaseNav from '../../components/case/CaseNav.astro';
import Section from '../../components/case/Section.astro';
import SubSection from '../../components/case/SubSection.astro';
import StatGrid from '../../components/case/StatGrid.astro';
import Persona from '../../components/case/Persona.astro';
import ProcessChart from '../../components/case/ProcessChart.astro';
import SurveyBars from '../../components/case/SurveyBars.astro';
import VariantCompare from '../../components/case/VariantCompare.astro';
import ParticipantCards from '../../components/case/ParticipantCards.astro';
import MazeResults from '../../components/case/MazeResults.astro';
import EntryPoints from '../../components/case/EntryPoints.astro';
import BeforeAfter from '../../components/case/BeforeAfter.astro';
import LearningCards from '../../components/case/LearningCards.astro';
import CaseCover from '../../components/case/CaseCover.astro';
import CasePhoto from '../../components/case/CasePhoto.astro';
import ImageSlot from '../../components/case/ImageSlot.astro';
import BasketScreens from '../../components/case/BasketScreens.astro';
import MazeLogo from '../../assets/icons/maze.svg';
import problemPhoto from '../../assets/images/olx-problem.jpg';
import mazeShot from '../../assets/images/olx-maze.png';
import { cases } from '../../data/cases';
import { work } from '../../data/content';

export function getStaticPaths() {
  return cases.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props;

// A case with its own brand colours uses that palette (OLX does); otherwise the accent is the case's theme,
// the same --work-N-* set its Featured Work card uses. Palettes live in tokens.css.
const brandPalettes: Record<string, string> = { olx: 'olx' };
const themeIndex = { yellow: '1', cream: '2', lilac: '3', mint: '4' }[study.theme];
const palette = brandPalettes[study.slug] ?? `work-${themeIndex}`;

const { basket, delivery } = study;

// The cover reuses the screens of the case's Featured Work card.
const card = work.find((item) => item.href === `/work/${study.slug}`);
---

<Layout title={study.seo.title} description={study.seo.description} current="work">
  <article class="case" data-case-palette={palette}>
    <div class="case__container case__top">
      <div class="case__intro">
        <CaseBack />
        <CaseHero hero={study.hero} />
      </div>
      {card ? <CaseCover src={card.image} alt={card.alt} /> : <ImageSlot label="Cover image" ratio="1272 / 670" />}
      <MetricStrip metrics={study.metrics} />
    </div>

    <div class="case__container case__main">
      <CaseNav items={study.nav} />

      <div class="case__sections">
        <Section id="problem" eyebrow={study.problem.eyebrow} title={study.problem.title} lead={study.problem.lead}>
          <StatGrid stats={study.problem.stats} />
          <CasePhoto src={problemPhoto} alt={study.problem.photoAlt} />
          <Persona persona={study.problem.persona} />
        </Section>

        <Section id="role" eyebrow={study.role.eyebrow} title={study.role.title}>
          <ul class="bullets">
            {study.role.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </Section>

        <Section id="process" eyebrow={study.process.eyebrow} title={study.process.title}>
          <ProcessChart phases={study.process.phases} bars={study.process.bars} />
        </Section>

        <Section id="basket" eyebrow={basket.eyebrow} title={basket.title}>
          <SubSection title={basket.survey.title}>
            <SurveyBars question={basket.survey.question} groups={basket.survey.groups} insight={basket.survey.insight} />
          </SubSection>

          <SubSection title={basket.buttonTest.title} lead={basket.buttonTest.lead}>
            <VariantCompare
              variants={basket.buttonTest.variants}
              metrics={[
                { key: 'checkout', label: 'Checkout rate' },
                { key: 'bundle', label: 'Bundle rate' },
              ]}
            />
          </SubSection>

          <SubSection title={basket.moderatedTest.title} lead={basket.moderatedTest.method}>
            <ParticipantCards participants={basket.moderatedTest.participants} patterns={basket.moderatedTest.patterns} />
          </SubSection>

          <SubSection title={basket.usability.title}>
            <MazeLogo slot="aside" class="maze-logo" role="img" aria-label="Maze" />
            <p class="note">{basket.usability.method}</p>
            <MazeResults
              image={mazeShot}
              imageAlt={basket.usability.imageAlt}
              umux={basket.usability.umux}
              responses={basket.usability.responses}
              painPoints={basket.usability.painPoints}
            />
          </SubSection>

          <SubSection title={basket.entryTest.title} lead={basket.entryTest.lead}>
            <EntryPoints variants={basket.entryTest.variants} />
          </SubSection>

          <BasketScreens title={basket.screens.title} lead={basket.screens.lead} shots={basket.screens.shots} />
        </Section>

        <Section id="delivery" eyebrow={delivery.eyebrow} title={delivery.title}>
          <SubSection title={delivery.seller.title} lead={delivery.seller.text}>
            <StatGrid stats={delivery.seller.stats} />
            <ImageSlot label="Seller settings: free delivery and carriers" ratio="1008 / 567" />
          </SubSection>

          <SubSection title={delivery.buyer.title}>
            <BeforeAfter
              before={delivery.buyer.before}
              after={delivery.buyer.after}
              beforeSlot="Carrier picker before"
              afterSlot="Carrier picker after, free option first"
            />
            <StatGrid stats={delivery.buyer.results} />
            <p class="note">{delivery.buyer.resultNote}</p>
          </SubSection>
        </Section>

        <Section id="learnings" eyebrow={study.learnings.eyebrow} title={study.learnings.title}>
          <LearningCards items={study.learnings.items} next={study.next.text} />
        </Section>
      </div>
    </div>
  </article>
</Layout>

<style>
  .case {
    background: var(--case-page);
  }

  .case__container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .case__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    /* The back link sits in the space above the hero; the whole block is lowered by --case-top-shift. */
    padding-top: calc(var(--header-h) + var(--space-8) + var(--case-top-shift));
  }

  .case__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .case__main {
    display: grid;
    grid-template-columns: var(--case-nav-w) minmax(0, 1fr);
    gap: var(--case-gap);
    padding-block: var(--case-section-gap) var(--space-144);
  }

  .case__sections {
    display: flex;
    flex-direction: column;
    gap: var(--case-section-gap);
    min-width: 0;
  }

  .bullets {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--case-measure);
    padding-left: var(--space-24);
    list-style: disc;
    font-size: var(--fs-18);
    line-height: var(--lh-body);
  }

  .note {
    max-width: var(--case-measure);
    font-size: var(--fs-14);
    line-height: var(--lh-14-20);
    color: var(--color-muted);
  }

  .maze-logo {
    flex: none;
    width: var(--case-maze-logo-w);
    height: auto;
    color: var(--color-black);
  }

  @media (max-width: 1023px) {
    .case__main {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-32);
      padding-block: var(--space-56) var(--space-92);
    }

    .case__sections {
      gap: var(--space-80);
    }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import CaseBack from '../../components/case/CaseBack.astro';
import CaseHero from '../../components/case/CaseHero.astro';
import CaseNav from '../../components/case/CaseNav.astro';
import Section from '../../components/case/Section.astro';
import ChallengeCards from '../../components/case/ChallengeCards.astro';
import ProcessChart from '../../components/case/ProcessChart.astro';
import CasePhoto from '../../components/case/CasePhoto.astro';
import QuoteCard from '../../components/case/QuoteCard.astro';
import DecisionBlock from '../../components/case/DecisionBlock.astro';
import RosterMenuDemo from '../../components/case/RosterMenuDemo.astro';
import ShotFrame from '../../components/case/ShotFrame.astro';
import DashboardWindow from '../../components/case/DashboardWindow.astro';
import BeforeAfterCards from '../../components/case/BeforeAfterCards.astro';
import quotePhoto from '../../assets/images/erma-quote.webp';
import TimesheetUploadDemo from '../../components/case/TimesheetUploadDemo.astro';
import NextCase from '../../components/case/NextCase.astro';
import { ermaCase as study } from '../../data/cases/erma';

const { problem, challenge, process, decisions, outcome } = study;

---

<Layout title={study.seo.title} description={study.seo.description} current="work">
  <article class="case" data-case-palette="erma">
    <div class="case__container case__top">
      <div class="case__intro">
        <CaseBack />
        <CaseHero hero={study.hero} />
      </div>
      <DashboardWindow eager blurLogo hint="Scroll inside to explore the dashboard" />
    </div>

    <div class="case__container case__main">
      <CaseNav items={study.nav} />

      <div class="case__sections">
        <Section id="problem" eyebrow={problem.eyebrow} title={problem.title} lead={problem.lead}>
          <CasePhoto src={quotePhoto} alt="A lineman in an orange storm jacket on the phone in a truck cab, bucket trucks working on a flooded road ahead" />
          <QuoteCard text={problem.quote.text} source={problem.quote.source} />
        </Section>

        <Section id="challenge" eyebrow={challenge.eyebrow} title={challenge.title} lead={challenge.lead}>
          <ChallengeCards cards={challenge.cards} />
        </Section>

        <Section id="process" eyebrow={process.eyebrow} title={process.title}>
          <ProcessChart phases={process.phases} bars={process.bars} />
        </Section>

        <Section id="decisions" eyebrow={decisions.eyebrow} title={decisions.title} lead={decisions.lead}>
          <div class="decisions">
            <DecisionBlock
              id="decision-roster"
              index={decisions.roster.index}
              tags={decisions.roster.tags}
              title={decisions.roster.title}
              description={decisions.roster.description}
            >
              <Fragment slot="media">
                <RosterMenuDemo alt={decisions.roster.listAlt} menuAlt={decisions.roster.menuAlt} detailAlt={decisions.roster.detailAlt} resourcesAlt={decisions.roster.resourcesAlt} overviewAlt={decisions.roster.overviewAlt} />
              </Fragment>
            </DecisionBlock>

            <DecisionBlock
              id="decision-dashboard"
              index={decisions.dashboard.index}
              tags={decisions.dashboard.tags}
              title={decisions.dashboard.title}
              description={decisions.dashboard.description}
            >
              <Fragment slot="media">
                <DashboardWindow blurLogo parts={decisions.dashboard.parts} viewHeight={1025} showParts={false} autoScroll />
              </Fragment>
            </DecisionBlock>

            <DecisionBlock
              id="decision-timesheets"
              index={decisions.timesheets.index}
              tags={decisions.timesheets.tags}
              title={decisions.timesheets.title}
              description={decisions.timesheets.description}
            >
              <Fragment slot="media">
                <TimesheetUploadDemo alt={decisions.timesheets.alt} />
              </Fragment>
            </DecisionBlock>
          </div>
        </Section>

        <Section id="outcome" eyebrow={outcome.eyebrow} title={outcome.title} lead={outcome.lead}>
          <BeforeAfterCards cards={outcome.cards} />
        </Section>

        <NextCase current="/work/erma" />
      </div>
    </div>
  </article>
</Layout>

<style>
  .case {
    background: var(--case-page);
  }

  .case__container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .case__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    /* The back link sits in the space above the hero; the whole block is lowered by --case-top-shift. */
    padding-top: calc(var(--header-h) + var(--space-8) + var(--case-top-shift));
  }

  .case__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .case__main {
    display: grid;
    grid-template-columns: var(--case-nav-w) minmax(0, 1fr);
    gap: var(--case-gap);
    padding-block: var(--case-section-gap) var(--space-144);
  }

  .case__sections {
    display: flex;
    flex-direction: column;
    gap: var(--case-section-gap);
    min-width: 0;
  }

  .decisions {
    display: flex;
    flex-direction: column;
    gap: var(--space-92);
  }

  @media (max-width: 1023px) {
    .case__main {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-32);
      padding-block: var(--space-56) var(--space-92);
    }

    .case__sections {
      gap: var(--space-80);
    }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import CaseBack from '../../components/case/CaseBack.astro';
import CaseHero from '../../components/case/CaseHero.astro';
import CaseNav from '../../components/case/CaseNav.astro';
import Section from '../../components/case/Section.astro';
import FlowSteps from '../../components/case/FlowSteps.astro';
import NoteCards from '../../components/case/NoteCards.astro';
import QuoteCard from '../../components/case/QuoteCard.astro';
import ColumnLists from '../../components/case/ColumnLists.astro';
import RoleGroups from '../../components/case/RoleGroups.astro';
import StageCompare from '../../components/case/StageCompare.astro';
import DecisionBlock from '../../components/case/DecisionBlock.astro';
import ShotFrame from '../../components/case/ShotFrame.astro';
import MissingScreen from '../../components/case/MissingScreen.astro';
import DashboardWindow from '../../components/case/DashboardWindow.astro';
import OutcomeCards from '../../components/case/OutcomeCards.astro';
import rostersList from '../../assets/images/erma-rosters-list.png';
import rosterResources from '../../assets/images/erma-roster-resources.png';
import quotePhoto from '../../assets/images/erma-quote.webp';
import vUpload from '../../assets/images/erma-v-upload.png';
import vAttachment from '../../assets/images/erma-v-attachment.png';
import NextCase from '../../components/case/NextCase.astro';
import { ermaCase as study } from '../../data/cases/erma';

const { problem, research, roles, workflow, decisions, outcome, retrospective } = study;

// The product logo in the corner of the roster screens, blurred (its bounds plus a margin, as a share of the picture)
const logo = { left: 4.37, top: 2.64, width: 11.9, height: 4.58 };
---

<Layout title={study.seo.title} description={study.seo.description} current="work">
  <article class="case" data-case-palette="erma">
    <div class="case__container case__top">
      <div class="case__intro">
        <CaseBack />
        <CaseHero hero={study.hero} />
      </div>
      <DashboardWindow eager blurLogo hint="Scroll inside to explore the dashboard" />
    </div>

    <div class="case__container case__main">
      <CaseNav items={study.nav} />

      <div class="case__sections">
        <Section id="problem" eyebrow={problem.eyebrow} title={problem.title} lead={problem.lead}>
          <FlowSteps steps={problem.flow} label="How a storm callout worked before the platform" />
          <NoteCards cards={problem.cards} />
          <QuoteCard image={quotePhoto} imageAlt="A lineman in an orange storm jacket on the phone in a truck cab, bucket trucks working on a flooded road ahead" text={problem.quote.text} source={problem.quote.source} />
        </Section>

        <Section id="research" eyebrow={research.eyebrow} title={research.title} lead={research.lead}>
          <ColumnLists columns={research.columns} />
        </Section>

        <Section id="roles" eyebrow={roles.eyebrow} title={roles.title} lead={roles.lead}>
          <RoleGroups groups={roles.groups} />
        </Section>

        <Section id="workflow" eyebrow={workflow.eyebrow} title={workflow.title} lead={workflow.lead}>
          <StageCompare before={workflow.before} steps={workflow.steps} label="The six stages of a job, with the roles that own them" />
        </Section>

        <Section id="decisions" eyebrow={decisions.eyebrow} title={decisions.title} lead={decisions.lead}>
          <div class="decisions">
            <DecisionBlock
              index={decisions.roster.index}
              title={decisions.roster.title}
              lead={decisions.roster.lead}
              pain={decisions.roster.pain}
              decision={decisions.roster.decision}
              why={decisions.roster.why}
              tradeoff={decisions.tradeoff}
            >
              <Fragment slot="media">
                <ShotFrame src={rostersList} alt={decisions.roster.listAlt} shield={logo} />
                <ShotFrame src={rosterResources} alt={decisions.roster.resourcesAlt} shield={logo} />
              </Fragment>
            </DecisionBlock>

            <DecisionBlock
              index={decisions.dashboard.index}
              title={decisions.dashboard.title}
              pain={decisions.dashboard.pain}
              decision={decisions.dashboard.decision}
              why={decisions.dashboard.why}
              tradeoff={decisions.tradeoff}
            >
              <DashboardWindow blurLogo parts={decisions.dashboard.parts} />
            </DecisionBlock>

            <DecisionBlock
              index={decisions.permissions.index}
              title={decisions.permissions.title}
              lead={decisions.permissions.lead}
              pain={decisions.permissions.pain}
              decision={decisions.permissions.decision}
              why={decisions.permissions.why}
              tradeoff={decisions.tradeoff}
            >
              <MissingScreen slot="media" label={decisions.permissions.missing} />
            </DecisionBlock>

            <DecisionBlock
              index={decisions.timesheets.index}
              title={decisions.timesheets.title}
              lead={decisions.timesheets.lead}
              pain={decisions.timesheets.pain}
              decision={decisions.timesheets.decision}
              why={decisions.timesheets.why}
              tradeoff={decisions.tradeoff}
            >
              <Fragment slot="media">
                <MissingScreen label={decisions.timesheets.missing} />
                <ShotFrame src={vUpload} alt={decisions.timesheets.uploadAlt} />
                <ShotFrame src={vAttachment} alt={decisions.timesheets.attachmentAlt} />
              </Fragment>
            </DecisionBlock>
          </div>
        </Section>

        <Section id="outcome" eyebrow={outcome.eyebrow} title={outcome.title} lead={outcome.lead}>
          <OutcomeCards cards={outcome.cards} />
        </Section>

        <Section id="retrospective" eyebrow={retrospective.eyebrow} title={retrospective.title}>
          <ColumnLists columns={retrospective.columns} bullets={false} />
        </Section>

        <NextCase current="/work/erma" />
      </div>
    </div>
  </article>
</Layout>

<style>
  .case {
    background: var(--case-page);
  }

  .case__container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .case__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    /* The back link sits in the space above the hero; the whole block is lowered by --case-top-shift. */
    padding-top: calc(var(--header-h) + var(--space-8) + var(--case-top-shift));
  }

  .case__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .case__main {
    display: grid;
    grid-template-columns: var(--case-nav-w) minmax(0, 1fr);
    gap: var(--case-gap);
    padding-block: var(--case-section-gap) var(--space-144);
  }

  .case__sections {
    display: flex;
    flex-direction: column;
    gap: var(--case-section-gap);
    min-width: 0;
  }

  .decisions {
    display: flex;
    flex-direction: column;
    gap: var(--space-92);
  }

  @media (max-width: 1023px) {
    .case__main {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-32);
      padding-block: var(--space-56) var(--space-92);
    }

    .case__sections {
      gap: var(--space-80);
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import WorkCard from '../components/WorkCard.astro';
import Experience from '../components/Experience.astro';
import Reviews from '../components/Reviews.astro';
import { work } from '../data/content';

const title = 'Marina — Product Designer';
const description =
  'Portfolio of Marina, a product designer since 2015 building complex digital products: marketplaces, service platforms, a baby sleep app and a storm-restoration SaaS.';
---

<Layout title={title} description={description}>
  <Hero />
  <Marquee />
  <section class="work-list" id="work" aria-label="Featured work">
    {work.map((item, index) => <WorkCard {...item} index={index} />)}
  </section>
  <Experience />
  <Reviews />
</Layout>

<style>
  .work-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-92);
    margin-top: var(--space-134);
    scroll-margin-top: var(--header-h);
  }

  /* Stacked panels touch: the next one slides over the previous one. */
  @media (min-width: 1025px) and (min-height: 600px) {
    .work-list {
      gap: 0;
    }
  }
</style>
